    "onboarding.trustboundary.body": {
      "comment": "v0.7.0 — Body copy of the trust-boundary acknowledgement sheet. Makes clear that HealthLog cannot guarantee the privacy practices of a self-hosted server.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verbindest dich mit deinem eigenen HealthLog-Server. Deine Gesundheitsdaten werden an diesen Host gesendet und dort gespeichert. Stelle sicher, dass du dem Betreiber dieses Servers vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are connecting to your own HealthLog server. Your health data will be sent to and stored on this host. Make sure you trust whoever runs this server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je maakt verbinding met je eigen HealthLog-server. Je gezondheidsgegevens worden naar deze host gestuurd en daar bewaard. Zorg dat je degene die deze server beheert vertrouwt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 HealthLog 서버에 연결하고 있어요. 건강 데이터가 이 호스트로 전송되어 저장돼요. 이 서버를 운영하는 사람을 신뢰할 수 있는지 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te estás conectando a tu propio servidor de HealthLog. Tus datos de salud se enviarán a este host y se guardarán en él. Asegúrate de que confías en quien gestiona este servidor."
          }
        }
      }
    },
    "onboarding.trustboundary.cancel": {
      "comment": "v0.7.0 — Secondary CTA on the trust-boundary sheet to back out and pick a different server.",
      "localizations": {
        "de": {
          "stringUnit": {
