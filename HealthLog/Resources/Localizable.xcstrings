          }
        }
      }
    },
    "settings.hkdiag.info.about": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, What is this",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dein Server und dieses iPhone über den Abgleich mit Apple Health wissen, zum Nachsehen, wenn etwas fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your server and this iPhone know about the sync with Apple Health, for when something is missing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je server en deze iPhone weten over de synchronisatie met Apple Health, om na te kijken als er iets ontbreekt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 동기화에 대해 서버와 이 iPhone이 알고 있는 정보예요. 뭔가 빠졌을 때 확인하세요."
          }
        }
      }
    },
    "settings.hkdiag.info.held.title": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, section title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehalten und abgelehnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held back and refused"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegengehouden en geweigerd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 및 거부"
          }
        }
      }
    },
    "settings.hkdiag.info.sources.server": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-Sicht fragt deinen Server jedes Mal frisch ab, wenn du die Seite öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server view asks your server afresh each time you open this page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De serverweergave vraagt je server telkens opnieuw als je deze pagina opent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 보기는 이 페이지를 열 때마다 서버에 새로 요청해요."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.session": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aktuelle Sitzung“ und „Pro Messgröße“ zählen auf diesem iPhone seit dem letzten App-Start und beginnen danach wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Current session” and “Per kind” count on this iPhone since the app last started, and start from zero again after every launch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Huidige sessie” en “Per soort” tellen op deze iPhone sinds de app het laatst is gestart, en beginnen na elke start weer bij nul."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“현재 세션”과 “종류별”은 앱이 마지막으로 시작된 뒤 이 iPhone에서 센 값이며, 앱을 실행할 때마다 0부터 다시 시작해요."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.stored": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen Karten zeigen, was dieses iPhone über Neustarts hinweg gespeichert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other cards show what this iPhone has kept across launches."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle andere kaarten tonen wat deze iPhone over herstarts heen heeft bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지 카드는 이 iPhone이 앱 실행 간에 보관한 정보를 보여 줘요."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.title": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, section title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woher die Werte kommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the values come from"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar de waarden vandaan komen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값의 출처"
          }
        }
      }
    },
    "settings.hkdiag.kinds_empty": {
      "comment": "BF-5 — Empty-state copy when no kinds observed yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Aktivität in dieser Sitzung. Die Zähler füllen sich mit dem nächsten Lauf im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity in this session yet. The counters fill up with the next background run."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen activiteit in deze sessie. De tellers vullen zich bij de volgende ronde op de achtergrond."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에서는 아직 활동이 없어요. 다음 백그라운드 실행 때 카운터가 채워져요."
          }
        }
      }
    },
    "settings.hkdiag.kinds_subtitle": {
      "comment": "BF-5 — Per-kind list card explainer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüft heißt, die App hat nachgesehen. Neuer Wert heißt, etwas Neues ging an den Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked means the app looked. New value means something new went to the server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerd betekent dat de app heeft gekeken. Nieuwe waarde betekent dat er iets nieuws naar de server is gegaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인됨은 앱이 살펴봤다는 뜻이에요. 새 값은 새로운 데이터가 서버로 전송됐다는 뜻이에요."
          }
        }
      }
    },
    "settings.hkdiag.kinds_title": {
      "comment": "BF-5 — Per-kind list card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Messgröße"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kind"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per soort"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종류별"
          }
        }
      }
    },
    "settings.hkdiag.limits_bgrefresh": {
      "comment": "#66 P0.1 — Background App Refresh switch bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „Hintergrundaktualisierung“ ausgeschaltet, entfallen die kurzen Auffrisch-Läufe komplett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Background App Refresh” is off, the quick refresh runs are skipped entirely."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als 'Ververs op achtergrond' uit staat, worden de korte verversingen helemaal overgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“백그라운드 앱 새로 고침”이 꺼져 있으면 빠른 새로 고침 실행은 모두 건너뛰어요."
          }
        }
      }
    },
    "settings.hkdiag.limits_discretion": {
      "comment": "#66 P0.1 — system discretion bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet selbst, wann es weckt, meist beim Laden oder nachts. Neue Daten können daher erst mit Verzögerung am Server ankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides when to wake the app, usually while charging or overnight. New data can therefore reach the server only after a delay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bepaalt zelf wanneer de app wordt gewekt, meestal tijdens het opladen of 's nachts. Nieuwe gegevens kunnen daardoor pas met vertraging op de server aankomen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 언제 깨울지는 iOS가 정해요. 보통 충전 중이거나 밤사이예요. 그래서 새 데이터가 서버에 늦게 도착할 수 있어요."
          }
        }
      }
    },
    "settings.hkdiag.limits_footer": {
      "comment": "#66 P0.1 — system-limits card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht „Letzter Hintergrund-Sync“ auf „Noch nichts“, obwohl die App lief, hält iOS die Hintergrund-Zeit zurück. Das ist kein App-Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Last background sync” still says “Nothing yet” although the app has run, iOS is withholding background time. That is not an app bug."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat “Laatste synchronisatie op de achtergrond” nog op “Nog niets”, terwijl de app wel heeft gedraaid, dan houdt iOS de tijd op de achtergrond tegen. Dat is geen fout in de app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 실행됐는데도 “마지막 백그라운드 동기화”가 여전히 “아직 없음”이면 iOS가 백그라운드 시간을 주지 않고 있는 거예요. 앱 버그가 아니에요."
          }
        }
      }
    },
    "settings.hkdiag.limits_forcequit": {
      "comment": "#66 P0.1 — force-quit limit bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischst du die App im App-Umschalter weg, startet iOS sie im Hintergrund nicht mehr, bis du sie wieder öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you swipe the app away in the App Switcher, iOS stops starting it in the background until you open it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg je de app weg in de appkiezer, dan start iOS hem niet meer op de achtergrond tot je hem weer opent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전환기에서 앱을 쓸어 올려 닫으면, 다시 열 때까지 iOS가 앱을 백그라운드에서 시작하지 않아요."
          }
        }
      }
    },
