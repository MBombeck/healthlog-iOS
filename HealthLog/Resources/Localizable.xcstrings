          "stringUnit": {
            "state": "translated",
            "value": "Je oudere geschiedenis volgt vanzelf. Alles in één keer vraagt dat de app open is en de iPhone aan de oplader ligt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
