    "settings.hkdiag.hrbuckets.subtitle": {
      "comment": "Sync Diagnostics heart-rate bucket card subtitle (#12).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab dem Umstellungstag sendet die App die Herzfrequenz als 10-Minuten-Werte statt als Einzelmessungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the cutover day on, the app sends heart rate as 10-minute values instead of single readings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf de overstapdag stuurt de app de hartslag als waarden per 10 minuten in plaats van als losse metingen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환일부터 앱은 심박수를 개별 측정값 대신 10분 단위 값으로 보내요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir del día de cambio, la app envía la frecuencia cardíaca como valores cada 10 minutos en lugar de mediciones sueltas."
          }
        }
      }
    },
    "settings.hkdiag.hrbuckets.cutover": {
      "comment": "Row label: first UTC day that uploads 10-minute heart-rate values.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umstellung ab (UTC)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutover day (UTC)"
          }
        },
