      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen hat früher aufgehört, weil eine Prüfung unterwegs nicht geklappt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
