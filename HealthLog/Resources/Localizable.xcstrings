    "threshold.nudge.body.above %@ %@ %@": {
      "comment": "W-THRESHOLD-NUDGE — factual out-of-range body (above). %1$@ analyte, %2$@ value+unit, %3$@ range. NON-diagnostic: states a fact only, no advice/diagnosis/reassurance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %1$@ reading of %2$@ is above the range you set (%3$@)."
