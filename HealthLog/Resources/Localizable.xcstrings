    "biomarker.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a biomarker once to reuse its unit and reference range across results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen Biomarker einmal an, um Einheit und Referenzbereich für alle Werte wiederzuverwenden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definieer een biomarker één keer om de eenheid en het referentiebereik bij al je uitslagen te hergebruiken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바이오마커를 한 번 정의하면 여러 결과에서 단위와 참고 범위를 재사용할 수 있어요."
          }
        }
      }
    },
    "biomarker.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No biomarkers yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Biomarker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen biomarkers"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 바이오마커가 없어요"
          }
        }
      }
    },
    "biomarker.explainer.alt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT ist ein Leberenzym. Erhöhte Werte können auf eine Belastung oder Reizung der Leber hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT is a liver enzyme. Elevated values can indicate a strain on or irritation of the liver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT is een leverenzym. Verhoogde waarden kunnen wijzen op belasting of irritatie van de lever."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ALT는 간 효소예요. 수치가 높으면 간에 부담이나 자극이 있다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.apob": {
      "comment": "v1.25 longevity biomarker explainer — ApoB (mirrors server labs.catalog.explainer.apob).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apolipoprotein B (ApoB) zählt atherogene Partikel direkt und gilt oft als besserer Risikomarker als LDL-Cholesterin, wenn beide auseinandergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apolipoprotein B (ApoB) counts atherogenic particles directly and is often a better risk marker than LDL cholesterol when the two disagree."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apolipoproteïne B (ApoB) telt atherogene deeltjes direct en is vaak een betere risicomarker dan LDL-cholesterol als de twee niet overeenkomen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아포지단백 B(ApoB)는 동맥경화성 입자를 직접 세는 지표로, LDL 콜레스테롤과 결과가 다를 때 더 나은 위험 지표인 경우가 많아요."
          }
        }
      }
    },
    "biomarker.explainer.ast": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AST ist ein Enzym, das in Leber und Muskulatur vorkommt. Erhöhte Werte können auf eine Belastung von Leber- oder Muskelgewebe hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AST is an enzyme found in the liver and muscle. Elevated values can indicate strain on the liver or muscle tissue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AST is een enzym dat in de lever en spieren voorkomt. Verhoogde waarden kunnen wijzen op belasting van de lever of het spierweefsel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AST는 간과 근육에 있는 효소예요. 수치가 높으면 간이나 근육 조직에 부담이 있다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.creatinine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreatinin ist ein Abbauprodukt, das über die Nieren ausgeschieden wird. Erhöhte Werte können auf eine verminderte Nierenfiltration hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creatinine is a waste product filtered by the kidneys. Elevated values can indicate reduced kidney filtration."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Creatinine is een afvalstof die door de nieren wordt gefilterd. Verhoogde waarden kunnen wijzen op een verminderde nierfiltratie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레아티닌은 신장에서 걸러지는 노폐물이에요. 수치가 높으면 신장의 여과 기능이 떨어졌다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.egfr": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eGFR ist eine Schätzung, wie gut die Nieren das Blut filtern. Niedrigere Werte weisen auf eine verminderte Nierenfunktion hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR is an estimate of how well your kidneys filter blood. Lower values indicate reduced kidney function."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR is een schatting van hoe goed je nieren het bloed filteren. Lagere waarden wijzen op een verminderde nierfunctie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "eGFR은 신장이 혈액을 얼마나 잘 거르는지 추정한 값이에요. 수치가 낮으면 신장 기능이 떨어졌음을 나타내요."
          }
        }
      }
    },
    "biomarker.explainer.fasting-glucose": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüchternglukose ist der Blutzucker nach mehreren Stunden ohne Nahrung. Erhöhte Werte können auf einen veränderten Zuckerstoffwechsel hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting glucose is your blood sugar after several hours without eating. Elevated values can indicate altered glucose metabolism."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuchtere glucose is je bloedsuiker na een aantal uur niet eten. Verhoogde waarden kunnen wijzen op een veranderde suikerstofwisseling."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공복 혈당은 몇 시간 동안 음식을 먹지 않은 뒤의 혈당이에요. 수치가 높으면 포도당 대사에 변화가 있다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.fasting-insulin": {
      "comment": "v1.25 longevity biomarker explainer — fasting insulin.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüchtern-Insulin ergänzt den Nüchtern-Blutzucker zur Abschätzung der Insulinresistenz (HOMA-IR). Es wird nach mehrstündigem Fasten gemessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasting insulin pairs with fasting glucose to estimate insulin resistance (HOMA-IR). It is measured after several hours without food."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuchtere insuline wordt samen met nuchtere glucose gebruikt om insulineresistentie te schatten (HOMA-IR). Het wordt gemeten na een aantal uur zonder eten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공복 인슐린은 공복 혈당과 함께 인슐린 저항성(HOMA-IR)을 추정하는 데 쓰여요. 몇 시간 동안 음식을 먹지 않은 뒤 측정해요."
          }
        }
      }
    },
    "biomarker.explainer.ferritin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin spiegelt die Eisenspeicher des Körpers wider. Niedrige Werte können auf entleerte Eisenspeicher hinweisen; hohe Werte können bei Entzündungen oder Eisenüberladung auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin reflects your body's stored iron. Low values can indicate depleted iron stores; high values can occur with inflammation or iron overload."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritine geeft de ijzervoorraad in je lichaam weer. Lage waarden kunnen wijzen op een uitgeputte ijzervoorraad; hoge waarden kunnen voorkomen bij ontsteking of ijzerstapeling."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페리틴은 몸에 저장된 철분을 반영해요. 수치가 낮으면 철분 저장량이 고갈되었다는 신호일 수 있고, 높으면 염증이나 철분 과잉과 함께 나타날 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.folate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folsäure ist ein B-Vitamin, das an Zellteilung und Blutbildung beteiligt ist. Niedrige Werte können auf eine Unterversorgung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folate is a B vitamin involved in cell division and blood formation. Low values can indicate an undersupply."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foliumzuur is een B-vitamine die betrokken is bij celdeling en bloedaanmaak. Lage waarden kunnen wijzen op een tekort."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엽산은 세포 분열과 조혈에 관여하는 비타민 B예요. 수치가 낮으면 공급이 부족하다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.ft3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freies T3 ist ein aktives Schilddrüsenhormon, das den Stoffwechsel beeinflusst. Es wird zusammen mit TSH und freiem T4 zur Beurteilung der Schilddrüsenfunktion betrachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T3 is an active thyroid hormone that influences metabolism. It is read together with TSH and free T4 to assess thyroid function."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrij T3 is een actief schildklierhormoon dat de stofwisseling beïnvloedt. Het wordt samen met TSH en vrij T4 bekeken om de schildklierfunctie te beoordelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 T3는 신진대사에 영향을 주는 활성 갑상선 호르몬이에요. 갑상선 기능을 평가할 때 TSH, 유리 T4와 함께 해석해요."
          }
        }
      }
    },
    "biomarker.explainer.ft4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freies T4 ist das wichtigste Schilddrüsenhormon im Blut. Es wird zusammen mit dem TSH zur Beurteilung der Schilddrüsenfunktion betrachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free T4 is the main thyroid hormone in your blood. It is interpreted alongside TSH to assess thyroid function."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrij T4 is het belangrijkste schildklierhormoon in je bloed. Het wordt samen met TSH geïnterpreteerd om de schildklierfunctie te beoordelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 T4는 혈액 속 주요 갑상선 호르몬이에요. 갑상선 기능을 평가할 때 TSH와 함께 해석해요."
          }
        }
      }
    },
    "biomarker.explainer.ggt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT ist ein Leberenzym. Erhöhte Werte können auf eine Belastung der Leber oder Gallenwege hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT is a liver enzyme. Elevated values can indicate strain on the liver or bile ducts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT is een leverenzym. Verhoogde waarden kunnen wijzen op belasting van de lever of de galwegen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GGT는 간 효소예요. 수치가 높으면 간이나 담관에 부담이 있다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.hba1c": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c spiegelt den durchschnittlichen Blutzucker der letzten zwei bis drei Monate wider. Höhere Werte zeigen einen höheren mittleren Glukosespiegel an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c reflects your average blood sugar over the past two to three months. Higher values indicate higher average glucose levels."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c geeft je gemiddelde bloedsuiker van de afgelopen twee tot drie maanden weer. Hogere waarden wijzen op een hoger gemiddeld glucosegehalte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HbA1c는 지난 2~3개월간의 평균 혈당을 반영해요. 수치가 높을수록 평균 혈당 수준이 높다는 뜻이에요."
          }
        }
      }
    },
    "biomarker.explainer.hdl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL-Cholesterin hilft, Cholesterin zurück zur Leber zu transportieren. Höhere Werte gelten allgemein als günstig für das Herz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL cholesterol helps carry cholesterol back to the liver. Higher values are generally viewed as protective for the heart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL-cholesterol helpt cholesterol terug naar de lever te vervoeren. Hogere waarden worden over het algemeen als beschermend voor het hart gezien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDL 콜레스테롤은 콜레스테롤을 간으로 되돌려 보내는 데 도움을 줘요. 일반적으로 수치가 높을수록 심장을 보호하는 것으로 여겨져요."
          }
        }
      }
    },
    "biomarker.explainer.hematocrit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämatokrit ist der Anteil der roten Blutkörperchen am Blutvolumen. Er wird zusammen mit dem Hämoglobin betrachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hematocrit is the proportion of your blood made up of red blood cells. It is read together with hemoglobin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hematocriet is het aandeel rode bloedcellen in je bloed. Het wordt samen met hemoglobine bekeken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적혈구 용적률(헤마토크릿)은 혈액에서 적혈구가 차지하는 비율이에요. 헤모글로빈과 함께 해석해요."
          }
        }
      }
    },
    "biomarker.explainer.hemoglobin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämoglobin transportiert Sauerstoff in den roten Blutkörperchen. Niedrige Werte können auf eine Blutarmut hinweisen; hohe Werte können bei Flüssigkeitsmangel oder anderen Faktoren auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemoglobin carries oxygen in your red blood cells. Low values can indicate anemia; high values can occur with dehydration or other factors."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemoglobine vervoert zuurstof in je rode bloedcellen. Lage waarden kunnen wijzen op bloedarmoede; hoge waarden kunnen voorkomen bij uitdroging of andere factoren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤모글로빈은 적혈구에서 산소를 운반해요. 수치가 낮으면 빈혈의 신호일 수 있고, 높으면 탈수나 다른 요인과 함께 나타날 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.homa-ir": {
      "comment": "v1.25 longevity biomarker explainer — HOMA-IR (server-derived; iOS-authored).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR ist ein Index, der aus Nüchtern-Blutzucker und Nüchtern-Insulin berechnet wird. Höhere Werte gehen allgemein mit einer stärkeren Insulinresistenz einher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR is an index estimated from fasting glucose and fasting insulin. Higher values are generally associated with greater insulin resistance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR is een index die wordt geschat op basis van nuchtere glucose en nuchtere insuline. Hogere waarden gaan doorgaans samen met meer insulineresistentie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HOMA-IR은 공복 혈당과 공복 인슐린으로 추정하는 지수예요. 일반적으로 수치가 높을수록 인슐린 저항성이 큰 것과 관련이 있어요."
          }
        }
      }
    },
    "biomarker.explainer.hs-crp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP ist ein empfindlicher Marker für Entzündungen im Körper. Erhöhte Werte können auf eine bestehende Entzündungsaktivität hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP is a sensitive marker of inflammation in the body. Elevated values can indicate ongoing inflammatory activity."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP is een gevoelige marker voor ontsteking in het lichaam. Verhoogde waarden kunnen wijzen op lopende ontstekingsactiviteit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP는 몸속 염증을 민감하게 보여 주는 지표예요. 수치가 높으면 염증 활동이 지속되고 있다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.ldl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL-Cholesterin transportiert Cholesterin zu den Geweben. Höhere Werte gehen häufig mit einem erhöhten Herz-Kreislauf-Risiko einher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL cholesterol transports cholesterol to the tissues. Higher values are commonly associated with increased cardiovascular risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL-cholesterol vervoert cholesterol naar de weefsels. Hogere waarden worden vaak in verband gebracht met een verhoogd risico op hart- en vaatziekten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LDL 콜레스테롤은 콜레스테롤을 조직으로 운반해요. 일반적으로 수치가 높을수록 심혈관 위험 증가와 관련이 있어요."
          }
        }
      }
    },
    "biomarker.explainer.lp-a": {
      "comment": "v1.25 longevity biomarker explainer — Lp(a) (mirrors server labs.catalog.explainer.lp-a).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipoprotein(a), Lp(a), ist ein weitgehend vererbter, lebenslanger Risikofaktor und wird meist nur einmal gemessen. Üblicherweise in molaren Einheiten (nmol/L) angegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipoprotein(a), Lp(a), is a largely inherited, lifelong risk factor and is usually measured once. It is typically reported in molar units (nmol/L)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipoproteïne(a), Lp(a), is een grotendeels erfelijke, levenslange risicofactor en wordt meestal één keer gemeten. Het wordt doorgaans in molaire eenheden (nmol/L) gerapporteerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지단백(a), Lp(a)는 대부분 유전되는 평생의 위험 요인으로, 보통 한 번만 측정해요. 일반적으로 몰 단위(nmol/L)로 보고돼요."
          }
        }
      }
    },
    "biomarker.explainer.omega-3-index": {
      "comment": "v1.25 longevity biomarker explainer — Omega-3 index.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Omega-3-Index ist der Anteil von EPA+DHA in den roten Blutkörperchen. Ein Bereich von 8 bis 12 % wird häufig als kardioprotektiv genannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The omega-3 index is the share of EPA+DHA in your red blood cells. A range of 8 to 12% is commonly cited as cardioprotective."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De omega-3-index is het aandeel EPA+DHA in je rode bloedcellen. Een bereik van 8 tot 12% wordt vaak genoemd als beschermend voor hart en vaten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오메가-3 지수는 적혈구에서 EPA+DHA가 차지하는 비율이에요. 흔히 8~12퍼센트 범위가 심장 보호에 도움이 되는 것으로 언급돼요."
          }
        }
      }
    },
    "biomarker.explainer.platelets": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thrombozyten sind für die Blutgerinnung wichtig. Werte außerhalb des Bereichs können Blutung und Gerinnung beeinflussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Platelets help your blood clot. Values outside the range can affect bleeding and clotting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedplaatjes helpen je bloed te stollen. Waarden buiten het bereik kunnen bloeding en stolling beïnvloeden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈소판은 혈액 응고를 도와요. 수치가 범위를 벗어나면 출혈과 응고에 영향을 줄 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.potassium": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalium ist ein Elektrolyt, der für Nerven- und Muskelfunktion wichtig ist. Werte außerhalb des Bereichs können Herz und Muskeln beeinflussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Potassium is an electrolyte important for nerve and muscle function. Values outside the range can affect the heart and muscles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalium is een elektrolyt dat belangrijk is voor de werking van zenuwen en spieren. Waarden buiten het bereik kunnen het hart en de spieren beïnvloeden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼륨은 신경과 근육 기능에 중요한 전해질이에요. 수치가 범위를 벗어나면 심장과 근육에 영향을 줄 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.sodium": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrium ist ein Elektrolyt, der den Flüssigkeitshaushalt mitreguliert. Werte außerhalb des Bereichs können mit dem Flüssigkeitshaushalt oder den Nieren zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodium is an electrolyte that helps regulate fluid balance. Values outside the range can reflect hydration or kidney-related factors."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrium is een elektrolyt dat helpt de vochtbalans te regelen. Waarden buiten het bereik kunnen samenhangen met je vochtbalans of met je nieren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나트륨은 체액 균형 조절을 돕는 전해질이에요. 수치가 범위를 벗어나면 수분 상태나 신장 관련 요인을 반영할 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.total-cholesterol": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtcholesterin ist die Summe des im Blut transportierten Cholesterins. Erhöhte Werte können mit einem höheren langfristigen Herz-Kreislauf-Risiko einhergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total cholesterol is the sum of cholesterol carried in your blood. Elevated values can be associated with a higher long-term cardiovascular risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totaal cholesterol is de som van het cholesterol dat in je bloed wordt vervoerd. Verhoogde waarden kunnen samengaan met een hoger risico op hart- en vaatziekten op lange termijn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 콜레스테롤은 혈액 속 콜레스테롤의 총합이에요. 수치가 높으면 장기적인 심혈관 위험 증가와 관련이 있을 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.transferrin-saturation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transferrinsättigung zeigt, wie viel des Eisentransportproteins mit Eisen beladen ist. Sie hilft zusammen mit dem Ferritin, die Eisenversorgung einzuschätzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferrin saturation shows how much of your iron-transport protein is carrying iron. It helps assess iron supply alongside ferritin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferrineverzadiging laat zien hoeveel van je ijzertransporteiwit ijzer draagt. Samen met ferritine helpt het om je ijzervoorziening te beoordelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랜스페린 포화도는 철분 운반 단백질 중 철분과 결합한 비율을 보여 줘요. 페리틴과 함께 철분 공급 상태를 평가하는 데 도움이 돼요."
          }
        }
      }
    },
    "biomarker.explainer.triglycerides": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triglyceride sind die wichtigste Fettart im Blut und eine Energiequelle. Erhöhte Werte können mit Ernährung, Alkohol oder Stoffwechselfaktoren zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triglycerides are the main type of fat in your blood and a source of energy. Elevated values can be linked to diet, alcohol, or metabolic factors."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Triglyceriden zijn het belangrijkste type vet in je bloed en een energiebron. Verhoogde waarden kunnen samenhangen met voeding, alcohol of stofwisselingsfactoren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중성지방은 혈액 속 지방의 주요 형태이자 에너지원이에요. 수치가 높으면 식단, 음주, 대사 요인과 관련이 있을 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.tsh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH ist ein Hypophysenhormon, das die Schilddrüse steuert. Werte außerhalb des Bereichs können auf eine Über- oder Unterfunktion der Schilddrüse hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH is a pituitary hormone that regulates the thyroid. Values outside the range can indicate an over- or underactive thyroid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH is een hormoon van de hypofyse dat de schildklier regelt. Waarden buiten het bereik kunnen wijzen op een te snel of te traag werkende schildklier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH는 갑상선을 조절하는 뇌하수체 호르몬이에요. 수치가 범위를 벗어나면 갑상선 기능 항진 또는 저하의 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.vitamin-b12": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin B12 wird für die Blutbildung und das Nervensystem benötigt. Niedrige Werte können auf eine langfristige Unterversorgung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin B12 is needed for blood formation and the nervous system. Low values can indicate an undersupply over time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamine B12 is nodig voor de bloedaanmaak en het zenuwstelsel. Lage waarden kunnen wijzen op een tekort op langere termijn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비타민 B12는 조혈과 신경계에 필요해요. 수치가 낮으면 시간이 지나며 공급이 부족해졌다는 신호일 수 있어요."
          }
        }
      }
    },
    "biomarker.explainer.vitamin-d": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin D (25-OH) spiegelt den Vitamin-D-Status wider, der für Knochen und Immunsystem wichtig ist. Niedrige Werte weisen auf eine Unterversorgung hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin D (25-OH) reflects your vitamin D status, important for bone and immune health. Low values indicate an undersupply."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamine D (25-OH) geeft je vitamine D-status weer, belangrijk voor botten en afweer. Lage waarden wijzen op een tekort."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비타민 D(25-OH)는 뼈와 면역 건강에 중요한 비타민 D 상태를 반영해요. 수치가 낮으면 공급이 부족함을 나타내요."
          }
        }
      }
    },
    "biomarker.explainer.wbc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leukozyten sind Teil des Immunsystems. Werte außerhalb des Bereichs können bei Infektionen, Entzündungen oder anderen Faktoren auftreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White blood cells are part of your immune system. Values outside the range can occur with infection, inflammation, or other factors."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witte bloedcellen maken deel uit van je afweersysteem. Waarden buiten het bereik kunnen voorkomen bij infectie, ontsteking of andere factoren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백혈구는 면역 체계의 일부예요. 수치가 범위를 벗어나는 것은 감염, 염증, 기타 요인과 함께 나타날 수 있어요."
          }
        }
      }
    },
