    "med.undo.invalid_precondition": {
      "comment": "Undo refused with 422 invalidPrecondition",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dosis ließ sich nicht rückgängig machen. Lade die Liste neu und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dose could not be undone. Reload the list and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze dosis kon niet ongedaan worden gemaakt. Laad de lijst opnieuw en probeer het nog eens."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복용 기록을 되돌리지 못했어요. 목록을 새로 고친 뒤 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo deshacer esta dosis. Recarga la lista e inténtalo de nuevo."
          }
        }
      }
    },
    "med.intake.force_slot_occupied": {
      "comment": "422 force_slot.occupied: pinning an intake onto a slot that already holds one",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Dosis ist schon eine Einnahme erfasst. Bearbeite oder lösche zuerst diese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dose already has an intake. Edit or delete that one first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze dosis is al een inname vastgelegd. Bewerk of verwijder die eerst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복용분에는 이미 복용 기록이 있어요. 먼저 그 기록을 수정하거나 삭제해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dosis ya tiene una toma. Edítala o elimínala primero."
          }
        }
      }
    },
    "This notification was not confirmed by your server, so HealthLog did nothing.": {
      "comment": "#190 Home line after tapping a notification the Notification Service Extension could not open from a valid envelope.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mitteilung hat dein Server nicht bestätigt, deshalb hat HealthLog nichts getan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This notification was not confirmed by your server, so HealthLog did nothing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze melding is niet door je server bevestigd, daarom heeft HealthLog niets gedaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 확인되지 않은 알림이라 HealthLog는 아무 작업도 하지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor no confirmó esta notificación, así que HealthLog no hizo nada."
          }
        }
      }
    },
    "Notifications from your server": {
      "comment": "#190 Title of the push relay opt-in card and settings card.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen von deinem Server"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications from your server"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen van je server"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 보내는 알림"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones de tu servidor"
          }
        }
      }
    },
    "Privacy notice": {
      "comment": "#190 Link to the relay's privacy notice on the opt-in card.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutzhinweis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy notice"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacyverklaring"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 안내"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso de privacidad"
          }
        }
      }
    },
    "Turn on": {
      "comment": "#190 Primary button of the relay opt-in card. Tapping it is the person's consent.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inschakelen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        }
      }
    },
    "So your server can tell you about doses and changes and end the Live Activity, notifications can travel through the HealthLog relay to Apple. The relay is run by the HealthLog project maintainer, not by whoever runs your server.": {
      "comment": "#190 Consent text, paragraph 1 (who runs the relay). Wording from the #190 contract 5.1 (6).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit dein Server dir Einnahmen und Änderungen melden und die Live-Aktivität beenden kann, können Mitteilungen über das HealthLog-Relay zu Apple gehen. Das Relay betreibt der Maintainer des HealthLog-Projekts, nicht die Person, die deinen Server betreibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So your server can tell you about doses and changes and end the Live Activity, notifications can travel through the HealthLog relay to Apple. The relay is run by the HealthLog project maintainer, not by whoever runs your server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat je server je over innames en wijzigingen kan informeren en de live-activiteit kan beëindigen, kunnen meldingen via de HealthLog-relay naar Apple gaan. De relay wordt beheerd door de maintainer van het HealthLog-project, niet door degene die je server beheert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 복용과 변경 사항을 알리고 실시간 현황을 끝낼 수 있도록, 알림이 HealthLog 릴레이를 거쳐 Apple로 전달될 수 있습니다. 릴레이는 서버 운영자가 아니라 HealthLog 프로젝트 관리자가 운영합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que tu servidor pueda avisarte de dosis y cambios y terminar la actividad en vivo, las notificaciones pueden pasar por el relay de HealthLog hasta Apple. El relay lo gestiona el responsable del proyecto HealthLog, no quien gestiona tu servidor."
          }
        }
      }
    },
    "Content is encrypted so that only this device can read it. The relay and Apple can still see when your server sends you something, which can show when you take medication. Apple can link these times to your Apple Account.": {
      "comment": "#190 Consent text, paragraph 2 (what the relay and Apple can see).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt ist so verschlüsselt, dass nur dieses Gerät ihn lesen kann. Das Relay und Apple sehen trotzdem, wann dein Server dir etwas schickt, und daran kann man ablesen, wann du Medikamente nimmst. Apple kann diese Zeiten deinem Apple Account zuordnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content is encrypted so that only this device can read it. The relay and Apple can still see when your server sends you something, which can show when you take medication. Apple can link these times to your Apple Account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De inhoud is zo versleuteld dat alleen dit apparaat hem kan lezen. De relay en Apple zien wel wanneer je server je iets stuurt, en daaraan is te zien wanneer je medicijnen neemt. Apple kan deze tijden aan je Apple-account koppelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용은 이 기기만 읽을 수 있도록 암호화됩니다. 그래도 릴레이와 Apple은 서버가 언제 무언가를 보내는지 알 수 있고, 이를 통해 약을 복용하는 시간이 드러날 수 있습니다. Apple은 이 시간을 Apple 계정과 연결할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido está cifrado para que solo este dispositivo pueda leerlo. Aun así, el relay y Apple pueden ver cuándo tu servidor te envía algo, lo que puede revelar cuándo tomas la medicación. Apple puede vincular estos momentos a tu cuenta de Apple."
          }
        }
      }
    },
    "Reminders stay on your device. You can turn this off at any time in Settings, even if your server is unreachable. The relay is for private and household use only and is not a medical service.": {
      "comment": "#190 Consent text, paragraph 3 (reminders stay local, opt-out, household only, not a medical service).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen bleiben auf deinem Gerät. Du kannst das jederzeit in den Einstellungen ausschalten, auch wenn dein Server nicht erreichbar ist. Das Relay ist nur für den privaten Gebrauch im Haushalt gedacht und kein medizinischer Dienst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders stay on your device. You can turn this off at any time in Settings, even if your server is unreachable. The relay is for private and household use only and is not a medical service."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen blijven op je apparaat. Je kunt dit altijd uitschakelen in Instellingen, ook als je server niet bereikbaar is. De relay is alleen bedoeld voor privé- en huishoudelijk gebruik en is geen medische dienst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 기기에 그대로 남습니다. 서버에 연결할 수 없어도 언제든지 설정에서 끌 수 있습니다. 릴레이는 개인과 가정용으로만 제공되며 의료 서비스가 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se quedan en tu dispositivo. Puedes desactivarlo en cualquier momento en Ajustes, aunque tu servidor no esté disponible. El relay es solo para uso privado y doméstico, y no es un servicio médico."
          }
        }
      }
    },
    "Sync with your other devices is disrupted. Check HealthLog before taking a dose.": {
      "comment": "#190 5.6 Calm line on Home when the relay or the intake sync is degraded and the server gave no start time.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich mit deinen anderen Geräten ist gestört. Sieh vor einer Einnahme in HealthLog nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync with your other devices is disrupted. Check HealthLog before taking a dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De synchronisatie met je andere apparaten is verstoord. Kijk in HealthLog voordat je een dosis neemt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기와의 동기화가 원활하지 않습니다. 복용 전에 HealthLog를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con tus otros dispositivos tiene problemas. Revisa HealthLog antes de tomar una dosis."
          }
        }
      }
    },
    "Sync with your other devices is disrupted since %@. Check HealthLog before taking a dose.": {
      "comment": "#190 5.6 Calm line on Home when the relay or the intake sync is degraded. %@ is a time like 07:40.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abgleich mit deinen anderen Geräten ist seit %@ gestört. Sieh vor einer Einnahme in HealthLog nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync with your other devices is disrupted since %@. Check HealthLog before taking a dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De synchronisatie met je andere apparaten is sinds %@ verstoord. Kijk in HealthLog voordat je een dosis neemt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 다른 기기와의 동기화가 원활하지 않습니다. 복용 전에 HealthLog를 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con tus otros dispositivos tiene problemas desde %@. Revisa HealthLog antes de tomar una dosis."
          }
        }
      }
    },
    "Send through the HealthLog relay": {
      "comment": "#190 Settings toggle: notifications from the server travel through the relay.",
      "extractionState": "manual",
      "localizations": {
