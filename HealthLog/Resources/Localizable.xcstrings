    "health.permissions.control_body": {
      "comment": "v0.7.0 W-APPSTORE — user-control card body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jeden Datentyp einzeln ändern oder den Zugriff vollständig widerrufen — in Apple Health, über dein Profilbild → Datenschutz → Apps → HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change each data type individually or revoke access entirely — in Apple Health, via your profile picture → Privacy → Apps → HealthLog."
          }
        }
      }
    },
    "health.permissions.control_footer": {
      "comment": "v0.7.0 W-APPSTORE — user-control card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog überträgt Gesundheitsdaten nur an deinen eigenen Server und niemals an Dritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog only transmits health data to your own server, never to third parties."
          }
        }
      }
    },
    "health.permissions.control_title": {
      "comment": "v0.7.0 W-APPSTORE — user-control card title.",
      "extractionState": "manual",
