    "insights.recovery.noAggregate": {
      "comment": "C3 — states what this page cannot show: the server publishes single readings for the recovery family, no windowed average and no target band. Renders instead of a 30-day claim the data cannot back.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Erholungs-Familie liefert der Server einzelne Messwerte, keinen Durchschnitt über ein Zeitfenster und kein Zielband. Deshalb steht hier der letzte Wert und kein 30-Tage-Schnitt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the recovery family the server publishes single readings, no windowed average and no target band. So this page shows the latest reading rather than a 30-day figure."
          }
        }
