    "How well your body has bounced back, read mainly from your heart-rate variability versus your own baseline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie gut sich dein Körper erholt hat, vor allem abgelesen an deiner Herzfrequenzvariabilität im Vergleich zu deinem eigenen Normalwert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How well your body has bounced back, read mainly from your heart-rate variability versus your own baseline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe goed je lichaam is hersteld, vooral afgeleid uit je hartslagvariabiliteit ten opzichte van je eigen basiswaarde."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸이 얼마나 잘 회복했는지 보여 줘요. 주로 내 기준선 대비 심박변이도로 판단해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo bien que se ha recuperado tu cuerpo, según sobre todo tu variabilidad de la frecuencia cardíaca frente a tu propio nivel basal."
          }
        }
      }
    },
    "How well your body has bounced back, taken straight from your WHOOP recovery.": {
