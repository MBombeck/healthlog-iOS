        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단계를 진행하려면 계정에 2단계 인증 수단이 필요해요. 먼저 인증 앱을 설정해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paso necesita un segundo factor en tu cuenta. Configura primero una app de autenticación."
          }
        }
      }
