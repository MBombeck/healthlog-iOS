    "notif.privacy.hideContent.description": {
      "comment": "Explains the toggle: neither medication names nor readings are stored by iOS.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen zeigen nur einen neutralen Text. Weder Medikamente noch Werte landen im Mitteilungsspeicher des iPhones."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications show a neutral text only. No medication names or readings end up in the iPhone's notification store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen tonen alleen een neutrale tekst. Er komen geen medicijnnamen of meetwaarden in de meldingenopslag van de iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에는 중립적인 문구만 보여요. 약 이름이나 측정값은 iPhone 알림 저장소에 남지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones solo muestran un texto neutro. Ni nombres de medicamentos ni valores quedan en el registro de notificaciones del iPhone."
          }
        }
      }
    },
