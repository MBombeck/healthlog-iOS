    "biomarker.editor.seed.footer": {
      "comment": "Biomarker editor — the seed pre-fills editable defaults, not fixed truth.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt änderbar, denn Referenzbereiche unterscheiden sich je nach Labor, Geschlecht und Alter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays editable, because reference ranges differ by lab, sex and age."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft aanpasbaar, want referentiebereiken verschillen per lab, geslacht en leeftijd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고 범위는 검사기관, 성별, 나이에 따라 다르므로 모든 항목을 편집할 수 있어요."
          }
        }
      }
    },
