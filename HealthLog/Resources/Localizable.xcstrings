    "settings.coach.insightsPrivacy.description": {
      "comment": "Settings → Coach — help text for the insights AI privacy-mode picker",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie viele Details die Insights-KI erhält. „Aggregiert“ übermittelt nur zusammengefasste Trends; „Volle Details“ übermittelt zusätzlich einzelne Datenpunkte für präzisere Insights."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how much detail the insights AI receives. Aggregated shares only summarised trends; Full detail also shares individual data points for more precise insights."
          }
        }
      }
    },
