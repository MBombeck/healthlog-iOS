    "settings.support.entry_footer": {
      "comment": "08-15 — Footer der Einstiegskarte: wofuer die Detailseite da ist und dass sie nichts von selbst zeigt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische Werte für ein Support-Gespräch. Sie werden erst nach einer ausdrücklichen Bestätigung angezeigt."
          }
        },
