    "threshold.nudge.settings.disclaimer": {
      "comment": "W-THRESHOLD-NUDGE — non-diagnostic disclaimer under the Settings opt-in toggle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice. HealthLog only checks readings against the reference or target ranges from your lab results and the markers you define. It never sets its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine medizinische Beratung. HealthLog vergleicht Werte nur mit den Referenz- oder Zielbereichen aus deinen Laborwerten und den von dir festgelegten Markern. Eigene Grenzwerte legt die App nie fest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen medisch advies. HealthLog vergelijkt metingen alleen met de referentie- of doelbereiken uit je labuitslagen en de markers die je zelf instelt. De app stelt nooit zelf grenzen vast."
          }
        }
      }
    },
