    "biomarker.editor.unit.waitsForServer": {
      "comment": "Lab marker editor, under the unit field: a marker created from a text result has no unit, and the connected server is too old to accept a unit change for it.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Marker hat noch keine Einheit. Festlegen kannst du sie, sobald dein Server aktualisiert ist. Umbenennen geht schon jetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This marker has no unit yet. You can set one once your server is updated. Renaming works now."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze marker heeft nog geen eenheid. Je kunt er een instellen zodra je server is bijgewerkt. Hernoemen kan nu al."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지표에는 아직 단위가 없습니다. 서버가 업데이트되면 단위를 지정할 수 있습니다. 이름 변경은 지금 바로 할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este marcador aún no tiene unidad. Podrás definirla cuando se actualice tu servidor. Cambiar el nombre ya funciona."
          }
        }
      }
    },
