      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät — keine Cloud, keine Aufzeichnung der Unterhaltung über die laufende Sitzung hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On device — no cloud, no recording of the conversation beyond the current session."
          }
        }
      }
    },
    "On errors, rate limits or a missing key, the server falls back to a deterministic template that only summarises local values.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Fehlern, Rate-Limits oder fehlendem Schlüssel fällt der Server automatisch auf eine deterministische Vorlage zurück, die nur lokale Werte zusammenfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On errors, rate limits or a missing key, the server falls back to a deterministic template that only summarises local values."
          }
        }
      }
    },
    "On worse %@ days your %@ averaged %@; on better days %@. Based on %lld days each side. %@ confidence.": {
      "comment": "VoiceOver value for one factor-crosstab row",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An schlechteren %1$@-Tagen lag dein/e %2$@ im Schnitt bei %3$@; an besseren Tagen bei %4$@. Basierend auf je %5$lld Tagen. Konfidenz: %6$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On worse %1$@ days your %2$@ averaged %3$@; on better days %4$@. Based on %5$lld days each side. %6$@ confidence."
          }
        }
      }
    },
