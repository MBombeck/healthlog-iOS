    "The Coach answers exclusively on-device and requires an iPhone with Apple Intelligence (iPhone 15 Pro or newer).": {
      "comment": "v0.5.7 G.3 — AskCoachSheet kill-card body for the .deviceNotEligible / .unsupported branch.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach antwortet ausschließlich auf dem Gerät und benötigt ein iPhone mit Apple Intelligence (iPhone 15 Pro oder neuer)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Coach answers exclusively on-device and requires an iPhone with Apple Intelligence (iPhone 15 Pro or newer)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach antwoordt uitsluitend op het apparaat en vereist een iPhone met Apple Intelligence (iPhone 15 Pro of nieuwer)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치는 기기에서만 답변하며, Apple Intelligence를 지원하는 iPhone(iPhone 15 Pro 이상)이 필요해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Coach responde exclusivamente en el dispositivo y requiere un iPhone con Apple Intelligence (iPhone 15 Pro o posterior)."
          }
        }
      }
    },
    "The Coach couldn't answer right now. Try again shortly.": {
