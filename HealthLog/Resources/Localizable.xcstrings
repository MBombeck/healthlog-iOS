    "labs.ocr.error.backgroundEnded": {
      "comment": "POLISH-A A4: lab report upload ended when the background grace time ran out",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hochladen wurde abgebrochen, weil HealthLog zu lange im Hintergrund war. Lass die App geöffnet, bis der Bericht hochgeladen ist, und versuch es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload stopped because HealthLog was in the background for too long. Keep the app open until the report is uploaded, then try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uploaden is gestopt omdat HealthLog te lang op de achtergrond stond. Houd de app open tot het rapport is geüpload en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog가 너무 오래 백그라운드에 있어서 업로드가 중단됐어요. 결과지 업로드가 끝날 때까지 앱을 열어 두고 다시 시도해 주세요."
          }
        }
      }
    },
