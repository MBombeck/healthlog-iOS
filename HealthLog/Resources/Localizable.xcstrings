    },
    "Your provider quota is used up. Check your account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter-Kontingent ist aufgebraucht. Prüfe dein Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider quota is used up. Check your account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
