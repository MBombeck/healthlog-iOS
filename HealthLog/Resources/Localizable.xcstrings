            "value": "Wat de tellers betekenen"
          }
        }
      }
    },
    "settings.hkdiag.explainer_upload": {
      "comment": "BF-5 — Explainer bullet for upload counter.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragen: wie viele davon dein Server gespeichert hat, neu, geändert oder schon vorhanden. Übersprungene und geparkte Werte zählen hier nicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded: how many of them your server stored, new, changed or already there. Skipped and parked values are not counted here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurd: hoeveel daarvan je server heeft opgeslagen, nieuw, gewijzigd of al aanwezig. Overgeslagen en geparkeerde waarden tellen hier niet mee."
          }
        }
      }
    },
