        }
      }
    },
    "The External AI coach answers through your server's AI provider — but none is configured yet. Set up a server provider (or your own key) to use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Externe-KI-Coach antwortet über den KI-Anbieter deines Servers, aber es ist noch keiner konfiguriert. Richte einen Server-Anbieter (oder deinen eigenen Schlüssel) ein, um ihn zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
