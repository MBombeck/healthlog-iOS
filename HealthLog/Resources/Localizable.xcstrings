    "The Coach needs your consent to use external AI. Grant it in Settings → Assistant.": {
      "comment": "C3 — server Coach error: missing consent receipt (server 403).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach braucht deine Zustimmung für externe KI. Erteile sie unter Einstellungen > Assistent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Coach needs your consent to use external AI. Grant it in Settings > Assistant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach heeft je toestemming nodig om externe AI te gebruiken. Geef die via Instellingen > Assistent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 외부 AI를 사용하려면 동의가 필요해요. 설정 > 어시스턴트에서 동의해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Coach necesita tu consentimiento para usar IA externa. Concédelo en Ajustes > Asistente."
          }
        }
      }
    },
    "The External AI coach answers through your server's AI provider — but none is configured yet. Set up a server provider (or your own key) to use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Externe-KI-Coach antwortet über den KI-Anbieter deines Servers, aber es ist noch keiner konfiguriert. Richte einen Server-Anbieter (oder deinen eigenen Schlüssel) ein, um ihn zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The External AI coach answers through your server's AI provider, but none is configured yet. Set up a server provider (or your own key) to use it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach met externe AI antwoordt via de AI-aanbieder van je server, maar er is er nog geen ingesteld. Stel een serveraanbieder (of je eigen sleutel) in om hem te gebruiken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 AI 코치는 서버의 AI 제공자를 통해 답변하지만, 아직 설정된 제공자가 없어요. 사용하려면 서버 제공자(또는 내 키)를 설정하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Coach con IA externa responde a través del proveedor de IA de tu servidor, pero aún no hay ninguno configurado. Configura un proveedor en el servidor (o tu propia clave) para usarlo."
          }
        }
      }
    },
    "The WHOOP sign-in expired. Please connect again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die WHOOP-Anmeldung ist abgelaufen. Bitte verbinde erneut."
