    "settings.hkdiag.explainer_read": {
      "comment": "BF-5 — Explainer bullet for read counter.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesen: wie viele Werte Apple Health seit dem App-Start gemeldet hat, ohne die, die HealthLog selbst geschrieben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read: how many values Apple Health has reported since the app started, not counting those HealthLog wrote itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelezen: hoeveel waarden Apple Health heeft gemeld sinds de app is gestart, zonder de waarden die HealthLog zelf heeft geschreven."
          }
        }
      }
    },
    "settings.hkdiag.explainer_title": {
      "comment": "BF-5 — Explainer card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Werte bedeuten"
