    "insights.subPage.explainer.vascularAgeBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gefäßalter ist die Schätzung deines Geräts, wie alt sich deine Arterien im Vergleich zu deinem tatsächlichen Alter verhalten, ermittelt anhand der Arteriensteifigkeit. Ein Gefäßalter unter dem echten Alter deutet auf gesündere Blutgefäße hin. Deine Waage oder dein Ring hat die Schätzung ermittelt, und sie blickt auf vergangene Werte zurück, statt etwas vorherzusagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vascular age is your device’s estimate of how old your arteries behave compared with your actual age, based on arterial stiffness. A vascular age below your real age suggests healthier blood vessels. Your scale or ring derived the estimate, and it looks back at past readings rather than predicting anything."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatleeftijd is de schatting van je apparaat van hoe oud je bloedvaten zich gedragen in vergelijking met je werkelijke leeftijd, op basis van de stijfheid van je slagaders. Een vaatleeftijd onder je echte leeftijd wijst op gezondere bloedvaten. Je weegschaal of ring heeft deze schatting berekend, en die kijkt terug naar eerdere metingen in plaats van iets te voorspellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈관 나이는 동맥 경직도를 바탕으로 내 동맥이 실제 나이와 비교해 몇 살처럼 기능하는지 기기가 추정한 값이에요. 혈관 나이가 실제 나이보다 낮으면 혈관이 더 건강하다는 뜻일 수 있어요. 이 추정값은 체중계나 링이 계산한 것으로, 과거 측정값을 되돌아볼 뿐 무언가를 예측하지는 않아요."
          }
        }
      }
    },
    "insights.subPage.explainer.vascularAgeTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefäßalter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vascular age"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatleeftijd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혈관 나이"
          }
        }
      }
    },
    "insights.subPage.explainer.visceralFatBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viszeralfett ist das Fett, das tief im Bauchraum um die Organe gespeichert wird. Anders als das Unterhautfett ist ein hoher Wert eng mit Herzkrankheiten und Typ-2-Diabetes verbunden, daher ist niedriger meist besser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visceral fat is the fat stored deep in the abdomen around your organs. Unlike fat under the skin, a high level is closely linked to heart disease and type 2 diabetes, so lower is generally better."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Visceraal vet is het vet dat diep in je buik rond je organen ligt opgeslagen. Anders dan vet onder de huid hangt een hoge waarde sterk samen met hart- en vaatziekten en diabetes type 2, dus lager is meestal beter."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장지방은 복부 깊숙이 장기 주변에 쌓이는 지방이에요. 피하지방과 달리 수치가 높으면 심장 질환, 제2형 당뇨병과 밀접한 관련이 있어서, 대체로 낮을수록 좋아요."
          }
        }
      }
    },
    "insights.subPage.explainer.visceralFatTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viszeralfett"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visceral fat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Visceraal vet"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장지방"
          }
        }
      }
    },
    "insights.subPage.explainer.walkingAsymmetryBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gangasymmetrie ist der Anteil der Zeit, in der deine Schritte zwischen linkem und rechtem Bein ungleichmäßig sind. Ein höherer Prozentsatz kann auf Schmerzen, eine Verletzung oder ein Gangproblem hindeuten, das näher betrachtet werden sollte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking asymmetry is the share of time your steps are uneven between the left and right leg. A higher percentage can point to pain, injury, or a gait problem worth looking into."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopasymmetrie is het deel van de tijd waarin je stappen tussen je linker- en rechterbeen ongelijk zijn. Een hoger percentage kan wijzen op pijn, een blessure of een probleem met je looppatroon dat het bekijken waard is."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 비대칭은 걸을 때 왼발과 오른발의 걸음이 고르지 않은 시간의 비율이에요. 비율이 높으면 통증, 부상, 또는 살펴볼 만한 보행 문제가 있다는 뜻일 수 있어요."
          }
        }
      }
    },
    "insights.subPage.explainer.walkingAsymmetryTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gangasymmetrie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking asymmetry"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopasymmetrie"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 비대칭"
          }
        }
      }
    },
    "insights.subPage.explainer.walkingDistanceBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geh- und Laufstrecke ist die Strecke, die du täglich zu Fuß zurücklegst. Sie ergänzt die Schrittzahl, indem sie zeigt, wie weit du dich bewegt hast, nicht nur wie oft du getreten bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking and running distance is the ground you cover on foot each day. It complements step count by reflecting how far you moved, not just how often you stepped."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandel- en hardloopafstand is de afstand die je elke dag te voet aflegt. Het vult het aantal stappen aan, omdat het laat zien hoe ver je bent gekomen en niet alleen hoe vaak je een stap zette."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걷기 및 달리기 거리는 하루 동안 두 발로 이동한 거리예요. 걸음 수를 보완해서, 얼마나 자주 걸었는지뿐 아니라 얼마나 멀리 움직였는지 보여줘요."
          }
        }
      }
    },
    "insights.subPage.explainer.walkingDistanceTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh- + Laufstrecke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking + running distance"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandel- en hardloopafstand"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걷기 + 달리기 거리"
          }
        }
      }
    },
    "insights.subPage.explainer.walkingHeartRateBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herzfrequenz beim Gehen ist dein durchschnittlicher Puls bei einem gleichmäßigen Spaziergang. Ein über die Zeit niedrigerer Wert spiegelt bei gleicher Anstrengung oft eine bessere Herz-Kreislauf-Fitness wider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking heart rate is your average pulse during a steady walk. A lower walking rate over time often reflects improving cardiovascular fitness for the same effort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelhartslag is je gemiddelde hartslag tijdens een rustige wandeling. Een lagere wandelhartslag door de tijd heen wijst vaak op een betere conditie van hart en bloedvaten bij dezelfde inspanning."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 심박수는 일정한 속도로 걸을 때의 평균 맥박이에요. 시간이 지나면서 보행 심박수가 낮아지면, 같은 활동에 대한 심혈관 체력이 좋아지고 있다는 뜻인 경우가 많아요."
          }
        }
      }
    },
    "insights.subPage.explainer.walkingHeartRateTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herzfrequenz beim Gehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking heart rate"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelhartslag"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 심박수"
          }
        }
      }
    },
    "insights.subPage.explainer.walkingSpeedBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gehgeschwindigkeit ist, wie schnell du dich auf ebenem Untergrund fortbewegst. Sie ist ein gut untersuchter Marker für allgemeine Gesundheit und Beweglichkeit, und ein gleichbleibendes oder steigendes Tempo ist ein gutes Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking speed is how fast you move on a level walk. It is a well-studied marker of overall health and mobility, and a steady or rising pace is a good sign."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopsnelheid is hoe snel je beweegt bij wandelen op vlak terrein. Het is een goed onderzochte graadmeter voor je algehele gezondheid en mobiliteit, en een gelijkblijvend of stijgend tempo is een goed teken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 속도는 평지를 걸을 때 얼마나 빠르게 움직이는지예요. 전반적인 건강과 이동 능력을 보여주는 잘 연구된 지표이고, 속도가 유지되거나 빨라지면 좋은 신호예요."
          }
        }
      }
    },
    "insights.subPage.explainer.walkingSpeedTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehgeschwindigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking speed"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopsnelheid"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 속도"
          }
        }
      }
    },
    "insights.subPage.explainer.walkingSteadinessBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gehstabilität schätzt, wie stabil und ausgewogen dein Gangbild ist, eingeteilt von OK bis niedrig. Ein niedriger Wert deutet auf ein höheres Sturzrisiko hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking steadiness estimates how stable and balanced your gait is, classed from OK to low. A lower level points to a higher chance of a fall."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopstabiliteit schat hoe stabiel en evenwichtig je looppatroon is, ingedeeld van OK tot laag. Een lager niveau wijst op een grotere kans op vallen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 안정성은 걸음걸이가 얼마나 안정적이고 균형 잡혀 있는지 추정해서 양호부터 낮음까지 등급으로 나눠요. 등급이 낮을수록 낙상 가능성이 높다는 뜻이에요."
          }
        }
      }
    },
    "insights.subPage.explainer.walkingSteadinessTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehstabilität"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking steadiness"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopstabiliteit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보행 안정성"
          }
        }
      }
    },
    "insights.subPage.explainer.weightBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Körpergewicht ist eines der einfachsten Signale für die langfristige Energiebilanz und die allgemeine Gesundheit. Der Trend über Wochen zählt weit mehr als ein einzelner Wert, der mit Flüssigkeit, Ernährung und Tageszeit schwankt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body weight is one of the simplest signals of long-term energy balance and overall health. The trend over weeks matters far more than any single reading, which fluctuates with hydration, food, and time of day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichaamsgewicht is een van de eenvoudigste signalen van je energiebalans op lange termijn en je algehele gezondheid. De trend over weken telt veel zwaarder dan een losse meting, die schommelt met vocht, voeding en het tijdstip van de dag."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중은 장기적인 에너지 균형과 전반적인 건강을 보여주는 가장 간단한 신호 중 하나예요. 한 번의 측정값은 수분, 음식, 시간대에 따라 오르내리므로 몇 주에 걸친 추세가 훨씬 중요해요."
          }
        }
      }
    },
    "insights.subPage.explainer.weightTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중"
          }
        }
      }
    },
    "insights.subPage.explainer.workoutsBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts sind die strukturierten Trainingseinheiten, die deine Geräte mit Art, Dauer und Energie aufzeichnen. Ihre Erfassung zeigt, wie sich regelmäßiges Training über Wochen summiert und wie es mit deinen anderen Gesundheitssignalen zusammenhängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts are the structured exercise sessions your devices record, with type, duration, and energy. Tracking them shows how regular training accumulates over weeks and how it relates to your other health signals."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingen zijn de gestructureerde sportsessies die je apparaten vastleggen, met soort, duur en energie. Door ze bij te houden zie je hoe regelmatig trainen zich over weken opbouwt en hoe het samenhangt met je andere gezondheidssignalen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동은 기기가 기록한 체계적인 운동 세션으로, 종류, 시간, 에너지가 함께 기록돼요. 기록해 두면 꾸준한 운동이 몇 주에 걸쳐 어떻게 쌓이는지, 다른 건강 신호와 어떤 관련이 있는지 볼 수 있어요."
          }
        }
      }
    },
    "insights.subPage.explainer.workoutsTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동"
          }
        }
      }
    },
    "insights.subPage.explainer.wristTemperatureBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Handgelenktemperatur wird im Schlaf gemessen. Apple zeigt sie als Abweichung von deinem persönlichen Ausgangswert; ein gleichmäßiger Wert ist normal, ein anhaltender Anstieg kann auf Krankheit, intensives Training oder eine Zyklusveränderung hindeuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist temperature is measured while you sleep. Apple shows it as the difference from your personal baseline; a steady reading is normal, while a sustained rise can hint at illness, intense training, or a cycle change."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polstemperatuur wordt gemeten terwijl je slaapt. Apple toont het als het verschil met je persoonlijke basiswaarde. Een stabiele waarde is normaal, terwijl een aanhoudende stijging kan wijzen op ziekte, intensieve training of een verandering in je cyclus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손목 온도는 잠자는 동안 측정해요. Apple은 이를 내 개인 기준값과의 차이로 보여줘요. 값이 일정하면 정상이고, 계속 올라가면 질병, 고강도 운동, 생리 주기 변화의 신호일 수 있어요."
          }
        }
      }
    },
    "insights.subPage.explainer.wristTemperatureTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handgelenktemperatur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist temperature"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polstemperatuur"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손목 온도"
          }
        }
      }
    },
