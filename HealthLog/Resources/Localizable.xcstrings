    "medications.composition.edit.footer": {
      "comment": "SUPP-EDIT composition form",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag die Mengen so ein, wie sie auf dem Etikett stehen. Jede genommene Dosis zählt danach in die Mikronährstoffe des Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the amounts as the label states them. Every dose taken then counts towards the day's micronutrients."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de hoeveelheden in zoals ze op het etiket staan. Elke ingenomen dosis telt daarna mee voor de micronutriënten van de dag."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨에 적힌 대로 함량을 입력하세요. 그러면 복용한 용량마다 그날의 미량영양소에 더해져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce las cantidades tal como aparecen en la etiqueta. Cada dosis tomada contará para los micronutrientes del día."
          }
        }
      }
    },
