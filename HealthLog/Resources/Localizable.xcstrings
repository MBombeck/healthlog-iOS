    "Four pillars: blood pressure on target, weight trend, mood stability, medication compliance. Missing pillars are redistributed proportionally across the ones present — the score never lies about what was actually measured.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Säulen: Blutdruck im Ziel, Gewichts-Trend, Stimmungs-Stabilität, Medikamenten-Therapietreue. Fehlende Säulen werden anteilig auf die vorhandenen verteilt — der Score lügt nie über das, was tatsächlich gemessen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four pillars: blood pressure on target, weight trend, mood stability, medication compliance. Missing pillars are redistributed proportionally across the ones present — the score never lies about what was actually measured."
          }
        }
      }
    },
