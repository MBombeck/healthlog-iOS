    "onboarding.route.unavailable.body": {
      "comment": "08-08 — why the app stops here instead of guessing. No \"continue anyway\": continuing IS the guess.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne diese Antwort wissen wir nicht, ob du die Einrichtung schon abgeschlossen hast — und wir raten nicht. Deine Daten bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without that answer we don't know whether you already finished setting up, and we won't guess. Your data is untouched."
          }
        }
      }
    },
