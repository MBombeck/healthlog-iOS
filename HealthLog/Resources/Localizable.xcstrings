            "state": "translated",
            "value": "Je slaap wordt nog in kaart gebracht: tot nu toe %#@nights@, nog %2$lld nodig voor een betrouwbaar saldo."
          },
          "substitutions": {
            "nights": {
              "argNum": 1,
