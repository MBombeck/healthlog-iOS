            "value": "%1$lld read, %2$lld uploaded, %3$lld stats actions"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld gelezen, %2$lld geüpload, %3$lld statistiekacties"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개 읽음, %2$lld개 업로드됨, 통계 작업 %3$lld개"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld leídos, %2$lld subidos, %3$lld acciones de estadísticas"
          }
        }
      }
    },
    "settings.hkdiag.explainer_read": {
      "comment": "BF-5 — Explainer bullet for read counter.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesen: wie viele Werte Apple Health seit dem App-Start gemeldet hat, ohne die, die HealthLog selbst geschrieben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read: how many values Apple Health has reported since the app started, not counting those HealthLog wrote itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelezen: hoeveel waarden Apple Health heeft gemeld sinds de app is gestart, zonder de waarden die HealthLog zelf heeft geschreven."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽음: 앱 시작 후 Apple Health가 보고한 값의 수예요. HealthLog가 직접 쓴 값은 제외해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leídos: cuántos valores ha enviado Apple Health desde que se inició la app, sin contar los que escribió el propio HealthLog."
          }
        }
      }
    },
    "settings.hkdiag.explainer_title": {
      "comment": "BF-5 — Explainer card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Werte bedeuten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the counters mean"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de tellers betekenen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운터의 의미"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué significan los contadores"
          }
        }
      }
    },
    "settings.hkdiag.explainer_upload": {
      "comment": "BF-5 — Explainer bullet for upload counter.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragen: wie viele davon dein Server gespeichert hat, neu, geändert oder schon vorhanden. Übersprungene und geparkte Werte zählen hier nicht mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded: how many of them your server stored, new, changed or already there. Skipped and parked values are not counted here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurd: hoeveel daarvan je server heeft opgeslagen, nieuw, gewijzigd of al aanwezig. Overgeslagen en geparkeerde waarden tellen hier niet mee."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드됨: 그중 서버가 저장한 값의 수예요(신규, 변경, 기존 값 포함). 건너뛰거나 보류된 값은 여기서 세지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subidos: cuántos de ellos guardó tu servidor, ya sean nuevos, modificados o existentes. Los valores omitidos o aparcados no se cuentan aquí."
          }
        }
      }
    },
    "settings.hkdiag.freshness_empty": {
      "comment": "CU-21 — server knows the field but no type has delivered yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Typ hat den Server erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No type has reached the server yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen enkel type heeft de server bereikt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서버에 도달한 유형이 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no ha llegado ningún tipo al servidor."
          }
        }
      }
    },
    "settings.hkdiag.freshness_title": {
      "comment": "CU-21 — per-metric freshness sub-heading.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frische pro Typ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freshness per type"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiteit per type"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유형별 최신 상태"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualidad por tipo"
          }
        }
      }
    },
    "settings.hkdiag.info.about": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, What is this",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dein Server und dieses iPhone über den Abgleich mit Apple Health wissen, zum Nachsehen, wenn etwas fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your server and this iPhone know about the sync with Apple Health, for when something is missing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je server en deze iPhone weten over de synchronisatie met Apple Health, om na te kijken als er iets ontbreekt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 동기화에 대해 서버와 이 iPhone이 알고 있는 정보예요. 뭔가 빠졌을 때 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tu servidor y este iPhone saben de la sincronización con Apple Health, para cuando falte algo."
          }
        }
      }
    },
    "settings.hkdiag.info.held.title": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, section title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehalten und abgelehnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held back and refused"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegengehouden en geweigerd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 및 거부"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenidos y rechazados"
          }
        }
      }
    },
    "settings.hkdiag.info.sources.server": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-Sicht fragt deinen Server jedes Mal frisch ab, wenn du die Seite öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server view asks your server afresh each time you open this page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De serverweergave vraagt je server telkens opnieuw als je deze pagina opent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 보기는 이 페이지를 열 때마다 서버에 새로 요청해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista del servidor consulta de nuevo a tu servidor cada vez que abres esta página."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.session": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aktuelle Sitzung“ und „Pro Messgröße“ zählen auf diesem iPhone seit dem letzten App-Start und beginnen danach wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Current session” and “Per kind” count on this iPhone since the app last started, and start from zero again after every launch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Huidige sessie” en “Per soort” tellen op deze iPhone sinds de app het laatst is gestart, en beginnen na elke start weer bij nul."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“현재 세션”과 “종류별”은 앱이 마지막으로 시작된 뒤 이 iPhone에서 센 값이며, 앱을 실행할 때마다 0부터 다시 시작해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sesión actual” y “Por tipo” cuentan en este iPhone desde el último inicio de la app, y vuelven a cero tras cada inicio."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.stored": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen Karten zeigen, was dieses iPhone über Neustarts hinweg gespeichert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other cards show what this iPhone has kept across launches."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle andere kaarten tonen wat deze iPhone over herstarts heen heeft bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지 카드는 이 iPhone이 앱 실행 간에 보관한 정보를 보여 줘요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las demás tarjetas muestran lo que este iPhone ha conservado entre inicios."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.title": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, section title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woher die Werte kommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the values come from"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar de waarden vandaan komen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값의 출처"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De dónde vienen los valores"
          }
        }
      }
    },
    "settings.hkdiag.kinds_empty": {
      "comment": "BF-5 — Empty-state copy when no kinds observed yet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Aktivität in dieser Sitzung. Die Zähler füllen sich mit dem nächsten Lauf im Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity in this session yet. The counters fill up with the next background run."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen activiteit in deze sessie. De tellers vullen zich bij de volgende ronde op de achtergrond."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에서는 아직 활동이 없어요. 다음 백그라운드 실행 때 카운터가 채워져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay actividad en esta sesión. Los contadores se llenarán con la próxima ejecución en segundo plano."
          }
        }
      }
    },
    "settings.hkdiag.kinds_subtitle": {
      "comment": "BF-5 — Per-kind list card explainer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüft heißt, die App hat nachgesehen. Neuer Wert heißt, etwas Neues ging an den Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked means the app looked. New value means something new went to the server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerd betekent dat de app heeft gekeken. Nieuwe waarde betekent dat er iets nieuws naar de server is gegaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인됨은 앱이 살펴봤다는 뜻이에요. 새 값은 새로운 데이터가 서버로 전송됐다는 뜻이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisado significa que la app miró. Valor nuevo significa que algo nuevo llegó al servidor."
          }
        }
      }
    },
    "settings.hkdiag.kinds_title": {
      "comment": "BF-5 — Per-kind list card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Messgröße"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kind"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per soort"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종류별"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por tipo"
          }
        }
      }
    },
    "settings.hkdiag.limits_bgrefresh": {
      "comment": "#66 P0.1 — Background App Refresh switch bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „Hintergrundaktualisierung“ ausgeschaltet, entfallen die kurzen Auffrisch-Läufe komplett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Background App Refresh” is off, the quick refresh runs are skipped entirely."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als 'Ververs op achtergrond' uit staat, worden de korte verversingen helemaal overgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“백그라운드 앱 새로 고침”이 꺼져 있으면 빠른 새로 고침 실행은 모두 건너뛰어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si “Actualización en segundo plano” está desactivada, las actualizaciones rápidas no se ejecutan."
          }
        }
      }
    },
    "settings.hkdiag.limits_discretion": {
      "comment": "#66 P0.1 — system discretion bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet selbst, wann es weckt, meist beim Laden oder nachts. Neue Daten können daher erst mit Verzögerung am Server ankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides when to wake the app, usually while charging or overnight. New data can therefore reach the server only after a delay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bepaalt zelf wanneer de app wordt gewekt, meestal tijdens het opladen of 's nachts. Nieuwe gegevens kunnen daardoor pas met vertraging op de server aankomen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 언제 깨울지는 iOS가 정해요. 보통 충전 중이거나 밤사이예요. 그래서 새 데이터가 서버에 늦게 도착할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide cuándo activar la app, normalmente mientras se carga o por la noche. Por eso los datos nuevos pueden llegar al servidor con retraso."
          }
        }
      }
    },
    "settings.hkdiag.limits_footer": {
      "comment": "#66 P0.1 — system-limits card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht „Letzter Hintergrund-Sync“ auf „Noch nichts“, obwohl die App lief, hält iOS die Hintergrund-Zeit zurück. Das ist kein App-Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Last background sync” still says “Nothing yet” although the app has run, iOS is withholding background time. That is not an app bug."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat “Laatste synchronisatie op de achtergrond” nog op “Nog niets”, terwijl de app wel heeft gedraaid, dan houdt iOS de tijd op de achtergrond tegen. Dat is geen fout in de app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 실행됐는데도 “마지막 백그라운드 동기화”가 여전히 “아직 없음”이면 iOS가 백그라운드 시간을 주지 않고 있는 거예요. 앱 버그가 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si “Última sincronización en segundo plano” sigue diciendo “Nada todavía” aunque la app se haya ejecutado, iOS está reteniendo el tiempo en segundo plano. No es un error de la app."
          }
        }
      }
    },
    "settings.hkdiag.limits_forcequit": {
      "comment": "#66 P0.1 — force-quit limit bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischst du die App im App-Umschalter weg, startet iOS sie im Hintergrund nicht mehr, bis du sie wieder öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you swipe the app away in the App Switcher, iOS stops starting it in the background until you open it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg je de app weg in de appkiezer, dan start iOS hem niet meer op de achtergrond tot je hem weer opent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전환기에서 앱을 쓸어 올려 닫으면, 다시 열 때까지 iOS가 앱을 백그라운드에서 시작하지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cierras la app deslizándola en el selector de apps, iOS deja de iniciarla en segundo plano hasta que vuelvas a abrirla."
          }
        }
      }
    },
    "settings.hkdiag.limits_openIosSettings": {
      "comment": "UI-Standard R4 (U2) — Absprung, der den Prosa-Wegweiser auf „Hintergrundaktualisierung“ ersetzt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-Einstellungen öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open iOS Settings"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-instellingen openen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 열기"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes de iOS"
          }
        }
      }
    },
    "settings.hkdiag.limits_title": {
      "comment": "#66 P0.1 — system-limits card title.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzen im Hintergrund"
          }
        },
        "en": {
