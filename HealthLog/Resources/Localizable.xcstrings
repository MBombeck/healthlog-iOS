    "settings.applehealth.history.note": {
      "comment": "1.3 public #25 — Apple Health settings: what the full catch-up does and what it needs.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein älterer Verlauf folgt von selbst. Alles auf einmal braucht die App offen und das iPhone am Ladegerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your older history follows on its own. All at once needs the app open and the iPhone on the charger."
          }
        },
