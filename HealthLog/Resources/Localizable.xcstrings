            "value": "Diese Stelle ist für dieses Medikament nicht freigegeben, deshalb wurde sie nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This medication doesn't allow that site, so it wasn't saved."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze plek is niet toegestaan voor dit medicijn, dus hij is niet opgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 약에는 해당 부위를 사용할 수 없어 저장하지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este medicamento no admite esa zona, así que no se guardó."
          }
        }
      }
    },
