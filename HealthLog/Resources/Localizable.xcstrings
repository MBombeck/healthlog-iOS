        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent antwoordt pas weer als je opnieuw een sleutel invoert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 다시 입력할 때까지 어시스턴트가 답변하지 않아요."
          }
        },
        "es": {
