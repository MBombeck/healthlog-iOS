          }
        }
      }
    },
    "labs.ocr.error.tooLarge": {
      "comment": "LAB-OCR error: labs.ocr.tooLarge / fileTooLarge",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht ist zu groß zum Lesen. Versuch es mit weniger Seiten oder einem einzelnen Foto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report is too large to read. Try fewer pages or a single photo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit rapport is te groot om te lezen. Probeer minder pagina's of één foto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 결과지는 너무 커서 읽을 수 없어요. 페이지 수를 줄이거나 사진 한 장으로 시도해 주세요."
          }
        }
      }
    },
    "labs.ocr.error.budgetExceeded": {
      "comment": "LAB-OCR error: labs.ocr.budgetExceeded",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für heute ist das Kontingent zum Lesen aufgebraucht. Morgen geht es wieder, bis dahin kann dein iPhone den Bericht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's allowance for reading is used up. It works again tomorrow; until then your iPhone can read the report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tegoed om te lezen is voor vandaag op. Morgen werkt het weer, tot die tijd kan je iPhone het rapport lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 읽기 사용량을 다 썼어요. 내일 다시 사용할 수 있고, 그때까지는 iPhone이 결과지를 읽을 수 있어요."
          }
        }
      }
    },
    "labs.ocr.error.rateLimited": {
      "comment": "LAB-OCR error: rate limit",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade schon einige Berichte lesen lassen. Versuch es etwas später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have had a few reports read just now. Try again a little later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt net al een paar rapporten laten lezen. Probeer het iets later opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 결과지를 여러 번 읽었어요. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
    "labs.ocr.error.fileType": {
      "comment": "LAB-OCR error: labs.ocr.fileType",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei lässt sich nicht lesen. Wähle ein Foto oder ein PDF."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be read. Choose a photo or a PDF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kan niet worden gelezen. Kies een foto of een pdf."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 읽을 수 없어요. 사진이나 PDF를 선택하세요."
          }
        }
      }
    },
    "labs.ocr.error.timedOut": {
      "comment": "LAB-OCR error: the run timed out",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen hat zu lange gedauert und wurde beendet. Versuch es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading took too long and was ended. Try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lezen duurde te lang en is gestopt. Probeer het later opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽는 데 시간이 너무 오래 걸려 중단됐어요. 나중에 다시 시도해 주세요."
          }
        }
      }
    },
    "labs.ocr.error.consentRequired": {
      "comment": "LAB-OCR error: consent missing",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das genauere Lesen fehlt deine Einwilligung zur KI. Du kannst sie in den Einstellungen geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading more accurately needs your consent to AI. You can give it in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor nauwkeuriger lezen is je toestemming voor AI nodig. Die kun je geven in Instellingen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 정확하게 읽으려면 AI 처리 동의가 필요해요. 설정에서 동의할 수 있어요."
          }
        }
      }
    },
    "labs.ocr.error.unavailable": {
      "comment": "LAB-OCR error: switched off or not permitted",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das genauere Lesen ist gerade nicht verfügbar. Dein iPhone kann den Bericht weiter selbst lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading more accurately is not available right now. Your iPhone can still read the report itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauwkeuriger lezen is nu niet beschikbaar. Je iPhone kan het rapport nog steeds zelf lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 더 정확하게 읽기를 사용할 수 없어요. 결과지는 여전히 iPhone이 직접 읽을 수 있어요."
          }
        }
      }
    },
    "labs.ocr.error.offline": {
      "comment": "LAB-OCR error: offline",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Versuch es noch einmal, sobald du online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Try again once you are online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding. Probeer het opnieuw zodra je online bent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되지 않았어요. 온라인 상태가 되면 다시 시도해 주세요."
          }
        }
      }
    },
    "labs.ocr.error.failed": {
      "comment": "LAB-OCR error: anything else",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht konnte gerade nicht gelesen werden. Versuch es später noch einmal oder lass ihn von deinem iPhone lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report could not be read just now. Try again later or have your iPhone read it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport kon nu niet worden gelezen. Probeer het later opnieuw of laat je iPhone het lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 결과지를 읽지 못했어요. 나중에 다시 시도하거나 iPhone으로 읽어 보세요."
          }
        }
      }
    },
    "labs.ocr.saveFailed": {
      "comment": "LAB-OCR: commit failed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte konnten nicht gespeichert werden. Sie bleiben stehen, damit du es noch einmal versuchen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The readings could not be saved. They stay listed so you can try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De waarden konden niet worden opgeslagen. Ze blijven in de lijst staan, zodat je het opnieuw kunt proberen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값을 저장하지 못했어요. 다시 시도할 수 있도록 목록에 남겨 뒀어요."
          }
        }
      }
    },
    "labs.ocr.savedSkipped.%lld.%lld": {
      "comment": "LAB-OCR: commit with skipped rows",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Werte gespeichert. %2$lld nicht gespeichert, weil es sie schon gibt oder die Einheit nicht zum Laborwert passt. Sie sind ausgeschaltet und bleiben in der Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved %1$lld readings. %2$lld were not saved because they already exist or their unit does not fit the lab value. They are switched off and stay in the list."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld waarden opgeslagen. %2$lld niet opgeslagen, omdat ze al bestaan of de eenheid niet bij de labwaarde past. Ze staan uit en blijven in de lijst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값 %1$lld개를 저장했어요. %2$lld개는 이미 있거나 단위가 검사 수치에 맞지 않아 저장하지 않았어요. 이 항목은 꺼진 상태로 목록에 남아 있어요."
          }
        }
      }
    },
