    "settings.applehealth.routes.subtitle": {
      "comment": "1.5 ROUTES: why the route switch exists. Routes are GPS location data; they reach only the person's own account.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routen sind Ortsdaten. Sie gehen nur an dein HealthLog-Konto und erst, wenn du sie hier einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes are location data. They only go to your HealthLog account, and only once you switch them on here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes zijn locatiegegevens. Ze gaan alleen naar je HealthLog-account, en pas als je ze hier inschakelt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로는 위치 데이터예요. 내 HealthLog 계정으로만 전송되며, 여기서 켠 뒤에만 전송돼요."
          }
        }
      }
    },
    "settings.applehealth.routes.toggle": {
