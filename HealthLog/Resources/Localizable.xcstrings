    "settings.support.gate_consequence": {
      "comment": "08-15 — Der Satz, der vor dem zweiten Tipp steht: die Folge der Bestaetigung.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach stehen Geräte-Kennungen und Zeitstempel auf dem Bildschirm. Nichts davon wird gespeichert oder gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device fragments and timestamps will then be on screen. Nothing is stored or sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staan dan apparaatfragmenten en tijdstempels op het scherm. Er wordt niets opgeslagen of verstuurd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 정보 일부와 타임스탬프가 화면에 표시돼요. 아무것도 저장하거나 전송하지 않아요."
          }
        }
      }
    },
