        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 알림과 실시간 현황에 약 이름 대신 일반 문구가 표시돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios y la actividad en vivo mostrarán entonces una etiqueta genérica en lugar del nombre del medicamento."
          }
        }
      }
    },
