    "anamnesis.action.remove": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Closes the current revision without recording a successor.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angabe entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove entry"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registratie verwijderen"
          }
        }
      }
    },
    "anamnesis.error.conflict": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 anamnesis.fact.conflict — a concurrent write closed the row between the guard and the update.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angabe wurde zwischenzeitlich an anderer Stelle geändert. Wir haben den aktuellen Stand neu geladen. Prüfe ihn und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry changed elsewhere in the meantime. We reloaded the current state. Check it and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze registratie is intussen ergens anders gewijzigd. We hebben de actuele stand opnieuw geladen. Controleer die en probeer het opnieuw."
          }
        }
      }
    },
    "anamnesis.error.currentExists": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 anamnesis.fact.currentExists — a current value already exists, so PATCH is the right verb.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Angabe gibt es bereits einen aktuellen Wert. Wir haben neu geladen. Korrigiere ihn, statt ihn neu anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry already has a current value. We reloaded. Correct it instead of creating a new one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze registratie heeft al een actuele waarde. We hebben opnieuw geladen. Corrigeer die in plaats van een nieuwe aan te maken."
