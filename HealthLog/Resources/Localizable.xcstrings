        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서의 일부를 끝까지 읽지 못해 일부 값이 빠져 있을 수 있어요. 문서와 대조해 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del documento no se leyó por completo, así que pueden faltar valores. Compruébalos con el documento."
          }
        }
      }
    },
