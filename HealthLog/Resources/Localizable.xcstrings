          }
        }
      }
    },
    "WHOOP is rate-limiting requests. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP drosselt gerade Anfragen. Versuche es gleich noch einmal."
