    "onboarding.passkey.firstTimeHint": {
      "comment": "v0.7.0 — Helper caption under the Passkey CTA hinting that password-managers may also serve stored passkeys.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstes Mal auf diesem Gerät? Tippe trotzdem hier. Dein Passwort-Manager bietet gespeicherte Passkeys an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First time on this device? Tap here anyway. Your password manager will offer any stored passkeys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste keer op dit apparaat? Tik hier toch. Je wachtwoordbeheerder biedt eventuele bewaarde toegangssleutels aan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 처음인가요? 그래도 여기를 탭하세요. 비밀번호 관리자가 저장된 패스키를 보여 줄 거예요."
          }
        }
      }
    },
    "onboarding.passkey.providers": {
