    "onboarding.auth.error.rateLimited": {
      "comment": "Sign-in form: the server rate-limited password sign-in (429).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Bitte warte ein paar Minuten und versuch es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Please wait a few minutes and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Wacht een paar minuten en probeer het dan opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시도가 너무 많아요. 몇 분 기다린 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de inicio de sesión. Espera unos minutos e inténtalo de nuevo."
          }
        }
      }
    },
    "onboarding.auth.error.passwordLoginDisabled": {
      "comment": "Sign-in form: the server only allows SSO (403 oidc_only).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Passwort ist auf diesem Server abgeschaltet. Melde dich stattdessen per SSO an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password sign-in is turned off on this server. Sign in with SSO instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met een wachtwoord is uitgeschakeld op deze server. Log in plaats daarvan in met SSO."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에서는 비밀번호 로그인이 꺼져 있어요. SSO로 로그인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con contraseña está desactivado en este servidor. Inicia sesión con SSO."
          }
        }
      }
    },
