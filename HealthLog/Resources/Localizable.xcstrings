    "integration.oauth.alreadyLinked %@": {
      "comment": "OAuth connect refused with already_linked; %@ is the provider name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses %@-Konto ist schon mit einem anderen HealthLog-Profil verbunden. Melde dich mit dem Konto an, das zu diesem Profil gehört, oder trenne es zuerst vom anderen Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %@ account is already connected to another HealthLog profile. Sign in with the account that belongs to this profile, or disconnect it from the other profile first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit %@-account is al gekoppeld aan een ander HealthLog-profiel. Log in met het account dat bij dit profiel hoort, of ontkoppel het eerst van het andere profiel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %@ 계정은 이미 다른 HealthLog 프로필에 연결되어 있어요. 이 프로필의 계정으로 로그인하거나, 먼저 다른 프로필에서 연결을 해제해 주세요."
          }
        }
      }
    },
