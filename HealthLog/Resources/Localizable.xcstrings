    "onboarding.route.checking": {
      "comment": "08-08 — shown while the app asks the server whether this account already finished setup.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird geprüft, ob deine Einrichtung schon abgeschlossen ist …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking whether your setup is already complete…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleren of je configuratie al voltooid is…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 이미 완료됐는지 확인하는 중…"
          }
        }
      }
    },
    "onboarding.route.unavailable.body": {
      "comment": "08-08 — why the app stops here instead of guessing. No \"continue anyway\": continuing IS the guess.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne diese Antwort wissen wir nicht, ob du die Einrichtung schon abgeschlossen hast, und wir raten nicht. Deine Daten bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without that answer we don't know whether you already finished setting up, and we won't guess. Your data is untouched."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder dat antwoord weten we niet of je de configuratie al hebt afgerond, en we gaan niet gokken. Je gegevens blijven onaangeroerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 결과가 없으면 설정을 이미 마쳤는지 알 수 없어서, 추측하지 않아요. 데이터는 그대로예요."
          }
        }
      }
    },
    "onboarding.route.unavailable.title": {
      "comment": "08-08 — the completion lookup did not resolve. States the limit, not a consequence.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einrichtungsstand ließ sich nicht abrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't check your setup status."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de status van je configuratie niet controleren."
          }
        },
