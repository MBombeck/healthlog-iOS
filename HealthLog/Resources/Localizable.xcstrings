    "life.auditC.legacy.hint": {
      "comment": "POLISH-C C7, server records.life.auditC.legacyHint.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der kurzen Alkoholfrage vor diesem Fragebogen. Sobald ein Fragebogen-Ergebnis vorliegt, liest der Coach sie nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
