        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeert het kritieke alarm opnieuw in te stellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요 알람을 다시 설정해요."
          }
        }
      }
    },
