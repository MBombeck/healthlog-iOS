        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passkey dialog couldn't be shown. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het venster voor de toegangssleutel kan niet worden getoond. Probeer het opnieuw."
