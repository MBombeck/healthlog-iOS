      "comment": "Parity 1.1/1.7/1.8 — Phase 1 Datenintegritaet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Tag wird aus %lld bisherigen Eintrag entfernt. Das lässt sich nicht rückgängig machen."
