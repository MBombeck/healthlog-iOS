    "illness.correlation.recoveryGap.driver.symptom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your logged symptoms were the last to ease."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
