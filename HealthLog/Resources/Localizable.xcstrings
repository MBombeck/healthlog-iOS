    "settings.coach.insightsPrivacy.description": {
      "comment": "Settings → Coach — help text for the insights AI privacy-mode picker",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aggregiert“ schickt der KI nur zusammengefasste Trends. „Volle Details“ schickt auch einzelne Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
