    "settings.applehealth.history.note": {
      "comment": "1.3 public #25 — Apple Health settings: what the full catch-up does and what it needs.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein älterer Verlauf folgt von selbst. Alles auf einmal braucht die App offen und das iPhone am Ladegerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your older history follows on its own. All at once needs the app open and the iPhone on the charger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je oudere geschiedenis volgt vanzelf. Alles in één keer vraagt dat de app open is en de iPhone aan de oplader ligt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 기록은 자동으로 이어서 전송돼요. 한 번에 모두 보내려면 앱을 열어 두고 iPhone을 충전기에 연결해야 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial anterior se irá enviando solo. Para enviarlo todo de una vez, la app tiene que estar abierta y el iPhone cargándose."
          }
        }
      }
    },
