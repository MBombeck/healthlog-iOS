    "settings.applehealth_import.privacy_delete": {
      "comment": "APH-IMP-stub — privacy step 4: ZIP deleted after parsing.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ZIP-Datei wird danach von deinem Server gelöscht. Nur die übernommenen Werte bleiben in deinem Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ZIP file is then deleted from your server. Only the imported values remain in your account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zip-bestand wordt daarna van je server verwijderd. Alleen de overgenomen waarden blijven in je account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그다음 ZIP 파일은 서버에서 삭제돼요. 가져온 값만 계정에 남아요."
          }
        }
      }
    },
    "settings.applehealth_import.privacy_parse": {
      "comment": "APH-IMP-stub — privacy step 2: server parses XML parse-only.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server liest die Datei nur aus. Sie wird nicht abgelegt, nicht weitergeleitet und nicht für Training benutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server only reads the file. It is not stored, not forwarded and not used for training."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server leest het bestand alleen uit. Het wordt niet bewaard, niet doorgestuurd en niet gebruikt voor training."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 파일을 읽기만 해요. 파일은 저장되지 않고, 전달되지 않으며, 학습에 사용되지 않아요."
          }
        }
      }
    },
    "settings.applehealth_import.privacy_stats": {
      "comment": "APH-IMP-stub — privacy step 3: stats returned.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach siehst du pro Messwert, wie viel übernommen wurde, aus welchem Zeitraum und wie viele Doppelte es gab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Afterwards you see per measurement how much was imported, from which period and how many duplicates there were."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna zie je per meting hoeveel er is overgenomen, uit welke periode en hoeveel dubbele er waren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기가 끝나면 측정 항목별로 얼마나 가져왔는지, 어느 기간의 데이터인지, 중복이 몇 개였는지 볼 수 있어요."
          }
        }
      }
    },
