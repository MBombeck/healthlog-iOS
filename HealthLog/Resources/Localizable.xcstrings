    "mood.patterns.multipleEntriesHigher %@ %@": {
      "comment": "#136 Mood pattern multiple_entries, higher.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit mehreren Einträgen ist deine Stimmung meist besser (%1$@ gegenüber %2$@ an Tagen mit einem)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days you log more than once, your mood tends to be higher (%1$@ against %2$@ on single-entry days)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dagen dat je meer dan eens iets vastlegt, is je stemming meestal beter (%1$@ tegenover %2$@ op dagen met één registratie)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 두 번 이상 기록한 날에는 기분이 더 좋은 경향이 있어요 (한 번만 기록한 날 %2$@ 대비 %1$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días que registras más de una vez, tu estado de ánimo suele ser mejor (%1$@ frente a %2$@ con un solo registro)."
          }
        }
      }
    },
