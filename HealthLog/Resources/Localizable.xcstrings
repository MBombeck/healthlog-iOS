    "Mood %@ on days with %@, %@ without. %@ difference, based on %lld days each side. %@ confidence.": {
      "comment": "VoiceOver value for one mood tag-influence row",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmung %1$@ an Tagen mit %2$@, %3$@ ohne. %4$@ Unterschied, basierend auf je %5$lld Tagen. Konfidenz: %6$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood %@ on days with %@, %@ without. %@ difference, based on %lld days each side. %@ confidence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemming %@ op dagen met %@, %@ zonder. %@ verschil, gebaseerd op %lld dagen per kant. Betrouwbaarheid: %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 있는 날 기분 %1$@, 없는 날 %3$@. 차이 %4$@, 각각 %5$lld일 기준. 신뢰도 %6$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de ánimo %@ los días con %@, %@ sin. Diferencia de %@, basada en %lld días por cada lado. Confianza %@."
          }
        }
      }
    },
