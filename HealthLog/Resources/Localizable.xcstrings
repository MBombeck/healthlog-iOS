    "documents.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Arztbriefe, Laborbefunde, Bildgebung, Rezepte und Impfnachweise auf: verschlüsselt und durchsuchbar nach Typ, Erkrankung und Jahr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep doctor's letters, lab results, imaging, prescriptions and vaccination records, encrypted and searchable by type, condition and year."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar brieven van je arts, labuitslagen, beeldvorming, recepten en vaccinatiebewijzen: versleuteld en doorzoekbaar op type, aandoening en jaar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사 소견서, 검사 결과, 영상 검사, 처방전, 예방접종 기록을 암호화해 보관하고 종류, 질환, 연도별로 찾아보세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cartas médicas, resultados de laboratorio, imágenes, recetas y certificados de vacunación, cifrados y con búsqueda por tipo, afección y año."
          }
        }
      }
    },
