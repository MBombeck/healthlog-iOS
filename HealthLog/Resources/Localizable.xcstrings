    "HealthLog": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog"
          }
        }
      }
    },
    "HealthLog can add findings and a coach. Pick how — privately on your device, online from your provider, or not at all. You can change this anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kann Einschätzungen und einen Coach ergänzen. Wähle, wie: privat auf deinem Gerät, online von deinem Anbieter oder gar nicht. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog can add findings and a coach. Pick how: privately on your device, online from your provider, or not at all. You can change this anytime in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kan bevindingen en een coach toevoegen. Kies hoe: privé op je apparaat, online via je provider of helemaal niet. Je kunt dit altijd wijzigen in Instellingen."
          }
        }
      }
    },
    "HealthLog can remind you of your medications and alert you when a value looks off. You can change this in Settings at any time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kann dich an deine Medikamente erinnern und warnt dich, wenn ein Wert auffällig ist. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog can remind you of your medications and alert you when a value looks off. You can change this in Settings at any time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kan je herinneren aan je medicijnen en je waarschuwen als een waarde afwijkt. Je kunt dit altijd wijzigen in Instellingen."
          }
        }
      }
    },
    "HealthLog can't read your Apple Health data. Tap to connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kann deine Apple-Health-Daten nicht abrufen. Tippe zum Verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog can't read your Apple Health data. Tap to connect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kan je Apple Health-gegevens niet lezen. Tik om te verbinden."
          }
        }
      }
    },
    "HealthLog has no access to %lld data types. Tap to connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog hat keinen Zugriff auf %lld Datentypen. Tippe zum Verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog has no access to %lld data types. Tap to connect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog heeft geen toegang tot %lld gegevenstypen. Tik om te verbinden."
          }
        }
      }
    },
    "HealthLog has no access to one data type. Tap to connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog hat keinen Zugriff auf einen Datentyp. Tippe zum Verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog has no access to one data type. Tap to connect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog heeft geen toegang tot één gegevenstype. Tik om te verbinden."
          }
        }
      }
    },
    "HealthLog has no access to your Apple Health data on this device. Connect it so your values arrive automatically.": {
      "comment": "25-01 update-notice card (decision E-2026-08-28)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog hat auf diesem Gerät keinen Zugriff auf deine Apple-Health-Daten. Verbinde es, damit deine Werte automatisch eintreffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog has no access to your Apple Health data on this device. Connect it so your values arrive automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog heeft op dit apparaat geen toegang tot je Apple Health-gegevens. Verbind het zodat je waarden automatisch binnenkomen."
          }
        }
      }
    },
    "HealthLog is locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog gesperrt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog is locked"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog is vergrendeld"
          }
        }
      }
    },
    "HealthLog reads values from Apple Health and writes your entries back. You stay in control per data type.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog liest Werte aus Apple Health und schreibt deine Eingaben zurück. Du behältst die Kontrolle pro Datentyp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog reads values from Apple Health and writes your entries back. You stay in control per data type."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog leest waarden uit Apple Health en schrijft je registraties terug. Je houdt per gegevenstype zelf de controle."
          }
        }
      }
    },
    "HealthLog sends excerpts of your health data — recent measurements, medications, sleep, and mood — directly to %@, using the API key you provided, to generate personal insights.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog sendet Auszüge deiner Gesundheitsdaten (aktuelle Messwerte, Medikamente, Schlaf und Stimmung) mit dem von dir angegebenen API-Schlüssel direkt an %@, um persönliche Insights zu generieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog sends excerpts of your health data (recent measurements, medications, sleep, and mood) directly to %@, using the API key you provided, to generate personal insights."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog stuurt fragmenten van je gezondheidsgegevens (recente metingen, medicijnen, slaap en stemming) met de API-sleutel die je hebt opgegeven rechtstreeks naar %@ om persoonlijke inzichten te maken."
          }
        }
      }
    },
    "HealthLog sends excerpts of your health data — recent measurements, medications, sleep, and mood — to %@ to generate personal insights.": {
      "extractionState": "manual",
      "localizations": {
