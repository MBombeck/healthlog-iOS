    "sessions.signOutAll.else.confirmBody": {
      "comment": "Sessions screen — confirm dialog body on servers from v1.38.11, where the route spares the calling device. The pre-1.38.11 wording stays in sessions.signOutAll.confirmBody.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen werden beendet und alle anderen App-Anmeldungen widerrufen. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session ends and every other app sign-in is revoked. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke browsersessie wordt beëindigd en elke andere login in de app wordt ingetrokken. Dit apparaat blijft ingelogd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 세션이 종료되고 다른 모든 앱 로그인이 해지돼요. 이 기기는 로그인 상태로 유지돼요."
          }
        }
      }
    },
    "sessions.signOutAll.else.doneBody": {
      "comment": "Sessions screen — success alert body on servers from v1.38.11, where the calling device keeps its sign-in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen wurden beendet und alle anderen App-Anmeldungen widerrufen. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other sessions have ended and every other app sign-in has been revoked. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere sessies zijn beëindigd en elke andere login in de app is ingetrokken. Dit apparaat blijft ingelogd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 세션이 종료됐고 다른 모든 앱 로그인이 해지됐어요. 이 기기는 로그인 상태로 유지돼요."
          }
        }
      }
    },
    "sessions.signOutAll.else.footer": {
      "comment": "Sessions screen — footer under the sign-out-everywhere button on servers from v1.38.11, where this device is spared.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen ab und widerruft die Anmeldung aller anderen Apps. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and revokes every other app sign-in. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt alle browsersessies uit en trekt de inlog van alle andere apps in. Dit apparaat blijft ingelogd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 세션에서 로그아웃하고 다른 모든 앱 로그인을 해지해요. 이 기기는 로그인 상태로 유지돼요."
          }
        }
      }
    },
    "sessions.signOutAll.footer": {
      "comment": "Sessions screen — footer under the sign-out-everywhere button. States the honest consequence: on iOS the server also revokes this device's refresh token.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen ab und widerruft die Anmeldung aller Apps, auch auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and revokes every app sign-in, including on this device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt alle browsersessies uit en trekt de inlog van alle apps in, ook op dit apparaat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 포함해 모든 브라우저 세션에서 로그아웃하고 모든 앱 로그인을 해지해요."
          }
        }
      }
    },
