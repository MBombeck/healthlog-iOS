            "value": "Das Medikament, das du prüfen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The medication to check."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het medicijn dat je wilt controleren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "확인할 약이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El medicamento que quieres comprobar."
          }
        }
      }
    },
    "Opens HealthLog and jumps straight to logging your mood.": {
      "comment": "AppIntents — description of the Log mood control intent",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet HealthLog direkt beim Erfassen deiner Stimmung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens HealthLog and jumps straight to logging your mood."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent HealthLog en gaat direct naar het vastleggen van je stemming."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HealthLog를 열고 바로 기분 기록 화면으로 가요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre HealthLog y va directamente al registro de tu estado de ánimo."
          }
        }
      }
    },
    "Your doses are out of date. Open HealthLog, then try again.": {
      "comment": "AppIntents — next-dose control fired on an out-of-date widget snapshot; nothing recorded",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dosen sind nicht aktuell. Öffne HealthLog und versuch es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your doses are out of date. Open HealthLog, then try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je doses zijn niet actueel. Open HealthLog en probeer het dan opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복용 정보가 최신이 아니에요. HealthLog를 연 다음 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus dosis no están actualizadas. Abre HealthLog y vuelve a intentarlo."
          }
        }
      }
    },
    "This dose is already recorded.": {
      "comment": "AppIntents — next-dose control fired for a dose that was already saved; nothing recorded again",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dosis ist schon erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dose is already recorded."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze dosis is al vastgelegd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 복용은 이미 기록되어 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta dosis ya está registrada."
          }
        }
      }
    },
    "onboarding.welcome.leftoverStandaloneData": {
      "comment": "Footnote on the welcome screen, shown only on a device that ran the retired offline mode and still holds its records.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät liegen noch Daten aus dem früheren Modus ohne Server. Diese Version kann sie nicht mehr übernehmen. Sie bleiben vorerst auf dem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device still holds data from the earlier mode without a server. This version can no longer import it. It stays on the device for now."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat staan nog gegevens uit de eerdere modus zonder server. Deze versie kan ze niet meer overnemen. Ze blijven voorlopig op het apparaat bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 기기에는 서버 없이 쓰던 이전 모드의 데이터가 아직 남아 있어요. 이 버전은 그 데이터를 더 이상 가져올 수 없어요. 데이터는 당분간 기기에 그대로 남아 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo aún contiene datos del modo anterior sin servidor. Esta versión ya no puede importarlos. Por ahora se quedan en el dispositivo."
          }
        }
      }
    },
