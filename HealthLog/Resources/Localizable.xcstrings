    "cycle.upcoming.late": {
      "comment": "Cycle page, upcoming cycles: the server says the next period is past its band (projectionState LATE). Muted, factual.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Prognose, solange diese Periode später kommt als erwartet. Sie ist zurück, sobald du die Periode erfasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No forecast while this period is later than expected. It returns once you log it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen voorspelling zolang deze menstruatie later komt dan verwacht. Die komt terug zodra je haar vastlegt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 생리가 예상보다 늦어지는 동안에는 예측이 없어요. 생리를 기록하면 다시 표시돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay previsión mientras esta regla se retrase. Vuelve en cuanto la registres."
          }
        }
      }
    },
    "cycle.upcoming.footnote": {
      "comment": "Cycle page, upcoming cycles: footnote under the list.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile nennt den wahrscheinlichsten ersten Tag und das Zeitfenster, in das er fallen kann. Je weiter voraus, desto breiter das Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each line names the most likely first day and the window it may fall in. The further ahead, the wider the window."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke regel noemt de meest waarschijnlijke eerste dag en het venster waarin die kan vallen. Hoe verder vooruit, hoe breder het venster."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 줄은 가장 가능성이 높은 첫날과 그날이 올 수 있는 기간을 보여 줘요. 멀리 내다볼수록 기간이 넓어져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea indica el primer día más probable y el intervalo en que puede caer. Cuanto más lejos, más amplio el intervalo."
          }
        }
      }
    },
