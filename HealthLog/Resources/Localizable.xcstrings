    "nutrients.energyBalance.trendMeta": {
      "comment": "Energy balance: the headline is the seven-day trend",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittel der letzten sieben Tage: Gegessenes minus Ruhe- und Aktivenergie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average of the last seven days: what you ate minus resting and active energy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemiddelde van de laatste zeven dagen: wat je at min rust- en actieve energie."
