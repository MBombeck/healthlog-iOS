          "stringUnit": {
            "state": "translated",
            "value": "값이 하나도 완성되기 전에 읽기가 중단됐어요. 페이지 수가 더 적은 문서로 시도해 보세요."
          }
        }
      }
    },
    "documents.read.tooLarge": {
      "comment": "The automatic read gave up because the file is too large or complex. It is not tried again.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist zu groß oder zu komplex zum Lesen. Die Datei selbst ist in Ordnung und lässt sich weiter öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is too large or complex to read. The file itself is fine and still opens."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document is te groot of te complex om te lezen. Het bestand zelf is in orde en blijft te openen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 너무 크거나 복잡해서 읽을 수 없어요. 파일 자체에는 문제가 없으며 계속 열 수 있어요."
          }
        }
      }
    },
    "med.lifecycle.end.confirm.message.now": {
      "comment": "Confirmation text before ending a medication course immediately (server 1.46 or later).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab jetzt ist keine Dosis mehr fällig und es kommt keine Erinnerung mehr, auch heute nicht. Was du heute schon genommen hast, zählt weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From now on no dose is due and no reminder comes, today included. Doses you already took today still count."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf nu is er geen dosis meer gepland en komt er geen herinnering meer, ook vandaag niet. Wat je vandaag al hebt ingenomen, telt nog mee."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘을 포함해 지금부터는 예정된 복용도, 알림도 없어요. 오늘 이미 복용한 것은 그대로 계산돼요."
          }
        }
      }
    },
    "med.lifecycle.start": {
      "comment": "Button in the treatment status section of the medication editor; starts a new course today.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Behandlung starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new treatment"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe kuur starten"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 복용 기간 시작"
          }
        }
      }
    },
    "med.history.auto_recorded": {
      "comment": "Caption under a dose in the medication history that the server recorded by itself (auto mark taken).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch erfasst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded automatically"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch geregistreerd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 기록됨"
          }
        }
      }
    },
    "med.wirkung.autocorrelationCaveat": {
      "comment": "Footnote on a medication effect card when the server flags strong day-to-day carry-over in the readings.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tageswerte hängen stark vom Vortag ab, deshalb ist der Vergleich unsicherer, als er aussieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daily values carry over strongly from one day to the next, so the comparison is less certain than it looks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dagwaarden hangen sterk af van de vorige dag, dus de vergelijking is minder zeker dan ze lijkt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 값이 전날 값에 크게 좌우되므로, 이 비교는 보이는 것보다 불확실해요."
          }
        }
      }
    },
    "settings.applehealth.writeback.review": {
      "comment": "Apple Health settings: link next to the write-back notice. Opens the Apple Health app, where the person can allow the missing write types.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibzugriff prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review write access"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijftoegang controleren"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 권한 확인"
          }
        }
      }
    },
    "settings.applehealth.writeback.review.hint": {
      "comment": "VoiceOver hint of the 'Review write access' link on the Apple Health settings page.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Apple Health. Dort unter deinem Profilbild > Datenschutz > Apps > HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Apple Health. There, go to your profile picture > Privacy > Apps > HealthLog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Apple Health. Ga daar naar je profielfoto > Privacy > Apps > HealthLog."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health을 열어요. 그곳에서 프로필 사진 > 개인정보 보호 > 앱 > HealthLog로 이동하세요."
          }
        }
      }
    },
    "account.deletionPending.signIn %@": {
      "comment": "Sign-in refused: account locked inside its deletion grace window; %@ is the erasure date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wird am %@ gelöscht und ist bis dahin gesperrt. Ein Admin kann die Löschung vor diesem Datum rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion on %@ and is locked until then. An admin can undo the deletion before that date."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account wordt op %@ verwijderd en is tot dan vergrendeld. Een beheerder kan het verwijderen voor die datum ongedaan maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 %@에 삭제될 예정이며 그때까지 잠겨 있어요. 그 전에는 관리자가 삭제를 취소할 수 있어요."
          }
        }
      }
    },
    "account.deletionPending.signIn.noDate": {
      "comment": "Sign-in refused: account pending deletion, no date known",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist zur Löschung vorgemerkt und gesperrt. Ein Admin kann die Löschung rückgängig machen, bis sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion and is locked. An admin can undo the deletion until it completes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account staat gepland voor verwijdering en is vergrendeld. Een beheerder kan het verwijderen ongedaan maken tot het is afgerond."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 삭제 예정이라 잠겨 있어요. 삭제가 끝나기 전까지는 관리자가 취소할 수 있어요."
          }
        }
      }
    },
    "account.deleted.receipt.scheduled %@": {
      "comment": "Alert after deletion with a grace window; %@ is the erasure date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist gesperrt und wird am %@ endgültig gelöscht. Bis dahin kann ein Admin die Löschung rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is locked and will be deleted for good on %@. Until then an admin can undo the deletion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is vergrendeld en wordt op %@ definitief verwijderd. Tot die tijd kan een beheerder het verwijderen ongedaan maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 잠겼고 %@에 완전히 삭제돼요. 그때까지는 관리자가 삭제를 취소할 수 있어요."
          }
        }
      }
    },
    "account.deleted.receipt.now": {
      "comment": "Alert after an immediate deletion",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und alle Daten wurden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and all its data have been deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account en al je gegevens zijn verwijderd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 모든 데이터가 삭제되었어요."
          }
        }
      }
    },
    "deleteAccount.grace.intro": {
      "comment": "Delete account intro when the server keeps a grace window",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, wird dein Konto sofort gesperrt und danach mit allen Daten endgültig gelöscht:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you continue, your account is locked right away and then deleted for good with all your data:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je doorgaat, wordt je account meteen vergrendeld en daarna met al je gegevens definitief verwijderd:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 계정이 바로 잠기고, 이후 모든 데이터와 함께 완전히 삭제돼요:"
          }
        }
      }
    },
    "deleteAccount.grace.date %@": {
      "comment": "Delete account bullet; %@ is the expected erasure date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig gelöscht wird alles am %@. Bis dahin ist dein Konto gesperrt und ein Admin kann die Löschung rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is deleted for good on %@. Until then your account is locked and an admin can undo the deletion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt op %@ definitief verwijderd. Tot die tijd is je account vergrendeld en kan een beheerder het verwijderen ongedaan maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 모든 것이 완전히 삭제돼요. 그때까지 계정은 잠기며 관리자가 삭제를 취소할 수 있어요."
          }
        }
      }
    },
    "deleteAccount.grace.unknown": {
      "comment": "Delete account bullet when the grace window length is unknown",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig gelöscht wird alles nach einer Frist, die dein Admin festlegt. Bis dahin ist dein Konto gesperrt und ein Admin kann die Löschung rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is deleted for good after a waiting period your admin sets. Until then your account is locked and an admin can undo the deletion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt definitief verwijderd na een wachttijd die je beheerder bepaalt. Tot die tijd is je account vergrendeld en kan een beheerder het verwijderen ongedaan maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자가 정한 대기 기간이 지나면 모든 것이 완전히 삭제돼요. 그때까지 계정은 잠기며 관리자가 삭제를 취소할 수 있어요."
          }
        }
      }
    },
    "deleteAccount.grace.consent": {
      "comment": "Delete account consent toggle with a grace window",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass mein Konto gesperrt und danach mit allen Daten endgültig gelöscht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that my account is locked and then deleted for good with all its data."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat mijn account wordt vergrendeld en daarna met al mijn gegevens definitief wordt verwijderd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 잠긴 뒤 모든 데이터와 함께 완전히 삭제된다는 것을 이해했어요."
          }
        }
      }
    },
    "resetData.grace.intro": {
      "comment": "Reset data intro when a restorable copy is kept",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, werden diese Daten gelöscht:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you continue, this data is deleted:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je doorgaat, worden deze gegevens verwijderd:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 다음 데이터가 삭제돼요:"
          }
        }
      }
    },
    "resetData.grace.date %@": {
      "comment": "Reset data bullet; %@ is the expected end of the restore window",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie bleibt bis zum %@ erhalten, damit ein Admin sie wiederherstellen kann. Danach ist die Löschung endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy is kept until %@ so an admin can restore it. After that the deletion is final."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er blijft tot %@ een kopie bewaard, zodat een beheerder die kan herstellen. Daarna is het verwijderen definitief."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자가 복원할 수 있도록 %@까지 사본이 보관돼요. 그 후에는 삭제가 최종적으로 확정돼요."
          }
        }
      }
    },
    "resetData.grace.unknown": {
      "comment": "Reset data bullet when the window length is unknown",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie bleibt eine Zeit lang erhalten, die dein Admin festlegt, damit sie wiederhergestellt werden kann. Danach ist die Löschung endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy is kept for a period your admin sets, so it can be restored. After that the deletion is final."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er blijft een tijd lang een kopie bewaard, die je beheerder bepaalt, zodat die kan worden hersteld. Daarna is het verwijderen definitief."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 수 있도록 관리자가 정한 기간 동안 사본이 보관돼요. 그 후에는 삭제가 최종적으로 확정돼요."
          }
        }
      }
    },
    "resetData.grace.consent": {
      "comment": "Reset data consent toggle with a restorable copy",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist klar, dass alle Gesundheitsdaten gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that all health data will be deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat alle gezondheidsgegevens worden verwijderd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 건강 데이터가 삭제된다는 것을 이해했어요."
          }
        }
      }
    },
    "resetData.success.restorable %@": {
      "comment": "Reset data success; %@ is restorableUntil",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gesundheitsdaten wurden gelöscht. Ein Admin kann sie bis zum %@ wiederherstellen. Dein Konto und deine Anmeldung bestehen weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your health data has been deleted. An admin can restore it until %@. Your account and sign-in remain active."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gezondheidsgegevens zijn verwijderd. Een beheerder kan ze tot %@ herstellen. Je account en inloggegevens blijven actief."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터가 삭제됐어요. %@까지는 관리자가 복원할 수 있어요. 계정과 로그인은 계속 유지돼요."
          }
        }
      }
    },
    "resetData.error.copyFailed": {
      "comment": "Reset data refused with data_wipe.copy_failed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts gelöscht. Die Sicherheitskopie deiner Daten ließ sich gerade nicht anlegen. Versuch es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was deleted. The safety copy of your data couldn't be made right now. Please try again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets verwijderd. De veiligheidskopie van je gegevens kon nu niet worden gemaakt. Probeer het later opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 삭제되지 않았어요. 지금은 데이터의 안전 사본을 만들 수 없어요. 나중에 다시 시도해 주세요."
          }
        }
      }
    },
    "more.deleteAccount.subtitle": {
      "comment": "Subtitle of the delete account row",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dein Konto und alle Daten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes your account and all data"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert je account en alle gegevens"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 모든 데이터를 삭제해요"
          }
        }
      }
    },
    "integration.fitbit.retired.ended %@": {
      "comment": "Fitbit retired; %@ is the turndown date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat die Fitbit-Anbindung am %@ abgeschaltet. Diese Verbindung synchronisiert nicht mehr."
          }
        },
        "en": {
