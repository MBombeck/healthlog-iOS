    "illness.optIn.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a private journal of illnesses, injuries and ongoing conditions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe ein privates Tagebuch über Erkrankungen, Verletzungen und anhaltende Beschwerden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een privédagboek bij van ziektes, blessures en aanhoudende klachten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질환, 부상, 지속되는 건강 상태를 나만의 일지로 기록해요."
          }
        }
      }
    },
    "illness.optIn.bullet.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your own vitals shifted around an illness, computed on the server from your baseline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie sich deine Vitalwerte rund um eine Erkrankung gegenüber deinem Ausgangswert verändert haben, berechnet auf dem Server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie hoe je vitale waarden rond een ziekte zijn veranderd ten opzichte van je basiswaarde, berekend op de server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아팠던 기간 전후로 내 활력 징후가 어떻게 달라졌는지 볼 수 있어요. 서버가 내 기준값을 바탕으로 계산해요."
          }
        }
      }
    },
    "illness.optIn.bullet.journal": {
      "extractionState": "manual",
