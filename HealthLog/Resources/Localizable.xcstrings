          }
        }
      }
    },
    "insights.metric.assessment.title": {
      "comment": "Section header for the server-generated per-metric assessment (web Einschätzung).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschätzung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessment"
          }
        },
        "nl": {
          "stringUnit": {
