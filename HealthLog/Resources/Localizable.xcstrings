          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a height between 50 and 300 cm, or leave the field empty."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een lengte in tussen 50 en 300 cm, of laat het veld leeg."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 50~300 cm 사이로 입력하거나 비워 두세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una altura entre 50 y 300 cm, o deja el campo vacío."
          }
        }
      }
    },
