    "nutrients.upperLimit.above %@ %@": {
      "comment": "SUPP #131: shown only when the server says the day is above the upper limit. %1$@ = amount with unit, %2$@ = the cited source (e.g. EFSA). Server wording nutrients.micronutrients.aboveUpperLimit.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über der tolerierbaren Höchstmenge für Erwachsene von %1$@ pro Tag (%2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the tolerable upper intake level for adults of %1$@ a day (%2$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven de aanvaardbare bovengrens voor volwassenen van %1$@ per dag (%2$@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성인 하루 상한 섭취량(%1$@)을 넘었어요 (%2$@)."
          }
        }
      }
    },
    "nutrients.upperLimit.aboveSupplemental %@ %@": {
      "comment": "SUPP #131: shown only when the server says the supplement share is above a supplement-only upper limit. %1$@ = amount with unit, %2$@ = the cited source. Server wording nutrients.micronutrients.aboveUpperLimitSupplemental.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anteil aus Präparaten liegt über der tolerierbaren Höchstmenge für Erwachsene von %1$@ pro Tag für Präparate (%2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The supplement share is above the tolerable upper intake level for adults of %1$@ a day for supplements (%2$@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aandeel uit supplementen ligt boven de aanvaardbare bovengrens voor volwassenen van %1$@ per dag voor supplementen (%2$@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보충제로 섭취한 양이 성인 보충제 기준 하루 상한 섭취량(%1$@)을 넘었어요 (%2$@)."
          }
        }
      }
    },
    "nutrients.upperLimit.form.retinol": {
      "comment": "SUPP #131: follows the upper-limit sentence when the level is set for retinol. Server wording.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Höchstmenge gilt nur für vorgeformtes Vitamin A (Retinol): Stammt die Menge aus Beta-Carotin, gilt sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level covers preformed vitamin A (retinol) only: if the amount comes from beta-carotene, it does not apply."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grens geldt alleen voor voorgevormd vitamine A (retinol): als de hoeveelheid uit bètacaroteen komt, is hij niet van toepassing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상한은 기성 비타민 A(레티놀)에만 적용돼요. 베타카로틴에서 온 양이라면 적용되지 않아요."
          }
        }
      }
    },
    "nutrients.upperLimit.form.folic_acid": {
      "comment": "SUPP #131: follows the upper-limit sentence when the level is set for folic acid. Server wording.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Höchstmenge gilt für Folsäure aus Präparaten und angereicherten Lebensmitteln, nicht für das Folat in gewöhnlicher Nahrung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level covers folic acid from supplements and fortified foods, not the folate in ordinary food."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grens geldt voor foliumzuur uit supplementen en verrijkte voedingsmiddelen, niet voor het folaat in gewone voeding."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상한은 보충제와 강화식품의 엽산에 적용되며, 일반 음식의 엽산염에는 적용되지 않아요."
          }
        }
      }
    },
    "nutrients.upperLimit.form.magnesium_salts": {
      "comment": "SUPP #131: follows the upper-limit sentence when the level is set for magnesium salts. Server wording.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Höchstmenge gilt für leicht lösliche Magnesiumsalze in Präparaten, nicht für das Magnesium aus der Nahrung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level covers readily dissociable magnesium salts in supplements, not the magnesium in food."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grens geldt voor gemakkelijk dissocieerbare magnesiumzouten in supplementen, niet voor het magnesium in voeding."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 상한은 보충제의 쉽게 해리되는 마그네슘염에 적용되며, 음식의 마그네슘에는 적용되지 않아요."
          }
        }
      }
    },
    "nutrients.upperLimit.form.alpha_tocopherol": {
