    "onboarding.baselineProfile.footer": {
      "comment": "G4 parity — onboarding baseline-profile step footer.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles optional und jederzeit in den Einstellungen änderbar. Diese Angaben verbessern altersabhängige Referenzbereiche und den Gesundheitsbericht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All optional and editable anytime in Settings. These help with age-based reference ranges and the doctor report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles is optioneel en altijd te wijzigen in Instellingen. Dit helpt bij leeftijdsafhankelijke referentiebereiken en het artsenrapport."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 선택 사항이며 설정에서 언제든 수정할 수 있어요. 연령별 참고 범위와 진료용 리포트에 도움이 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo es opcional y puedes editarlo cuando quieras en Ajustes. Ayuda con los rangos de referencia según la edad y con el informe médico."
          }
        }
      }
    },
    "onboarding.baselineProfile.invalidHeight": {
