    "notifications.webhook.format.generic.footer": {
      "comment": "#112 — explains the generic webhook format",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet HealthLogs eigenen JSON-Body. Passt für Home Assistant, n8n und die meisten Relays."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends HealthLog's own JSON body. Suits Home Assistant, n8n and most relays."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurt de eigen JSON-body van HealthLog. Geschikt voor Home Assistant, n8n en de meeste relays."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog 자체 JSON 본문을 보내요. Home Assistant, n8n 및 대부분의 릴레이에 적합해요."
          }
        }
      }
    },
    "notifications.webhook.format.gotify.footer": {
      "comment": "#112 — explains the Gotify webhook format",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Titel, Nachricht und Priorität so, wie Gotify es erwartet. Nutze die /message-URL deines Servers, als Header-Namen X-Gotify-Key und den App-Token als Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends title, message and priority the way Gotify expects. Use your server's /message URL, header name X-Gotify-Key and the app token as its value."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurt titel, bericht en prioriteit zoals Gotify dat verwacht. Gebruik de /message-URL van je server, de headernaam X-Gotify-Key en het app-token als waarde."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotify가 요구하는 방식으로 제목, 메시지, 우선순위를 보내요. 서버의 /message URL을 사용하고, 헤더 이름은 X-Gotify-Key, 값은 앱 토큰으로 입력하세요."
          }
        }
      }
    },
    "notifications.channel.testFailure.credentialsRejected": {
