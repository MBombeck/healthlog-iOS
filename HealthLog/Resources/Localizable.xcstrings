    "integration.fitbit.retired.dataStays": {
      "comment": "Fitbit retirement: data stays, successor",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereits Importierte bleibt erhalten. Google Health liest dieselben Fitbit- und Pixel-Geräte und lässt sich im Web verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything already imported stays. Google Health reads the same Fitbit and Pixel devices and can be connected on the web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat al is geïmporteerd, blijft bewaard. Google Health leest dezelfde Fitbit- en Pixel-apparaten en kun je op het web koppelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 가져온 데이터는 모두 그대로 남아요. Google Health는 같은 Fitbit 및 Pixel 기기의 데이터를 읽으며, 웹에서 연결할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo ya importado se conserva. Google Health lee los mismos dispositivos Fitbit y Pixel y se puede conectar en la web."
          }
        }
      }
    },
