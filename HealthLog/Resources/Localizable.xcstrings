          }
        }
      }
    },
    "settings.applehealth.routes.footer": {
      "comment": "1.5 ROUTES: what switching on and off does. Server v1.47: tracks already stored stay until their workout is deleted.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neue Trainings. Ausschalten stoppt das Senden sofort. Schon gesendete Routen bleiben gespeichert, bis du das Training löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to new workouts. Switching it off stops sending right away. Routes already sent stay stored until you delete the workout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor nieuwe trainingen. Uitschakelen stopt het versturen meteen. Al verstuurde routes blijven bewaard tot je de training verwijdert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 운동에 적용돼요. 끄면 바로 전송이 멈춰요. 이미 보낸 경로는 운동을 삭제할 때까지 저장된 채로 남아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a los entrenamientos nuevos. Al desactivarlo, el envío se detiene de inmediato. Las rutas ya enviadas se guardan hasta que elimines el entrenamiento."
          }
        }
      }
    },
