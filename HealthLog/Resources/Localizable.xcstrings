    "intents.queued.rateLimited": {
      "comment": "AppIntents — write queued because the server rate-limited it (HTTP 429); no action needed",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Der Server ist gerade ausgelastet, der Eintrag wird gleich automatisch übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. The server is busy right now, so it will sync automatically in a moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen. De server is nu druk, dus het wordt zo meteen automatisch gesynchroniseerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했어요. 지금 서버가 바빠서 잠시 후 자동으로 동기화돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. El servidor está ocupado ahora, así que se sincronizará automáticamente en un momento."
          }
        }
      }
    },
