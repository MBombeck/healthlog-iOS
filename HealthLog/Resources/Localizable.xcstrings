    "onboarding.welcome.headline": {
      "comment": "v0.12 W7-2 — Welcome-screen hero headline (was a hardcoded literal). Two short lines, calm + personal.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gesundheit.\nDein Tempo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your health.\nYour pace."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw gezondheid.\nJouw tempo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 건강.\n나의 속도."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
