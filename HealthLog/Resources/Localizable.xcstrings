    "seizures.sheet.deleteBody": {
      "comment": "Seizure diary, web label seizures.sheet.deleteBody.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anfall und seine Notfalldosen werden entfernt, und die Dosen werden beim Medikament wieder ausgetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seizure and its rescue doses are removed, and the doses are taken off the medication again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanval en de bijbehorende nooddoses worden verwijderd, en de doses worden ook weer van het medicijn afgehaald."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발작과 응급약 투여 기록이 삭제되고, 해당 약에서도 투여 기록이 빠져요."
          }
        },
        "es": {
