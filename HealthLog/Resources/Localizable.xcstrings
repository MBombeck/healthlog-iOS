          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read stopped before a single value was complete. Try a document with fewer pages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lezen is gestopt voordat er één waarde volledig was. Probeer een document met minder pagina's."
          }
        }
      }
    },
    "documents.read.tooLarge": {
      "comment": "The automatic read gave up because the file is too large or complex. It is not tried again.",
