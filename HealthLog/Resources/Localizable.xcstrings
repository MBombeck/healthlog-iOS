    "nutrients.list.empty.moduleOff.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange das Nährstoff-Modul aus ist, fragt HealthLog Apple Health nicht nach Vitaminen, Mineralstoffen, Wasser und Koffein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the nutrients module is off, HealthLog never asks Apple Health for vitamins, minerals, water or caffeine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang de module voedingsstoffen uit staat, vraagt HealthLog Apple Health niet om vitaminen, mineralen, water of cafeïne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양소 모듈이 꺼져 있는 동안 HealthLog는 Apple Health에 비타민, 미네랄, 수분, 카페인 데이터를 요청하지 않아요."
          }
        }
      }
    },
