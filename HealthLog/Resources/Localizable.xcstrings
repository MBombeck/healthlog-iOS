    "chart.insufficient.onePoint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch eine Messung, dann erscheint hier der Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
