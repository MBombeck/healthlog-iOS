    "mentalHealth.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Screening-Selbsttest, keine Diagnose. Ein hoher oder niedriger Wert bedeutet nicht, dass eine Erkrankung vorliegt oder nicht. Nur eine qualifizierte Fachperson kann eine Diagnose stellen. Bei Sorgen sprich bitte mit deiner Ärztin oder deinem Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a screening self-assessment, not a diagnosis. A high or low score does not mean you do or do not have a condition. Only a qualified health professional can diagnose. If you have concerns, please talk to your doctor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een zelftest voor screening, geen diagnose. Een hoge of lage score betekent niet dat je wel of geen aandoening hebt. Alleen een bevoegde zorgverlener kan een diagnose stellen. Maak je je zorgen, praat dan met je arts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 검사는 선별용 자가 평가이며 진단이 아니에요. 점수가 높거나 낮다고 해서 어떤 질환이 있거나 없다는 뜻은 아니에요. 진단은 자격을 갖춘 의료 전문가만 할 수 있어요. 걱정되는 점이 있다면 의사와 상담해 주세요."
          }
        }
      }
    },
    "mentalHealth.error": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 생겼어요. 다시 시도해 주세요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.error`, word for word; ko from server v1.47.0 messages `mentalHealth.error`, word for word."
    },
    "mentalHealth.followUpHint.gad7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert liegt in einem Bereich, in dem ein Gespräch mit einer Fachperson helfen kann. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your score is in a range where talking to a health professional may help. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je score valt in een bereik waarbij een gesprek met een zorgverlener kan helpen. Dit is een voorzichtige suggestie, geen diagnose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수가 전문가와 이야기해 보면 도움이 될 수 있는 구간이에요. 진단이 아니라 가벼운 제안이에요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.followUpHint.gad7`, word for word; ko from server v1.47.0 messages `mentalHealth.followUpHint.gad7`, word for word."
    },
    "mentalHealth.followUpHint.phq9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert liegt in einem Bereich, in dem ein Gespräch mit einer Fachperson helfen kann. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your score is in a range where talking to a health professional may help. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je score valt in een bereik waarbij een gesprek met een zorgverlener kan helpen. Dit is een voorzichtige suggestie, geen diagnose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수가 전문가와 이야기해 보면 도움이 될 수 있는 구간이에요. 진단이 아니라 가벼운 제안이에요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.followUpHint.phq9`, word for word; ko from server v1.47.0 messages `mentalHealth.followUpHint.phq9`, word for word."
    },
    "mentalHealth.followUpHint.sci": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Studie zu diesem Fragebogen waren Werte von 16 oder darunter mit wahrscheinlicher Insomnie verbunden. Wenn schlechter Schlaf dich weiter belastet, kann ein Gespräch mit einer Fachperson helfen. Das ist keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the study behind this questionnaire, scores of 16 or below were associated with probable insomnia. If poor sleep keeps troubling you, talking to a health professional may help. This is not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het onderzoek achter deze vragenlijst hingen scores van 16 of lager samen met waarschijnlijke slapeloosheid. Blijf je last houden van slecht slapen, dan kan een gesprek met een zorgverlener helpen. Dit is geen diagnose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설문의 바탕이 된 연구에서는 16점 이하가 불면증 가능성과 관련이 있었어요. 수면 문제가 계속 힘들게 한다면 전문가와 이야기해 보는 게 도움이 될 수 있어요. 진단은 아니에요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.followUpHint.sci`, word for word; ko from server v1.47.0 messages `mentalHealth.followUpHint.sci`, word for word."
    },
    "mentalHealth.followUpHint.who5": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wohlbefindens-Wert von 50 oder darunter kann einen genaueren Blick wert sein. Wenn du magst, schaut der PHQ-9-Check-in auf dieser Seite genauer auf die Stimmung. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A well-being score of 50 or below can be worth a closer look. If you like, the PHQ-9 check-in on this page looks at mood in more depth. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een welzijnsscore van 50 of lager kan het waard zijn om beter naar te kijken. Als je wilt, gaat de PHQ-9-check-in op deze pagina dieper in op je stemming. Dit is een voorzichtige suggestie, geen diagnose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웰빙 점수가 50점 이하라면 좀 더 살펴볼 만해요. 원한다면 이 페이지의 PHQ-9 점검이 기분을 더 자세히 살펴봐요. 진단이 아니라 가벼운 제안이에요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.followUpHint.who5`, word for word; ko from server v1.47.0 messages `mentalHealth.followUpHint.who5`, word for word."
    },
