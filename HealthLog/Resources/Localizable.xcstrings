    "onboarding.sso.onlyNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server meldet dich über den Identitätsanbieter deiner Organisation an. Anmeldung mit Passwort oder Passkey ist hier deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server signs you in through your organisation's identity provider. Password and passkey sign-in are turned off here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server laat je inloggen via de identiteitsprovider van je organisatie. Inloggen met wachtwoord en toegangssleutel is hier uitgeschakeld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
