          "stringUnit": {
            "state": "translated",
            "value": "Magermasse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean body mass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
