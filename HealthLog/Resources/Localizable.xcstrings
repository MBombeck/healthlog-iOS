    "coach.error.reasoningOnly": {
      "comment": "Coach error coach.provider.reasoning_only",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat nur nachgedacht und keine Antwort geschrieben. Versuch es noch einmal oder wähle in den KI-Einstellungen ein anderes Modell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model only reasoned and never wrote an answer. Try again, or choose a different model in your AI settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model heeft alleen nagedacht en geen antwoord geschreven. Probeer het opnieuw of kies een ander model in de AI-instellingen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 생각만 하고 답변을 쓰지 않았어요. 다시 시도하거나 AI 설정에서 다른 모델을 선택해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo solo razonó y no llegó a escribir una respuesta. Inténtalo de nuevo o elige otro modelo en los ajustes de IA."
          }
        }
      }
    },
