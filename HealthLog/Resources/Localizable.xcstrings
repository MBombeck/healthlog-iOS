    "aiprovider.local.help": {
      "comment": "1.4 B2-c: AI provider details, field help for a local Ollama or LM Studio base URL",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: https://ollama.example.com. Dein Server muss diese Adresse öffentlich erreichen, lokale Adressen sind gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: https://ollama.example.com. Your server has to reach this address publicly, local addresses are blocked."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld: https://ollama.example.com. Je server moet dit adres openbaar kunnen bereiken, lokale adressen zijn geblokkeerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: https://ollama.example.com. 서버가 이 주소에 공개적으로 접근할 수 있어야 하며, 로컬 주소는 차단돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: https://ollama.example.com. Tu servidor tiene que poder acceder a esta dirección de forma pública; las direcciones locales están bloqueadas."
          }
        }
      }
    },
