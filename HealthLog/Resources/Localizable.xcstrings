    "insights.healthScore.whatIs.title": {
      "comment": "Heading of the explainer card at the end of the health score detail sheet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist der Gesundheitsscore?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is the health score?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is de gezondheidsscore?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "건강 점수란?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Qué es la puntuación de salud?"
          }
        }
      }
    },
    "insights.healthScore.whatIs.body": {
      "comment": "Explainer in the health score detail sheet: what the composite is made of. The pillar names match the pillar labels used elsewhere in the app.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gesundheitsscore fasst bis zu acht Säulen zusammen: Blutdruck, Blutzucker, Aktivität, Schlaf, Taille, Wohlbefinden, Fitness und Blutfette. Es zählen nur Säulen mit genug Daten. Fehlt eine, bleibt sie draußen und wird nicht geschätzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The health score brings together up to eight pillars: blood pressure, blood sugar, activity, sleep, waist, wellbeing, fitness and blood lipids. Only pillars with enough data count. A missing one is left out, never estimated."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gezondheidsscore bundelt tot acht pijlers: bloeddruk, bloedsuiker, activiteit, slaap, taille, welzijn, fitheid en bloedvetten. Alleen pijlers met genoeg gegevens tellen mee. Ontbreekt er een, dan blijft die buiten beschouwing en wordt niet geschat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "건강 점수는 혈압, 혈당, 활동, 수면, 허리둘레, 웰빙, 체력, 혈중 지질 등 최대 8개 항목을 종합합니다. 데이터가 충분한 항목만 반영됩니다. 빠진 항목은 추정하지 않고 제외합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La puntuación de salud reúne hasta ocho pilares: presión arterial, glucosa en sangre, actividad, sueño, cintura, bienestar, forma física y lípidos en sangre. Solo cuentan los pilares con datos suficientes. Si falta uno, se deja fuera y nunca se estima."
          }
        }
      }
    },
