    "report.selection.noVocabulary": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat keine Auswahlliste geliefert. Ohne sie gibt es nichts, was wir ehrlich anbieten könnten — eine eigene Liste raten wir bewusst nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server served no selection list. Without it there is nothing we could honestly offer — and we deliberately do not invent one."
          }
        }
      }
    },
    "report.selection.notice.dropped": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d gespeicherte Einträge gibt es auf diesem Server nicht mehr und wurden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d saved entries no longer exist on this server and were removed."
