    "onboarding.anamnesis.partialSave": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Einträgen konnten nicht gespeichert werden. Sie stehen noch im Feld. Bitte versuche es erneut oder wähle „Später“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld entries couldn't be saved. They're still in the field. Please try again or choose “Later”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld registraties konden niet worden opgeslagen. Ze staan nog in het veld. Probeer het opnieuw of kies ‘Later’."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 %2$lld개 중 %1$lld개를 저장하지 못했어요. 입력한 내용은 그대로 남아 있어요. 다시 시도하거나 “나중에”를 선택해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar %1$lld de %2$lld registros. Siguen en el campo. Inténtalo de nuevo o elige “Más tarde”."
          }
        }
      }
    },
    "onboarding.anamnesis.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Diese Angaben helfen dem Assistenten, dich besser einzuordnen. Du kannst sie jederzeit in den Einstellungen ändern oder überspringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. This helps the assistant understand your context. You can change or skip it anytime in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Dit helpt de assistent om je situatie te begrijpen. Je kunt het altijd wijzigen of overslaan in Instellingen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 어시스턴트가 내 상황을 이해하는 데 도움이 돼요. 설정에서 언제든 바꾸거나 건너뛸 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Ayuda al asistente a entender tu contexto. Puedes cambiarlo u omitirlo cuando quieras en Ajustes."
          }
        }
      }
    },
