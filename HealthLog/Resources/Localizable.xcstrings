          }
        }
      }
    },
    "onboarding.mode.standalone.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt auf diesem iPhone. Kein Server, kein Konto, sofort loslegen."
          }
        },
        "en": {
