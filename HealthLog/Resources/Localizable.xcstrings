    "mood.tags.manage.group.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld eigener Tag wird in „Eigene Tags“ verschoben. Katalog-Tags kehren in ihre ursprüngliche Gruppe zurück. Einträge bleiben erhalten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld eigene Tags werden in „Eigene Tags“ verschoben. Katalog-Tags kehren in ihre ursprüngliche Gruppe zurück. Einträge bleiben erhalten."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld custom tag will move to Custom. Catalogue tags return to their original group. Entries remain intact."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld custom tags will move to Custom. Catalogue tags return to their original group. Entries remain intact."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld eigen tag wordt verplaatst naar Eigen. Catalogustags gaan terug naar hun oorspronkelijke groep. Registraties blijven behouden."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld eigen tags worden verplaatst naar Eigen. Catalogustags gaan terug naar hun oorspronkelijke groep. Registraties blijven behouden."
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 태그 %lld개는 직접 추가로 옮겨져요. 기본 태그는 원래 그룹으로 돌아가요. 기록은 그대로 남아요."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld etiquetas personalizadas pasarán a Personalizadas. Las etiquetas del catálogo vuelven a su grupo original. Los registros se mantienen intactos."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld etiqueta personalizada pasará a Personalizadas. Las etiquetas del catálogo vuelven a su grupo original. Los registros se mantienen intactos."
                }
              },
