      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Bereich, Score und jede Erklärung in HealthLog ist belegt. Du kannst die Quellen jetzt lesen oder später unter Mehr > Medizinische Quellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every range, score and explanation in HealthLog is cited. You can read the sources now or later under More > Medical sources."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor elk bereik, elke score en elke uitleg in HealthLog wordt de bron vermeld. Je kunt de bronnen nu lezen of later via Meer > Medische bronnen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog의 모든 범위, 점수, 설명에는 출처가 있어요. 출처는 지금 보거나 나중에 더 보기 > 의학 출처에서 볼 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada rango, puntuación y explicación de HealthLog tiene su fuente citada. Puedes leer las fuentes ahora o más tarde en Más > Fuentes médicas."
          }
        }
      }
    },
