    "med.wirkung.autocorrelationCaveat": {
      "comment": "Footnote on a medication effect card when the server flags strong day-to-day carry-over in the readings.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tageswerte hängen stark vom Vortag ab, deshalb ist der Vergleich unsicherer, als er aussieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daily values carry over strongly from one day to the next, so the comparison is less certain than it looks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dagwaarden hangen sterk af van de vorige dag, dus de vergelijking is minder zeker dan ze lijkt."
          }
        }
      }
    },
