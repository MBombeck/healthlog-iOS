    "glp1.pen.delete.confirm.message": {
      "comment": "Message of the confirmation before a GLP-1 pen is deleted.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pen wird aus deinem Bestand entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pen will be removed from your stock. This can't be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pen wordt uit je voorraad verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 펜이 보유 목록에서 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La pluma se eliminará de tus existencias. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "reminders.create.rrule.custom.help": {
      "comment": "Help under the custom recurrence rule field, which sits behind Advanced in the reminder editor.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Abstände, die oben fehlen. Die Regel folgt dem Kalenderstandard iCalendar, zum Beispiel FREQ=MONTHLY;INTERVAL=2 für alle zwei Monate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For intervals the list above doesn't offer. The rule follows the iCalendar calendar standard, for example FREQ=MONTHLY;INTERVAL=2 for every two months."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor intervallen die hierboven ontbreken. De regel volgt de agendastandaard iCalendar, bijvoorbeeld FREQ=MONTHLY;INTERVAL=2 voor elke twee maanden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위 목록에 없는 간격에 쓰세요. 규칙은 iCalendar 달력 표준을 따라요. 예를 들어 두 달마다는 FREQ=MONTHLY;INTERVAL=2예요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para intervalos que la lista de arriba no ofrece. La regla sigue el estándar de calendario iCalendar, por ejemplo FREQ=MONTHLY;INTERVAL=2 para cada dos meses."
          }
        }
      }
    },
    "customMetric.validation.targetNotNumber": {
      "comment": "Inline error when a custom metric target bound holds text that is not a number.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zielwert ist keine Zahl. Lass das Feld leer, wenn du keinen willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target value isn't a number. Leave the field empty if you don't want one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De streefwaarde is geen getal. Laat het veld leeg als je er geen wilt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "목표값이 숫자가 아니에요. 목표값이 필요 없으면 칸을 비워 두세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El valor objetivo no es un número. Deja el campo vacío si no quieres ninguno."
          }
        }
      }
    },
