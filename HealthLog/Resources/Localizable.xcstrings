                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tage"
                    }
                  }
                }
              }
            }
          },
          "stringUnit": {
            "state": "translated",
            "value": "Schlechtester Wert %1$@ über %#@days@."
          }
        },
        "nl": {
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
