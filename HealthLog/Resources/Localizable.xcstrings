    "insights.ecg.disclaimer": {
      "comment": "P8 parity — Insights ECG surface (copy contract, verbatim from the web catalogue insights.ecg.*) — PERMANENT, non-dismissible — REGULATORY: the recording DEVICE's own result, never a HealthLog verdict. Do NOT soften.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das Ergebnis, das dein Aufzeichnungsgerät erstellt hat. HealthLog liest oder interpretiert EKG-Aufzeichnungen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
