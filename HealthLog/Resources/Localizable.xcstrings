    "med.schedule.cadence.asNeeded.explainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erinnerungen oder Zeitplan. Protokolliere einfach jede Dosis bei der Einnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reminders or schedule. Just log each dose when you take it."
          }
