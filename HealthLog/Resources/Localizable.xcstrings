    "customMetric.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metrik verschwindet aus der Liste. Die erfassten Werte bleiben erhalten. Legst du die Metrik unter demselben Namen erneut an, ist der Verlauf wieder da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The metric disappears from the list. Its logged values are kept. Create it again under the same name and the history returns."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meetwaarde verdwijnt uit de lijst. De vastgelegde waarden blijven bewaard. Maak je hem opnieuw aan met dezelfde naam, dan komt de geschiedenis terug."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지표가 목록에서 사라져요. 기록된 값은 유지돼요. 같은 이름으로 다시 만들면 기록이 돌아와요."
