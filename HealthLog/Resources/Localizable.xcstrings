    "settings.applehealth.routes.footer": {
      "comment": "1.5 ROUTES: what switching on and off does. Server v1.47: tracks already stored stay until their workout is deleted.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neue Trainings. Ausschalten stoppt das Senden sofort. Schon gesendete Routen bleiben gespeichert, bis du das Training löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to new workouts. Switching it off stops sending right away. Routes already sent stay stored until you delete the workout."
