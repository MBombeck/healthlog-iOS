    "settings.security.twoFactor.error.notEnrolled": {
      "comment": "2FA — elevation was valid but the account has no second factor enrolled.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Schritt braucht dein Konto einen zweiten Faktor. Richte zuerst eine Authentifizierungs-App ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step needs a second factor on your account. Set up an authenticator app first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze stap heeft je account een tweede factor nodig. Stel eerst een authenticator-app in."
