    "sessions.signOutAll.confirmBody": {
      "comment": "Sessions screen — confirm dialog body. Deliberately does NOT promise “except this device”: the server revokes every refresh token, this one included.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen werden beendet und alle App-Anmeldungen widerrufen. Es kann sein, dass du dich auch auf diesem Gerät neu anmelden musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session ends and every app sign-in is revoked. You may have to sign in again on this device too."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke browsersessie wordt beëindigd en elke login in de app wordt ingetrokken. Mogelijk moet je ook op dit apparaat opnieuw inloggen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 세션이 종료되고 모든 앱 로그인이 해지돼요. 이 기기에서도 다시 로그인해야 할 수 있어요."
          }
        }
      }
    },
    "sessions.signOutAll.confirmTitle": {
      "comment": "Sessions screen — confirm dialog title for sign-out-everywhere",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überall abmelden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out everywhere?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overal uitloggen?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃할까요?"
          }
        }
      }
    },
