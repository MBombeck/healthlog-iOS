        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je selectie bevatte items die deze server niet kent. Ze is opnieuw opgebouwd uit de huidige serverlijst. Controleer haar en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목 중 이 서버가 모르는 항목이 있어서, 현재 서버 목록으로 선택을 다시 구성했어요. 확인한 뒤 다시 시도해 주세요."
          }
        }
      }
