    "control.next_dose_taken.description": {
      "comment": "Next-dose-taken control — gallery description shown when adding the control",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert deine nächste fällige Dosis als genommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks your next due dose as taken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeert je volgende dosis als ingenomen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 복용 예정 약을 복용함으로 표시해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca tu próxima dosis pendiente como tomada."
          }
        }
      }
    },
