    "labs.ocr.processing.slow": {
      "comment": "LAB-OCR: after a minute of reading",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauert gerade länger als üblich. Du kannst warten oder abbrechen und den Bericht auf dem iPhone lesen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is taking longer than usual. You can wait, or cancel and have your iPhone read the report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit duurt langer dan normaal. Je kunt wachten, of stoppen en het rapport op je iPhone laten lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소보다 오래 걸리고 있어요. 기다리거나, 취소하고 iPhone에서 결과지를 읽게 할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está tardando más de lo habitual. Puedes esperar, o cancelar y dejar que tu iPhone lea el informe."
          }
