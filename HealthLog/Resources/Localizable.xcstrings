    "report.selection.notice.rebuilt": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl enthielt Einträge, die dieser Server nicht kennt. Sie wurde aus der aktuellen Serverliste neu aufgebaut. Bitte prüfe sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection contained entries this server does not know. It was rebuilt from the current server list. Please check it and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je selectie bevatte items die deze server niet kent. Ze is opnieuw opgebouwd uit de huidige serverlijst. Controleer haar en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목 중 이 서버가 모르는 항목이 있어서, 현재 서버 목록으로 선택을 다시 구성했어요. 확인한 뒤 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu selección contenía registros que este servidor no conoce. Se ha reconstruido a partir de la lista actual del servidor. Revísala e inténtalo de nuevo."
          }
        }
      }
    },
