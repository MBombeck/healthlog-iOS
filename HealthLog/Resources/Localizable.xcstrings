    "The assistant can also add entries. Only grant this if you actually need it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent kann auch Einträge anlegen. Erlaube das nur, wenn du es wirklich brauchst."
          }
        },
