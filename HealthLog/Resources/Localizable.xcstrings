          "stringUnit": {
            "state": "translated",
            "value": "https:// se añade automáticamente."
          }
        }
      }
    },
    "https:// is added automatically. Self-signed certificates are currently not supported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// wird automatisch ergänzt. Self-Signed-Zertifikate aktuell nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// is added automatically. Self-signed certificates are currently not supported."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// wordt automatisch toegevoegd. Zelfondertekende certificaten worden momenteel niet ondersteund."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https://는 자동으로 붙어요. 자체 서명 인증서는 현재 지원하지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// se añade automáticamente. Por ahora no se admiten certificados autofirmados."
          }
        }
      }
    },
    "iOS asks for this permission only once per install.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS fragt genau einmal pro Installation danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks for this permission only once per install."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS vraagt per installatie maar één keer om deze toestemming."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 이 권한을 설치할 때마다 한 번만 물어봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS solo pide este permiso una vez por instalación."
          }
        }
      }
    },
