    "integration.health.reason.planLimited": {
      "comment": "#139 — health.reason plan_limited.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft, aber dein Tarif beim Anbieter enthält nicht alle Datentypen."
          }
