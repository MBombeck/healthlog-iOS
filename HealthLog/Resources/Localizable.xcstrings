    "onboarding.mfa.recovery.subtitle": {
      "comment": "#37 — subtitle when entering a recovery code instead of a TOTP code.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen der Wiederherstellungscodes ein, die du beim Einrichten der Zwei-Faktor-Authentifizierung gespeichert hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one of the recovery codes you saved when you set up two-factor authentication."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een van de herstelcodes in die je hebt bewaard toen je tweefactorauthenticatie instelde."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2단계 인증을 설정할 때 저장한 복구 코드 중 하나를 입력하세요."
          }
        }
      }
    },
    "onboarding.mfa.rememberDevice": {
      "comment": "MFA challenge sheet — trusted-device opt-in toggle label",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Gerät vertrauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust this device"
