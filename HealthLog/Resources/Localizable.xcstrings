    "labs.ocr.choose.toggle": {
      "comment": "LAB-OCR: switch on the lab scan chooser that sends this scan to the person's HealthLog to be read",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genauer lesen lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read more accurately"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauwkeuriger laten lezen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 정확하게 읽기"
          }
        }
      }
    },
    "labs.ocr.choose.toggleHint": {
      "comment": "LAB-OCR: what goes out when the switch is on (image mode)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto oder PDF geht zum Lesen an dein HealthLog und die dort eingestellte KI und wird danach gelöscht. Gespeichert wird nur, was du prüfst und bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo or PDF goes to your HealthLog and the AI set up there to be read, and is deleted afterwards. Only what you check and confirm is saved."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto of pdf gaat ter lezing naar je HealthLog en de AI die daar is ingesteld, en wordt daarna verwijderd. Alleen wat je controleert en bevestigt, wordt opgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이나 PDF는 읽기를 위해 내 HealthLog와 거기에 설정된 AI로 전송되고, 그 후 삭제돼요. 내가 확인하고 승인한 내용만 저장돼요."
          }
        }
      }
    },
    "labs.ocr.choose.toggleTextHint": {
      "comment": "LAB-OCR: what goes out when the switch is on (text mode)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPhone erkennt den Text, und nur dieser Text geht zum Lesen an dein HealthLog und die dort eingestellte KI. Das Foto bleibt auf deinem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone recognises the text, and only that text goes to your HealthLog and the AI set up there to be read. The photo stays on your iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone herkent de tekst, en alleen die tekst gaat ter lezing naar je HealthLog en de AI die daar is ingesteld. De foto blijft op je iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 텍스트를 인식하고, 그 텍스트만 읽기를 위해 내 HealthLog와 거기에 설정된 AI로 전송돼요. 사진은 iPhone에 남아요."
          }
        }
      }
    },
    "labs.ocr.choose.body": {
      "comment": "LAB-OCR: chooser body while the read more accurately switch is on",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere einen Laborbericht, um mehrere Werte auf einmal zu erfassen. Du prüfst jeden Wert, bevor etwas gespeichert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a lab report to record several readings at once. You check every reading before anything is saved."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer een labrapport om meerdere waarden tegelijk vast te leggen. Je controleert elke waarde voordat er iets wordt opgeslagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사 결과지를 촬영해 여러 측정값을 한 번에 기록하세요. 저장하기 전에 모든 측정값을 직접 확인해요."
          }
        }
      }
    },
    "labs.ocr.choose.pdf": {
