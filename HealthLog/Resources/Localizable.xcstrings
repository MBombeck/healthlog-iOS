    "sleep.chronotype.learning %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Rhythmus wird noch erfasst: %1$lld von %2$lld freien Nächten. Ein Chronotyp braucht ein paar weckerfreie Morgen, um aussagekräftig zu sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still learning your rhythm: %1$lld of %2$lld free nights. A chronotype needs a few alarm-free mornings before it means anything."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ritme wordt nog in kaart gebracht: %1$lld van %2$lld vrije nachten. Voor een betrouwbaar chronotype zijn een paar ochtenden zonder wekker nodig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리듬을 파악하는 중이에요: 쉬는 날 밤 %2$lld일 중 %1$lld일. 크로노타입은 알람 없이 일어난 아침이 며칠 쌓여야 의미가 있어요."
          }
        }
      }
    },
