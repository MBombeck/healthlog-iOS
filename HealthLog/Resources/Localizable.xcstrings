    "insights.intraday.tension.afternoon": {
      "comment": "P7 parity — Insights pulse page intraday day curve (mirrors web insights.intradayPulse.*) — DESCRIPTIVE observation, never a diagnosis",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine anhaltend erhöhte Ruhephase heute Nachmittag, möglicherweise etwas Anspannung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sustained elevated-at-rest stretch this afternoon, possibly some tension."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanmiddag een langere periode met verhoogde hartslag in rust, mogelijk wat spanning."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 오후 안정 시 심박수가 높은 상태가 한동안 이어졌어요. 긴장했을 수도 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tramo elevado en reposo esta tarde; posiblemente algo de tensión."
          }
        }
      }
    },
