    "onboarding.mfa.rememberDevice.caption": {
      "comment": "MFA challenge sheet — trusted-device caption. States the real 30-day window because this opts out of the second factor.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "30 Tage lang wird auf diesem Gerät kein zweiter Faktor mehr abgefragt. Nur auf Geräten aktivieren, die dir gehören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 30 days this device will not ask for a second factor. Only turn this on for devices you own."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat vraagt 30 dagen lang niet om een tweede factor. Schakel dit alleen in op apparaten die van jou zijn."
          }
        }
      }
    },
