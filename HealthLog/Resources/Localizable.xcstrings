    "settings.cycle.purge.confirm.message": {
      "comment": "Cycle purge — confirmation dialog message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Perioden, Tageseinträge, Prognosen und eigenen Symptome von deinem Server. Daten in Apple Health bleiben unberührt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes every period, day log, prediction, and custom symptom from your server. Data in Apple Health is not affected. This cannot be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert alle menstruaties, dagregistraties, voorspellingen en eigen symptomen van je server. Gegevens in Apple Health blijven ongewijzigd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 생리 기간, 일별 기록, 예측, 사용자 지정 증상이 서버에서 삭제돼요. Apple Health의 데이터에는 영향이 없어요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de tu servidor todos los periodos de regla, registros diarios, predicciones y síntomas personalizados. Los datos de Apple Health no se ven afectados. No se puede deshacer."
          }
        }
      }
    },
