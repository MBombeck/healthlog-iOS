    "med.schedule.cadence.asNeeded.explainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erinnerungen oder Zeitplan. Protokolliere einfach jede Dosis bei der Einnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reminders or schedule. Just log each dose when you take it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen herinneringen of schema. Leg elke dosis gewoon vast wanneer je die inneemt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이나 일정이 없어요. 복용할 때마다 기록만 하면 돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin recordatorios ni horario. Solo registra cada dosis cuando la tomes."
          }
        }
      }
    },
