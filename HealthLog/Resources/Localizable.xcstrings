    "An HRV-derived read of physiological load — how taxed your nervous system looks compared with your calm baseline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aus der HRV abgeleiteter Wert für die körperliche Belastung: wie beansprucht dein Nervensystem im Vergleich zu deinem ruhigen Normalwert wirkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An HRV-derived read of physiological load: how taxed your nervous system looks compared with your calm baseline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van de HRV afgeleide inschatting van fysiologische belasting: hoe zwaar je zenuwstelsel belast lijkt vergeleken met je rustige basiswaarde."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV로 추정한 생리적 부하: 평온할 때의 기준선과 비교해 신경계가 얼마나 지쳐 보이는지 나타내요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lectura de la carga fisiológica derivada de la VFC: cuánto parece exigido tu sistema nervioso en comparación con tu nivel basal en calma."
          }
        }
      }
    },
