            "value": "Google hat die Fitbit-Anbindung am %@ abgeschaltet. Über diese Verbindung kommen keine Daten mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google turned the Fitbit connection off on %@. This connection no longer syncs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Google heeft de Fitbit-koppeling op %@ uitgeschakeld. Deze verbinding synchroniseert niet meer."
