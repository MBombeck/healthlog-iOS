    "settings.support.info.registration": {
      "comment": "1.4 B2-c: Support details info sheet, APNs registration section",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wann sich dieses Gerät zuletzt bei deinem Server für Mitteilungen angemeldet hat. Anfang und Ende des Tokens reichen, um den Eintrag im Server-Log zu finden, der ganze Token wird nie gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when this device last registered with your server for notifications. The start and end of the token are enough to find the entry in the server log, the full token is never stored."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont wanneer dit apparaat zich voor het laatst bij je server heeft aangemeld voor meldingen. Het begin en eind van het token zijn genoeg om de regel in het serverlog te vinden, het hele token wordt nooit bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 알림을 받으려고 서버에 마지막으로 등록한 시각이에요. 토큰의 앞뒤 일부만으로 서버 로그에서 해당 항목을 찾을 수 있으며, 전체 토큰은 저장하지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuándo se registró este dispositivo por última vez en tu servidor para las notificaciones. El inicio y el final del token bastan para encontrar el registro en el log del servidor; el token completo nunca se guarda."
          }
        }
      }
    },
