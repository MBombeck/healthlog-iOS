      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbelegt mit der geplanten Dosis. Ändere sie nur, wenn du eine andere Menge genommen hast."
          }
        },
        "en": {
          "stringUnit": {
