    "labs.scan.error.noRows": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Laborwerte erkannt. Versuche ein klareres Foto oder gib die Werte manuell ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lab readings detected. Try a clearer photo or enter the values manually."
