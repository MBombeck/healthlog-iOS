        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt hoeveel de AI op de achtergrond doet: statuskaarten, de dagelijkse briefing, documenten lezen. De Coach valt hier niet onder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 백그라운드에서 얼마나 작업할지 정해요: 상태 카드, 일일 브리핑, 문서 읽기. 코치에는 영향을 주지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cuánto trabaja la IA en segundo plano: tarjetas de estado, el resumen del día, lectura de documentos. El Coach no se ve afectado."
          }
        }
      }
    },
