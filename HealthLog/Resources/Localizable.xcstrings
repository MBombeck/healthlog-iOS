    "settings.mcp.scope.body": {
      "comment": "1.4 B2-c: MCP screen, body of the card What an assistant can see",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Messwerte, Laborwerte und Medikamente, nur lesend, solange du nicht ausdrücklich mehr erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your measurements, labs and medications, read-only unless you explicitly allow more."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je metingen, labwaarden en medicatie, alleen lezen, tenzij je uitdrukkelijk meer toestaat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값, 검사 결과, 약 정보예요. 직접 더 허용하지 않는 한 읽기 전용이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus mediciones, valores de laboratorio y medicamentos, solo lectura a menos que permitas más de forma explícita."
          }
        }
      }
    },
