    "mentalHealth.instrumentDescription.sci": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Fragen beziehen sich auf den letzten Monat; höhere Werte bedeuten besseren Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most questions ask about the past month; higher scores mean better sleep."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste vragen gaan over de afgelopen maand; hogere scores betekenen een betere slaap."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8문항 수면 점검이에요. 대부분 지난 한 달을 묻고, 점수가 높을수록 수면이 좋아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La mayoría de las preguntas se refieren al último mes; una puntuación más alta significa mejor sueño."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.instrumentDescription.sci` (one sentence of it), word for word."
    },
    "mentalHealth.instrumentDescription.who5": {
