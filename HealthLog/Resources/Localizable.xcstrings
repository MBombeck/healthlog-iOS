    "healthkit.newTypes.body %@": {
      "comment": "HK-NEW (1.5) — body of the new-types card; %@ is a list of data type names (e.g. 'Exercise Minutes, Stand Hours and AFib Burden').",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kann jetzt auch %@ aus Apple Health lesen. Apple Health fragt dich danach einmal, was du freigibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog can now also read %@ from Apple Health. Apple Health then asks you once what to share."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog kan nu ook %@ uit Apple Health lezen. Apple Health vraagt je daarna één keer wat je deelt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 HealthLog가 Apple Health에서 %@ 데이터도 읽을 수 있어요. 그다음 Apple Health에서 무엇을 공유할지 한 번 물어봐요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog ahora también puede leer %@ de Apple Health. Apple Health te preguntará una vez qué quieres compartir."
          }
        }
      }
    },
