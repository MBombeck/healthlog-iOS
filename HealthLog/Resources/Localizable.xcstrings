      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, belegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, confirmed"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, bevestigd"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
