    "settings.coach.window.description": {
      "comment": "#126 P2 the window is a real limit server-side.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach nutzt in jeder Antwort nur Daten aus diesem Zeitraum. Ältere Werte bleiben gespeichert, sie liegen nur außerhalb seiner Reichweite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Coach only uses data from this period, in every answer. Older readings stay saved, they are just out of its reach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach gebruikt in elk antwoord alleen gegevens uit deze periode. Oudere waarden blijven bewaard, ze liggen alleen buiten zijn bereik."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치는 모든 답변에서 이 기간의 데이터만 사용해요. 이전 측정값은 그대로 저장되어 있고, 코치가 참조하지 않을 뿐이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Coach solo usa datos de este periodo, en todas sus respuestas. Las mediciones más antiguas siguen guardadas, solo quedan fuera de su alcance."
          }
        }
      }
    },
