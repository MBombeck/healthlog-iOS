        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading documents is busy right now. Try again in a minute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lezen van documenten is nu druk bezet. Probeer het over een minuut opnieuw."
          }
        }
      }
    },
    "documents.read.outputLimit": {
      "comment": "A document read stopped at its length limit before any complete value came back.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
