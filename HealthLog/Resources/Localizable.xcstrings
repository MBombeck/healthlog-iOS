    "onboarding.permission.notifications.declined": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind aus. Ohne sie gibt es keine Medikamenten-Erinnerungen und keine Hinweise auf auffällige Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Without them there are no medication reminders and no alerts about unusual values."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit. Zonder meldingen krijg je geen medicijnherinneringen en geen waarschuwingen over afwijkende waarden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어요. 알림이 없으면 복약 알림도, 비정상 값에 대한 알림도 받을 수 없어요."
          }
        }
      }
    },
