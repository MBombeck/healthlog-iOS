    "med.edit.autoMarkTaken.helper": {
      "comment": "MED-PLUS: switch description, one sentence",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede geplante Dosis gilt zu ihrer Uhrzeit als genommen, ohne Erinnerung, und was du selbst einträgst, hat immer Vorrang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each scheduled dose counts as taken at its time, without a reminder, and anything you log yourself always comes first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke geplande dosis telt op het geplande tijdstip als ingenomen, zonder herinnering, en wat je zelf vastlegt, gaat altijd voor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 각 복용은 알림 없이 해당 시간에 복용한 것으로 기록되고, 직접 기록한 내용이 항상 우선해요."
          }
        }
      }
    },
