    "auth.passkey.error.rejected": {
      "comment": "Sign-in — the server refused the passkey assertion (401/404/422 on /api/auth/passkey/login-verify). Not an expired session.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat diesen Passkey nicht angenommen. Falls du ihn aus deinem Konto entfernt hast, melde dich stattdessen mit deinem Passwort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't accept this passkey. If you removed it from your account, sign in with your password instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft deze toegangssleutel niet geaccepteerd. Als je hem uit je account hebt verwijderd, log dan in met je wachtwoord."
          }
        }
      }
    },
    "auth.passkey.error.ssoOnly": {
      "comment": "Sign-in — 403 oidc_only on a passkey leg",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Passkey ist auf diesem Server abgeschaltet. Melde dich stattdessen per SSO an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey sign-in is turned off on this server. Sign in with SSO instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met een toegangssleutel is uitgeschakeld op deze server. Log in plaats daarvan in met SSO."
          }
        }
      }
    },
