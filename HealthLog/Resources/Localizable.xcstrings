    "onboarding.welcome.feature.selfhosted.subtitle": {
      "comment": "v0.12 W7-2 — reframed mode-agnostic: holds for BOTH local-only and your-own-server. The old copy ('your data lives on your server') contradicted the standalone option offered on the very next step.",
