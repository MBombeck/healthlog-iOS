    "documents.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre Arztbriefe, Laborbefunde, Bildgebung, Rezepte und Impfnachweise auf: verschlüsselt und durchsuchbar nach Typ, Erkrankung und Jahr."
          }
        },
        "en": {
          "stringUnit": {
