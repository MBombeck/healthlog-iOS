    "settings.security.twoFactor.recovery.regenerateBody": {
      "comment": "2FA management — regenerate recovery codes explanation.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Codes machen alle bisherigen ungültig. Bewahre sie sicher auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New codes invalidate all previous ones. Keep them somewhere safe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe codes maken alle eerdere codes ongeldig. Bewaar ze op een veilige plek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 코드를 발급하면 이전 코드는 모두 무효가 돼요. 안전한 곳에 보관하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos códigos invalidan todos los anteriores. Guárdalos en un lugar seguro."
          }
        }
      }
    },
    "settings.security.twoFactor.recovery.saveBody": {
      "comment": "2FA recovery codes — save prompt body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Code funktioniert einmal, falls du keinen Zugriff auf deine Authentifizierungs-App hast. Sie werden nur dieses eine Mal angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each code works once if you lose access to your authenticator app. They are shown only this once."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke code werkt één keer als je geen toegang meer hebt tot je authenticator-app. Ze worden alleen deze ene keer getoond."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱에 접근할 수 없을 때 각 코드를 한 번씩 쓸 수 있어요. 코드는 지금 한 번만 표시돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada código funciona una vez si pierdes el acceso a tu app de autenticación. Solo se muestran esta vez."
          }
        }
      }
    },
    "settings.security.twoFactor.recovery.saveTitle": {
      "comment": "2FA recovery codes — save prompt title.",
      "extractionState": "manual",
      "localizations": {
