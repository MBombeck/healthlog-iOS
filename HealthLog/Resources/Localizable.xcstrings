    "How much physical load you put on your body today, from your activity and elevated heart rate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel körperliche Belastung du deinem Körper heute zugemutet hast, gemessen an Aktivität und erhöhtem Puls."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much physical load you put on your body today, from your activity and elevated heart rate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel fysieke belasting je je lichaam vandaag hebt gegeven, op basis van je activiteit en verhoogde hartslag."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 활동과 높아진 심박수를 바탕으로 몸에 얼마나 많은 신체 부하가 가해졌는지 보여 줘요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánta carga física has puesto hoy en tu cuerpo, según tu actividad y tu frecuencia cardíaca elevada."
          }
        }
      }
    },
    "How ready your body looks for the day, blended from your resting heart rate, HRV and sleep.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bereit dein Körper für den Tag wirkt, zusammengefasst aus Ruhepuls, HRV und Schlaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How ready your body looks for the day, blended from your resting heart rate, HRV and sleep."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe klaar je lichaam lijkt voor de dag, samengesteld uit je rusthartslag, HRV en slaap."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안정 시 심박수, 심박변이도, 수면을 종합해 오늘 몸이 얼마나 준비된 것으로 보이는지 보여 줘요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo preparado que parece tu cuerpo para el día, combinando tu frecuencia cardíaca en reposo, tu VFC y tu sueño."
          }
        }
      }
    },
    "How this is measured": {
      "comment": "v0.14.3 F5 — wellness-score detail (STRAIN/provenance) section heading",
