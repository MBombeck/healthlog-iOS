    "onboarding.welcome.serverRequired": {
      "comment": "v0.12 W7-2 — Welcome-screen orientation paragraph. Rewritten: the next step is the connect-or-standalone CHOICE (ModeSelectionStep), NOT a server-address prompt. The old copy promised 'enter your server address next' and contradicted the very next screen's 'use without an account' option.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleich verbindest du HealthLog mit deinem eigenen Server. Er treibt Sync, den Assistenten, deinen Health Score und den Gesundheitsbericht. Deine Gesundheitsdaten bleiben unter deiner Kontrolle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, connect HealthLog to your own server. It powers sync, the assistant, your Health Score and the doctor report. Your health data stays under your control."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierna koppel je HealthLog aan je eigen server. Die zorgt voor synchronisatie, de assistent, je Gezondheidsscore en het artsenrapport. Je gezondheidsgegevens blijven onder jouw controle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 HealthLog를 내 서버에 연결하세요. 서버가 동기화, 어시스턴트, 건강 점수, 진료용 리포트를 지원해요. 건강 데이터는 내가 관리해요."
          }
        }
      }
    },
