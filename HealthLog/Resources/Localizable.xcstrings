          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused because it is not proven that this data belongs to your account. The next app start checks again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd omdat niet vaststaat dat deze gegevens bij je account horen. De volgende start van de app controleert dit opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터가 내 계정에 속한다는 것이 확인되지 않아 일시 중지되었습니다. 다음에 앱을 시작할 때 다시 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa porque no está comprobado que estos datos pertenezcan a tu cuenta. El próximo inicio de la app lo vuelve a comprobar."
          }
        }
      }
    },
