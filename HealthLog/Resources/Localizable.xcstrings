            "value": "Understood, continue"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrepen, doorgaan"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이해했어요, 계속"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido, continuar"
          }
        }
      }
    },
