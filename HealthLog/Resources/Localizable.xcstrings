    "mentalHealth.instrumentDescription.gad7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe dich auf die letzten zwei Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer for the last two weeks."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord ze voor de afgelopen twee weken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7문항 불안 선별 검사예요. 지난 2주를 기준으로 답해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Responde pensando en las últimas dos semanas."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.instrumentDescription.gad7` (one sentence of it), word for word."
    },
