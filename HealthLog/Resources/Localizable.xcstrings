    "life.auditC.legacy.hint": {
      "comment": "POLISH-C C7, server records.life.auditC.legacyHint.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der kurzen Alkoholfrage vor diesem Fragebogen. Sobald ein Fragebogen-Ergebnis vorliegt, liest der Coach sie nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the short alcohol question asked before this questionnaire. Once a questionnaire result is on file, the Coach no longer reads it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van de korte alcoholvraag die vóór deze vragenlijst werd gesteld. Zodra er een vragenlijstresultaat is opgeslagen, leest de Coach dit niet meer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설문 전에 묻던 짧은 음주 질문의 답변이에요. 설문 결과가 있으면 코치는 더 이상 이 답변을 읽지 않아요."
          }
        }
      }
    },
