          "stringUnit": {
            "state": "translated",
            "value": "Dein %1$@-Wert von %2$@ liegt über dem von dir festgelegten Bereich (%3$@)."
          }
        }
      }
    },
    "threshold.nudge.body.below %@ %@ %@": {
      "comment": "W-THRESHOLD-NUDGE — factual out-of-range body (below). %1$@ analyte, %2$@ value+unit, %3$@ range. NON-diagnostic: states a fact only, no advice/diagnosis/reassurance.",
