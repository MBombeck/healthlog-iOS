    "Record a health measurement (weight, pulse, temperature and more) in HealthLog.": {
      "comment": "AppIntents — description of the Log a measurement intent in Shortcuts",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einen Messwert (Gewicht, Puls, Temperatur und mehr) in HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a health measurement (weight, pulse, temperature and more) in HealthLog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg een meting (gewicht, hartslag, temperatuur en meer) vast in HealthLog."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HealthLog에 측정값(체중, 맥박, 체온 등)을 기록해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registra una medición de salud (peso, pulso, temperatura y más) en HealthLog."
          }
        }
      }
    },
    "Which measurement to log.": {
      "comment": "AppIntents — description of the measurement parameter of the Log a measurement intent",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcher Messwert erfasst wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which measurement to log."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke meting je vastlegt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기록할 측정 항목이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Qué medición registrar."
          }
        }
      }
    },
    "The measured value, in your account's unit (weight, temperature and blood glucose follow your unit settings).": {
      "comment": "AppIntents — description of the value parameter of the Log a measurement intent",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemessene Wert in der Einheit deines Kontos (Gewicht, Temperatur und Blutzucker folgen deinen Einheiten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The measured value, in your account's unit (weight, temperature and blood glucose follow your unit settings)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemeten waarde in de eenheid van je account (gewicht, temperatuur en bloedglucose volgen je eenheden)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "측정한 값이에요. 계정의 단위로 입력해요(체중, 체온, 혈당은 단위 설정을 따라요)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El valor medido, en la unidad de tu cuenta (el peso, la temperatura y la glucosa en sangre siguen tus ajustes de unidades)."
          }
        }
      }
    },
