    "settings.support.info.categories.v2": {
      "comment": "Support diagnostics: what the notification categories row means",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktionen, die iOS an einer Mitteilung zeigt. Fehlt MEDICATION_REMINDER, fehlen auch die Knöpfe „Einnehmen“, „Später erinnern“ und „Überspringen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The actions iOS shows on a notification. If MEDICATION_REMINDER is missing, the Take, Remind me later and Skip buttons are missing too."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De acties die iOS bij een melding toont. Ontbreekt MEDICATION_REMINDER, dan ontbreken ook de knoppen Innemen, Later herinneren en Overslaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 알림에 보여 주는 동작이에요. MEDICATION_REMINDER가 없으면 복용, 나중에 알림, 건너뛰기 버튼도 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones que iOS muestra en una notificación. Si falta MEDICATION_REMINDER, también faltan los botones Tomar, Recordar más tarde y Omitir."
          }
        }
      }
    },
