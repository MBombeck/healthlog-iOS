    "Days with a high intake rate tended to be followed by lower blood pressure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagen mit hoher Einnahme-Quote folgte tendenziell niedrigerer Blutdruck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days with a high intake rate tended to be followed by lower blood pressure."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dagen met een hoge inname volgde meestal een lagere bloeddruk."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용률이 높은 날 다음에는 혈압이 낮아지는 경향이 있었어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con una tasa de toma alta solían ir seguidos de una presión arterial más baja."
          }
        }
      }
    },
    "Days with a high intake rate were followed by markedly lower blood pressure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagen mit hoher Einnahme-Quote folgte deutlich niedrigerer Blutdruck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days with a high intake rate were followed by markedly lower blood pressure."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dagen met een hoge inname volgde een duidelijk lagere bloeddruk."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용률이 높은 날 다음에는 혈압이 뚜렷하게 낮았어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días con una tasa de toma alta fueron seguidos de una presión arterial claramente más baja."
          }
        }
      }
    },
