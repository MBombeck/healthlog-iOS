    "appstore.disclaimer.consult_doctor": {
      "comment": "v0.7.0 W-APPSTORE — disclaimer: consult a doctor.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Triff keine gesundheitlichen Entscheidungen allein auf Basis dieser App. Bei Beschwerden oder Fragen zu deinen Werten wende dich an eine Ärztin oder einen Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not make health decisions based on this app alone. If you have symptoms or questions about your values, consult a physician."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem geen beslissingen over je gezondheid op basis van alleen deze app. Heb je klachten of vragen over je waarden, raadpleeg dan een arts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱만으로 건강 관련 결정을 내리지 마세요. 증상이 있거나 수치에 대해 궁금한 점이 있으면 의사와 상담하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No tomes decisiones de salud basándote solo en esta app. Si tienes síntomas o dudas sobre tus valores, consulta a un médico."
          }
        }
      }
    },
    "appstore.disclaimer.footer": {
      "comment": "v0.7.0 W-APPSTORE — disclaimer card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Notfall wähle den lokalen Notruf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In an emergency, call your local emergency number."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel in een noodgeval het lokale alarmnummer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응급 상황에서는 지역 응급 번호로 전화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En caso de emergencia, llama al número de emergencias local."
          }
        }
      }
    },
    "appstore.disclaimer.methodology": {
      "comment": "v0.7.0 W-APPSTORE — disclaimer: methodology disclosure.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends, Insights und Coach-Antworten basieren auf deinen erfassten und aus Apple Health gelesenen Werten. Sie sind beschreibende Zusammenfassungen (keine ärztliche Beurteilung) und können durch Mess- oder Eingabefehler ungenau sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends, insights, and coach responses are derived from the values you record and read from Apple Health. They are descriptive summaries (not a medical assessment) and may be inaccurate due to measurement or input errors."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trends, inzichten en antwoorden van de coach zijn afgeleid van de waarden die je vastlegt en die uit Apple Health worden gelezen. Het zijn beschrijvende samenvattingen (geen medische beoordeling) en ze kunnen onnauwkeurig zijn door meet- of invoerfouten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추세, 인사이트, 코치 답변은 내가 기록한 값과 Apple Health에서 읽어 온 값을 바탕으로 만들어져요. 이는 설명용 요약(의학적 평가 아님)이며, 측정이나 입력 오류로 인해 정확하지 않을 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las tendencias, la información y las respuestas del Coach se basan en los valores que registras y que se leen de Apple Health. Son resúmenes descriptivos (no una evaluación médica) y pueden ser inexactos debido a errores de medición o de introducción."
          }
        }
      }
    },
    "appstore.disclaimer.not_for_diagnosis": {
      "comment": "v0.7.0 W-APPSTORE — disclaimer: not for diagnosis.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog ist nicht für die Diagnose, Behandlung oder Vorbeugung von Krankheiten bestimmt. Die App ersetzt keine medizinische Untersuchung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog is not intended to diagnose, treat, or prevent any disease. The app is not a substitute for a medical examination."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog is niet bedoeld om ziekten te diagnosticeren, te behandelen of te voorkomen. De app is geen vervanging voor medisch onderzoek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog는 질병을 진단, 치료, 예방하기 위한 앱이 아니에요. 이 앱은 의학적 진찰을 대신하지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HealthLog no está pensada para diagnosticar, tratar ni prevenir ninguna enfermedad. La app no sustituye a un examen médico."
          }
        }
      }
    },
