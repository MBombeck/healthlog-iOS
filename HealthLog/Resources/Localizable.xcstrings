    "cycle.learning.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine Periode und Symptome über ein paar Zyklen, dann zeigt dir HealthLog deine Phasen und sagt voraus, was bevorsteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log your period and any symptoms over a few cycles, and HealthLog will start showing your phases and predicting what's ahead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer je menstruatie en eventuele symptomen gedurende een paar cycli, dan laat HealthLog je fasen zien en voorspelt wat er komt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 번의 주기 동안 생리와 증상을 기록하면 HealthLog가 주기 단계를 보여 주고 앞으로의 일정을 예측하기 시작해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu regla y tus síntomas durante algunos ciclos, y HealthLog empezará a mostrarte tus fases y a predecir lo que viene."
          }
        }
      }
    },
