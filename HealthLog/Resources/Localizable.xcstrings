    "stepUp.record.securityKeyOnly": {
      "comment": "POLISH-C C1: step-up sheet, account whose only proof is a security key (browser-only).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist mit einem Sicherheitsschlüssel geschützt. Den kann die App nicht abfragen, das geht im Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is protected with a security key. The app can't ask for it, but the browser can."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is beveiligd met een beveiligingssleutel. De app kan daar niet om vragen, de browser wel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 보안 키로 보호되어 있어요. 앱에서는 보안 키를 요청할 수 없지만 브라우저에서는 할 수 있어요."
          }
        }
      }
    },
    "life.auditC.legacy.label %@": {
