    "settings.hkdiag.skipped_reason_out_of_range_detail %@ %@ %@": {
      "comment": "Sync diagnostics, refused reading: the value after the unit conversion, then the lower and upper edge of the allowed band, each with its unit.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgerechnet %1$@, erlaubt sind %2$@ bis %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converted to %1$@, allowed %2$@ to %3$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgerekend %1$@, toegestaan is %2$@ tot %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환값 %1$@, 허용 범위 %2$@~%3$@"
          }
        }
      }
    },
    "settings.hkdiag.skipped_reason_out_of_range_band %@ %@": {
      "comment": "Sync diagnostics, refused reading: lower and upper edge of the allowed band, each with its unit.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außerhalb des Bereichs %1$@ bis %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outside the range %1$@ to %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buiten het bereik %1$@ tot %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@~%2$@ 범위를 벗어남"
          }
        }
      }
    },
    "settings.hkdiag.skipped_reason_out_of_range_value %@": {
      "comment": "Sync diagnostics, refused reading: the value after the unit conversion; no band was given.",
