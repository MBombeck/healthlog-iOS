    "focus.filter.card.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge HealthLog in den iOS-Einstellungen → Fokus als Filter zu einem beliebigen Fokus (Schlaf, Arbeit …) hinzu. Solange dieser Fokus aktiv ist, hält HealthLog Routine-Erinnerungen zurück – Medikamenten-Backups, den Stimmungs-Hinweis, Vorsorge-Erinnerungen, Nachschub-Hinweise – und optional Coach-Hinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add HealthLog as a filter to any Focus (Sleep, Work …) in iOS Settings → Focus. While that Focus is on, HealthLog holds back routine reminders — medication backups, the mood nudge, preventive-care reminders, low-supply heads-ups — and optionally coach nudges."
          }
        }
      }
    },
    "focus.filter.card.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dringende Gesundheitswarnungen – kritische Medikamenten-Alarme und „Arzt aufsuchen“-Eskalationen – werden von einem Fokus-Filter nie zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Urgent health alerts — critical medication alarms and “seek care” escalations — are never held back by a Focus filter."
          }
        }
      }
    },
    "focus.filter.card.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Filter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus filter"
          }
        }
      }
    },
    "focus.filter.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dieser Fokus aktiv ist, hält HealthLog Routine-Erinnerungen und Coach-Hinweise zurück – dringende Gesundheitswarnungen kommen weiterhin durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this Focus is on, HealthLog holds back routine reminders and coach nudges — urgent health alerts still come through."
          }
        }
      }
    },
    "focus.filter.param.pauseCoach.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Coach-Hinweise pausieren"
