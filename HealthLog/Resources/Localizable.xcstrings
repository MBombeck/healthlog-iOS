              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Der Tag wird aus %lld bisherigen Einträgen entfernt. Das lässt sich nicht rückgängig machen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This removes the tag from %lld past entry. This cannot be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This removes the tag from %lld past entries. This cannot be undone."
