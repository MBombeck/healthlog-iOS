          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the document was not read in full, so some values may be missing. Check them against the document."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van het document is niet volledig gelezen, dus er kunnen waarden ontbreken. Vergelijk ze met het document."
          }
        }
      }
    },
    "documents.read.readerBusy": {
      "comment": "The document reader is busy (too many reads queued). Nothing was read.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
