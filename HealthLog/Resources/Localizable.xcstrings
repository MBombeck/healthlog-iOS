    "nightscout.formIntro": {
      "comment": "Nightscout connect form intro.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die URL deiner Nightscout-Instanz und, falls erforderlich, einen API-Token ein. Sie werden verschlüsselt auf deinem Server gespeichert, nie auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Nightscout instance URL and, if it requires one, an API token. They are stored encrypted on your server and never on this iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de URL van je Nightscout-instantie in en, als die erom vraagt, een API-token. Ze worden versleuteld op je server bewaard en nooit op deze iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightscout 인스턴스 URL과, 필요하다면 API 토큰을 입력하세요. 이 정보는 서버에 암호화되어 저장되며 이 iPhone에는 저장되지 않아요."
          }
        }
      }
