          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer for the last two weeks; higher numbers mean better well-being."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord ze voor de afgelopen twee weken; hogere getallen betekenen een beter welzijn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5문항 웰빙 점검이에요. 지난 2주를 기준으로 답해 주세요. 숫자가 클수록 웰빙이 좋아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
