            "state": "translated",
            "value": "Call your local emergency number now."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel nu je lokale alarmnummer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 현지 응급 번호로 전화하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama ahora a tu número local de emergencias."
          }
        }
      }
    },
