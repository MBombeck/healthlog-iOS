    "That couldn’t be saved just now — nothing was changed.": {
      "comment": "Correlation dismissal — the optimistic change was rolled back",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ließ sich gerade nicht speichern. Es wurde nichts geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That couldn’t be saved just now. Nothing was changed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat kon nu niet worden bewaard. Er is niets gewijzigd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 저장할 수 없었어요. 아무것도 변경되지 않았어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar ahora mismo. No se ha cambiado nada."
          }
        }
      }
    },
    "That key was rejected. Check it and try again.": {
      "localizations": {
        "de": {
