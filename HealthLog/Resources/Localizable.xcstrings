                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dagen"
                    }
                  }
                }
              }
            }
          },
          "stringUnit": {
            "state": "translated",
            "value": "Slechtste waarde %1$@ over %#@days@."
          }
