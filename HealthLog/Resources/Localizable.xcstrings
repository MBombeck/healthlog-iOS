    "Five devices of this account already use the relay. HealthLog turned it off on this device; reminders work as before.": {
      "comment": "#191 Settings line after POST /api/devices answered devices.push.relay_device_limit (five relay devices per account).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Geräte dieses Kontos nutzen das Relay schon. HealthLog hat es auf diesem Gerät ausgeschaltet; Erinnerungen funktionieren wie bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five devices of this account already use the relay. HealthLog turned it off on this device; reminders work as before."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf apparaten van dit account gebruiken de relay al. HealthLog heeft hem op dit apparaat uitgeschakeld; herinneringen werken zoals voorheen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 기기 다섯 대가 이미 릴레이를 사용 중입니다. HealthLog가 이 기기에서 릴레이를 껐으며, 알림은 이전처럼 작동합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco dispositivos de esta cuenta ya usan el relay. HealthLog lo desactivó en este dispositivo; los recordatorios funcionan como antes."
          }
        }
      }
    },
