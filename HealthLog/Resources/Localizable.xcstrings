    "anamnesis.action.remove": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Closes the current revision without recording a successor.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angabe entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove entry"
          }
        }
      }
    },
    "anamnesis.error.conflict": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 anamnesis.fact.conflict — a concurrent write closed the row between the guard and the update.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angabe wurde zwischenzeitlich an anderer Stelle geändert. Wir haben den aktuellen Stand neu geladen — prüfe ihn und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry changed elsewhere in the meantime. We reloaded the current state — check it and try again."
          }
        }
      }
    },
    "anamnesis.error.currentExists": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 anamnesis.fact.currentExists — a current value already exists, so PATCH is the right verb.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Angabe gibt es bereits einen aktuellen Wert. Wir haben neu geladen — korrigiere ihn, statt ihn neu anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry already has a current value. We reloaded — correct it instead of creating a new one."
          }
        }
      }
    },
    "anamnesis.error.dismiss": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Accessibility label of the write-error banner's close button.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldung ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss message"
          }
        }
      }
    },
    "anamnesis.error.inFlight": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 from the idempotency wrapper (the one whose `error` is an object, not a string).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Angabe läuft bereits eine Anfrage. Warte einen Moment und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request for this entry is already running. Wait a moment and try again."
          }
        }
      }
    },
    "anamnesis.error.invalidValue": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 422 anamnesis.fact.invalidValue — the value does not belong to this fact kind.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wert passt nicht zu dieser Angabe. Wähle einen der angebotenen Werte."
