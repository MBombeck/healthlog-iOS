    },
    "illness.correlation.redFlags.seekCare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a pattern in your own recorded values, not a clinical finding. If it keeps happening, it is worth mentioning to your doctor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Muster in deinen eigenen Werten, kein klinischer Befund. Wenn es sich wiederholt, lohnt es sich, das ärztlich anzusprechen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een patroon in je eigen vastgelegde waarden, geen klinische bevinding. Als het vaker gebeurt, is het goed om het met je arts te bespreken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 기록한 값에서 나타난 패턴이며 임상 소견이 아니에요. 계속 반복된다면 의사에게 이야기해 볼 만해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es un patrón en tus propios valores registrados, no un hallazgo clínico. Si se repite, vale la pena comentárselo a tu médico."
          }
        }
      }
    },
    "illness.correlation.redFlags.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worth mentioning"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwähnenswert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vermelden waard"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이야기해 볼 만한 점"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vale la pena comentarlo"
          }
        }
      }
    },
