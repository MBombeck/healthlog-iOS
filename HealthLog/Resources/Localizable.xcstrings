    "illness.optIn.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a private journal of illnesses, injuries and ongoing conditions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe ein privates Tagebuch über Erkrankungen, Verletzungen und anhaltende Beschwerden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een privédagboek bij van ziektes, blessures en aanhoudende klachten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질환, 부상, 지속되는 건강 상태를 나만의 일지로 기록해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva un diario privado de enfermedades, lesiones y afecciones persistentes."
          }
        }
      }
    },
    "illness.optIn.bullet.correlation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your own vitals shifted around an illness, computed on the server from your baseline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie sich deine Vitalwerte rund um eine Erkrankung gegenüber deinem Ausgangswert verändert haben, berechnet auf dem Server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie hoe je vitale waarden rond een ziekte zijn veranderd ten opzichte van je basiswaarde, berekend op de server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아팠던 기간 전후로 내 활력 징후가 어떻게 달라졌는지 볼 수 있어요. 서버가 내 기준값을 바탕으로 계산해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo cambiaron tus propias constantes en torno a una enfermedad, calculado en el servidor a partir de tus valores de referencia."
          }
        }
      }
    },
    "illness.optIn.bullet.journal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log episodes and a day-by-day symptom timeline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Episoden und einen Symptomverlauf Tag für Tag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg episodes vast en houd per dag je symptomen bij."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에피소드와 날짜별 증상 타임라인을 기록해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra episodios y una cronología diaria de síntomas."
          }
        }
      }
    },
    "illness.optIn.bullet.retrospective": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks back at what happened. It never predicts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blickt zurück auf das Geschehene. Es sagt nichts voraus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijkt terug op wat er gebeurde. Het voorspelt nooit iets."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지나간 일을 되돌아볼 뿐, 예측하지는 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira lo que pasó. Nunca hace predicciones."
          }
        }
      }
    },
