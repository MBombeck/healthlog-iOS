    "settings.advanced.biometricLock.description": {
      "comment": "Privacy & Security — help text under the Biometric lock toggle; explains what it gates and that nothing is sent to the server.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlangt Face ID oder Touch ID bei jedem Öffnen oder Zurückkehren in die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Face ID or Touch ID every time you open or return to the app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt om Face ID of Touch ID telkens als je de app opent of ernaar terugkeert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열거나 다시 돌아올 때마다 Face ID 또는 Touch ID가 필요해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide Face ID o Touch ID cada vez que abres la app o vuelves a ella."
          }
        }
      }
    },
