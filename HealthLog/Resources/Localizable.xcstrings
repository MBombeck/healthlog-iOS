    "onboarding.mode.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Server bleibt alles auf diesem iPhone. Manche Cloud-Funktionen wie Sync, Insights und Gesundheitsbericht brauchen einen Server. Du kannst ihn später in den Einstellungen verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a server everything stays on this iPhone. Some cloud features, like sync, insights and the doctor report, need a server. You can connect one later in Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder server blijft alles op deze iPhone. Sommige cloudfuncties, zoals synchronisatie, inzichten en het artsenrapport, hebben een server nodig. Je kunt er later een koppelen in Instellingen."
          }
        }
      }
    },
