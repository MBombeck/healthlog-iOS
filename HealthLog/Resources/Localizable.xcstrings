    "mentalHealth.crisisResource.dargeboteneHand.name": {
      "comment": "Crisis resource name (CH/AT). The server returns the combined DE/AT/CH set for a bare 'de' locale, so these ids reach German users too — without these keys the crisis card rendered the raw dotted key. Wording matches web messages/de.json verbatim. Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.crisisResource.dargeboteneHand.name`, word for word.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dargebotene Hand (rund um die Uhr, kostenlos, vertraulich)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dargebotene Hand (24/7, free, confidential)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dargebotene Hand (dag en nacht, gratis, vertrouwelijk)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dargebotene Hand (24시간 연중무휴, 무료, 비밀 보장)"
          }
        },
        "es": {
