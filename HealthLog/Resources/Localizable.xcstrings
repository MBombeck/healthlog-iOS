    "settings.shareLinks.info.about": {
      "comment": "1.4 B2-c: Share with clinician info sheet, What is this",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link öffnet eine schreibgeschützte Ansicht deiner Akte, ohne Zugriff auf dein Konto. Jeder Link läuft nach höchstens 90 Tagen von selbst ab, und du kannst ihn jederzeit widerrufen, dann endet der Zugriff sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link opens a read-only view of your record, without access to your account. Every link expires on its own after 90 days at the most, and you can revoke it at any time, which ends access at once."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een link opent een alleen-lezen weergave van je dossier, zonder toegang tot je account. Elke link verloopt vanzelf na hoogstens 90 dagen, en je kunt hem op elk moment intrekken, dan eindigt de toegang meteen."
          }
        }
      }
    },
    "settings.siri.info.about": {
      "comment": "1.4 B2-c: Siri & Shortcuts info sheet, What is this",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du Siri sagst, läuft über denselben sicheren Weg wie in der App: Der Eintrag wird in deinem Konto gespeichert, bei Bedarf in Apple Health geschrieben und ohne Verbindung sicher zwischengespeichert, bis du HealthLog das nächste Mal öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you tell Siri takes the same secure path as the app: the entry is saved to your account, written to Apple Health when relevant, and kept safely while you're offline until you next open HealthLog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je tegen Siri zegt, gaat via dezelfde veilige weg als in de app: de registratie wordt in je account opgeslagen, zo nodig in Apple Health geschreven en zonder verbinding veilig bewaard tot je HealthLog weer opent."
          }
        }
      }
    },
    "settings.siri.info.signin.title": {
      "comment": "1.4 B2-c: Siri & Shortcuts info sheet, section title",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen"
          }
        }
      }
    },
