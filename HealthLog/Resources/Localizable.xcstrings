    "insights.subPage.explainer.activeEnergyBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktive Energie sind die Kalorien, die du durch Bewegung verbrennst, zusätzlich zum Grundumsatz in Ruhe. Sie ist ein direktes Maß dafür, wie körperlich aktiv dein Tag war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active energy is the calories you burn through movement, on top of the baseline your body uses at rest. It is a direct measure of how physically active your day was."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve energie is het aantal calorieën dat je door beweging verbrandt, bovenop wat je lichaam in rust verbruikt. Het is een directe maat voor hoe lichamelijk actief je dag was."
          }
        }
      }
    },
    "insights.subPage.explainer.activeEnergyTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Energie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active energy"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve energie"
          }
        }
      }
    },
    "insights.subPage.explainer.audioEventsBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laute Geräuschereignisse markieren Momente, in denen der Lärm um dich herum ein Niveau erreicht hat, das bei ausreichender Belastung das Gehör schädigen kann. Häufige Ereignisse sind ein Hinweis, eine ruhigere Umgebung oder Gehörschutz zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loud sound events flag moments when noise around you reached a level that can harm hearing with enough exposure. Frequent events are a cue to seek quieter surroundings or hearing protection."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Harde geluidsgebeurtenissen markeren momenten waarop het geluid om je heen een niveau bereikte dat bij voldoende blootstelling je gehoor kan beschadigen. Komen ze vaak voor, zoek dan een rustigere omgeving op of gebruik gehoorbescherming."
          }
        }
      }
    },
    "insights.subPage.explainer.audioEventsTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laute Geräuschereignisse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loud sound events"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Harde geluidsgebeurtenissen"
          }
        }
      }
    },
    "insights.subPage.explainer.bloodGlucoseBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blutzucker ist die Zuckermenge in deinem Blut, die wichtigste Energiequelle des Körpers. Er steigt nach dem Essen und pendelt sich zwischen den Mahlzeiten ein; dauerhaft hohe Werte können auf Diabetes oder Prädiabetes hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood glucose is the amount of sugar in your blood, the body's main energy source. It rises after eating and settles between meals; readings that stay high over time can signal diabetes or prediabetes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedglucose is de hoeveelheid suiker in je bloed, de belangrijkste energiebron van je lichaam. Het stijgt na het eten en daalt weer tussen de maaltijden. Waarden die lange tijd hoog blijven, kunnen wijzen op diabetes of prediabetes."
          }
        }
      }
    },
    "insights.subPage.explainer.bloodGlucoseTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutzucker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood glucose"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedglucose"
          }
        }
      }
    },
    "insights.subPage.explainer.bloodPressureBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blutdruck ist die Kraft, die das Blut auf die Gefäßwände ausübt, angegeben als systolisch zu diastolisch (Spitzenwert beim Herzschlag über dem Ruhewert dazwischen). Dauerhaft hohe Werte belasten Herz und Gefäße auf Dauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood pressure is the force your blood exerts on the artery walls, written as systolic over diastolic (the peak during a heartbeat over the resting value between beats). Consistently high readings strain the heart and blood vessels over time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeddruk is de kracht die je bloed uitoefent op de wanden van je slagaders, genoteerd als systolisch over diastolisch (de piek tijdens een hartslag over de rustwaarde tussen de slagen). Aanhoudend hoge waarden belasten je hart en bloedvaten op den duur."
          }
        }
      }
    },
    "insights.subPage.explainer.bloodPressureTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutdruck"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood pressure"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeddruk"
          }
        }
      }
    },
    "insights.subPage.explainer.bmiBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der BMI ist dein Gewicht geteilt durch deine Körpergröße zum Quadrat und ordnet dich einer groben Gewichtskategorie zu. Er unterscheidet nicht zwischen Muskeln und Fett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI is your weight divided by your height squared, giving a single number that places you in a broad weight category. It does not distinguish muscle from fat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI is je gewicht gedeeld door het kwadraat van je lengte. Het geeft één getal dat je in een globale gewichtscategorie plaatst. Het maakt geen onderscheid tussen spieren en vet."
          }
        }
      }
    },
    "insights.subPage.explainer.bmiTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Body-Mass-Index (BMI)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body mass index (BMI)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Body mass index (BMI)"
          }
        }
      }
    },
    "insights.subPage.explainer.bodyTemperatureBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Körpertemperatur spiegelt deinen Kernwärmezustand wider, normalerweise um 37 °C mit kleinen Tagesschwankungen. Ein anhaltender Anstieg kann auf eine Infektion hindeuten; nächtliche Messungen am Handgelenk erfassen vor allem relative Änderungen, keinen klinischen Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body temperature reflects your core thermal state, normally around 37 °C with small daily swings. A sustained rise can indicate infection, while overnight wrist readings mainly track relative changes rather than a clinical value."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichaamstemperatuur geeft je kerntemperatuur weer, normaal rond 37 °C met kleine schommelingen over de dag. Een aanhoudende stijging kan op een infectie wijzen. Nachtelijke metingen aan de pols volgen vooral relatieve veranderingen, geen klinische waarde."
          }
        }
      }
    },
    "insights.subPage.explainer.bodyTemperatureTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körpertemperatur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body temperature"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichaamstemperatuur"
          }
        }
      }
    },
    "insights.subPage.explainer.bodyWaterBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gesamtkörperwasser ist der Anteil deines Körpergewichts, der aus Flüssigkeit in und um die Zellen besteht. Es schwankt mit Flüssigkeitshaushalt, Ernährung und Aktivität, daher sagt der Trend über Wochen mehr aus als ein einzelner Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total body water is the share of your body weight made up of fluid, inside and around your cells. It shifts with hydration, food, and activity, so the trend over weeks tells you more than any single reading."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totaal lichaamswater is het deel van je lichaamsgewicht dat uit vocht bestaat, in en rond je cellen. Het schommelt met je vochtbalans, voeding en activiteit, dus de trend over weken zegt meer dan een losse meting."
          }
        }
      }
    },
    "insights.subPage.explainer.bodyWaterTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtkörperwasser"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total body water"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totaal lichaamswater"
          }
        }
      }
    },
    "insights.subPage.explainer.boneMassBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Knochenmasse ist das geschätzte Gewicht der Mineralien in deinem Skelett. Waagengestützte Schätzungen sind ungefähr, doch ein gleichbleibender oder steigender Trend unterstützt die langfristige Knochenstärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bone mass is the estimated weight of the mineral in your skeleton. Scale-based estimates are approximate, but a steady or rising trend supports long-term bone strength."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Botmassa is het geschatte gewicht van de mineralen in je skelet. Schattingen via een weegschaal zijn bij benadering, maar een gelijkblijvende of stijgende trend ondersteunt sterke botten op lange termijn."
          }
        }
      }
    },
    "insights.subPage.explainer.boneMassTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knochenmasse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bone mass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Botmassa"
          }
        }
      }
    },
    "insights.subPage.explainer.breathingDisturbancesBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apple Watch kann schätzen, wie oft deine Atmung im Schlaf unterbrochen war. Ein niedriger Index ist besser; die Einstufung als erhöht stammt von Apple, nicht von HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Watch can estimate how often your breathing was interrupted during sleep. A lower index is better; the elevated classification comes from Apple, not from HealthLog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple Watch kan schatten hoe vaak je ademhaling tijdens je slaap werd onderbroken. Een lagere index is beter. De indeling als verhoogd komt van Apple, niet van HealthLog."
          }
        }
      }
    },
    "insights.subPage.explainer.breathingDisturbancesTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atemaussetzer im Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep breathing disturbances"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ademhalingsstoornissen tijdens slaap"
          }
        }
      }
    },
    "insights.subPage.explainer.cardioFitnessBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂max gibt an, wie viel Sauerstoff dein Körper bei maximaler Anstrengung verwerten kann. Es ist der aussagekräftigste Laborwert für die Ausdauerfitness; ein höherer oder steigender Wert spricht für eine gute Herz-Kreislauf-Gesundheit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂ max is how much oxygen your body can use at peak effort. It is the single best lab marker of aerobic fitness, and a higher or rising value is a strong sign of cardiovascular health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂ max is hoeveel zuurstof je lichaam kan gebruiken bij maximale inspanning. Het is de beste labwaarde voor je aerobe conditie, en een hogere of stijgende waarde is een sterk teken van een gezond hart en gezonde bloedvaten."
          }
        }
      }
    },
    "insights.subPage.explainer.cardioFitnessTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardiofitness (VO₂max)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio fitness (VO₂ max)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardiofitness (VO₂ max)"
          }
        }
      }
    },
    "insights.subPage.explainer.cardioRecoveryBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erholungspuls gibt an, um wie viele Schläge pro Minute dein Puls in der ersten Minute nach dem Ende einer anstrengenden Belastung fällt. Ein größerer Abfall bedeutet, dass sich dein Herz schneller beruhigt. Das ist ein Zeichen guter Fitness."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio recovery is how many beats per minute your heart rate falls in the first minute after you stop hard exercise. A bigger drop means your heart settles down faster, which is a sign of good fitness."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardioherstel is hoeveel slagen per minuut je hartslag daalt in de eerste minuut nadat je stopt met zware inspanning. Een grotere daling betekent dat je hart sneller tot rust komt, en dat is een teken van een goede conditie."
          }
        }
      }
    },
    "insights.subPage.explainer.cardioRecoveryTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholungspuls"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio recovery"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardioherstel"
          }
        }
      }
    },
    "insights.subPage.explainer.daylightBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit im Tageslicht ist, wie lange du dich täglich im Freien im Licht aufhältst. Regelmäßiges Tageslicht unterstützt einen gesunden Schlaf-Wach-Rhythmus und die Stimmung, und Zeit im Freien ist mit der Augengesundheit verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time in daylight is how long you spend in outdoor light each day. Regular daylight supports a healthy sleep-wake rhythm and mood, and time outdoors is linked to eye health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd in daglicht is hoelang je elke dag buiten in het licht doorbrengt. Regelmatig daglicht ondersteunt een gezond slaap-waakritme en je stemming, en tijd buiten wordt in verband gebracht met gezonde ogen."
          }
        }
      }
    },
    "insights.subPage.explainer.daylightTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit im Tageslicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time in daylight"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd in daglicht"
          }
        }
      }
    },
    "insights.subPage.explainer.doubleSupportTimeBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Doppelunterstützungszeit ist der Anteil jedes Gehzyklus, in dem beide Füße gleichzeitig den Boden berühren. Ein höherer Prozentsatz bedeutet meist ein vorsichtigeres, weniger stabiles Gangbild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double support time is the share of each walking cycle when both feet touch the ground at once. A higher percentage usually means a more cautious, less stable gait."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbelsteuntijd is het deel van elke loopcyclus waarin beide voeten tegelijk de grond raken. Een hoger percentage betekent meestal een voorzichtiger, minder stabiel looppatroon."
          }
        }
      }
    },
    "insights.subPage.explainer.doubleSupportTimeTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelunterstützungszeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double support time"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbelsteuntijd"
          }
        }
      }
    },
    "insights.subPage.explainer.environmentalAudioBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebungslautstärke erfasst die Lautstärke deiner Umwelt in Dezibel. Anhaltende Belastung über etwa 70 dB kann das Gehör mit der Zeit schädigen, daher sind niedrigere Tagesmittel sicherer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environmental sound levels track the loudness of the world around you in decibels. Prolonged exposure above about 70 dB can damage hearing over time, so lower daily averages are safer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgevingsgeluidsniveaus volgen hoe luid de wereld om je heen is, in decibel. Langdurige blootstelling boven ongeveer 70 dB kan je gehoor op den duur beschadigen, dus lagere daggemiddelden zijn veiliger."
          }
        }
      }
    },
    "insights.subPage.explainer.environmentalAudioTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgebungslautstärke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environmental sound levels"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgevingsgeluidsniveaus"
          }
        }
      }
    },
    "insights.subPage.explainer.fallsBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden die von deiner Apple Watch erkannten schweren Stürze gezählt. Null ist das Ziel; eine steigende Zahl ist ein Hinweis auf ein erhöhtes Sturzrisiko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This counts the hard falls your Apple Watch detects. Zero is the goal; a rising count is a mobility-risk signal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit telt de harde vallen die je Apple Watch detecteert. Nul is het doel. Een stijgend aantal is een signaal van een verhoogd valrisico."
          }
        }
      }
    },
    "insights.subPage.explainer.fallsTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stürze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valpartijen"
          }
        }
      }
    },
    "insights.subPage.explainer.fatFreeMassBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fettfreie Masse ist alles in deinem Körper, das kein Fett ist: Muskeln, Knochen, Organe und Wasser. Sie zu halten oder aufzubauen, während das Gewicht sinkt, deutet meist auf eine gesündere Körperzusammensetzung hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat-free mass is everything in your body that is not fat: muscle, bone, organs, and water. Holding or building it while losing weight usually signals healthier body composition."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvrije massa is alles in je lichaam dat geen vet is: spieren, botten, organen en water. Als je die behoudt of opbouwt terwijl je afvalt, wijst dat meestal op een gezondere lichaamssamenstelling."
          }
        }
      }
    },
    "insights.subPage.explainer.fatFreeMassTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fettfreie Masse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat-free mass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvrije massa"
          }
        }
      }
    },
    "insights.subPage.explainer.fatMassBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fettmasse ist das Gesamtgewicht des Körperfetts. Etwas Fett ist für Hormone und Energiespeicher unverzichtbar, doch zu viel (besonders am Bauch) erhöht das langfristige Gesundheitsrisiko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat mass is the total weight of fat in your body. Some fat is essential for hormones and energy storage, but too much, especially around the abdomen, raises long-term health risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetmassa is het totale gewicht van het vet in je lichaam. Wat vet is onmisbaar voor hormonen en energieopslag, maar te veel, vooral rond de buik, verhoogt het gezondheidsrisico op lange termijn."
          }
        }
      }
    },
    "insights.subPage.explainer.fatMassTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fettmasse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat mass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetmassa"
          }
        }
      }
    },
    "insights.subPage.explainer.flightsClimbedBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gestiegenen Etagen zählen die Stockwerke, die du täglich nach oben gehst, wobei eine Etage etwa drei Metern Höhe entspricht. Es ist ein einfacher Marker für Alltagsaktivität und Beinarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flights climbed counts the floors you go up each day, with one flight roughly ten feet of elevation. It is a simple marker of incidental activity and lower-body effort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklommen trappen telt het aantal verdiepingen dat je elke dag omhooggaat, waarbij één verdieping ongeveer drie meter hoogte is. Het is een eenvoudige graadmeter voor beweging tussendoor en inspanning van je benen."
          }
        }
      }
    },
    "insights.subPage.explainer.flightsClimbedTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etagen gestiegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flights climbed"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklommen trappen"
          }
        }
      }
    },
    "insights.subPage.explainer.headphoneAudioBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopfhörerlautstärke erfasst in Dezibel, wie laut du über Ohrhörer oder Kopfhörer hörst. Die Lautstärke niedrig zu halten und Pausen einzulegen schützt dein Gehör langfristig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headphone audio levels track how loudly you listen through earbuds or headphones, in decibels. Keeping the volume down and taking breaks protects your hearing over the long run."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koptelefoonniveaus volgen hoe hard je luistert via oordopjes of een koptelefoon, in decibel. Het volume laag houden en pauzes nemen beschermt je gehoor op lange termijn."
          }
        }
      }
    },
    "insights.subPage.explainer.headphoneAudioTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfhörerlautstärke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headphone audio levels"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koptelefoonniveaus"
          }
        }
      }
    },
    "insights.subPage.explainer.hrvBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HRV ist die kleine Schwankung der Zeit zwischen aufeinanderfolgenden Herzschlägen. Eine höhere Variabilität spiegelt meist ein gut erholtes, anpassungsfähiges Nervensystem wider, ein anhaltender Rückgang kann auf Erschöpfung, Stress oder mangelnde Erholung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV is the tiny variation in time between consecutive heartbeats. Higher variability usually reflects a well-recovered, adaptable nervous system, while a sustained drop can signal fatigue, stress, or insufficient recovery."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV is de kleine variatie in tijd tussen opeenvolgende hartslagen. Een hogere variabiliteit wijst meestal op een goed hersteld, flexibel zenuwstelsel, terwijl een aanhoudende daling kan wijzen op vermoeidheid, stress of onvoldoende herstel."
          }
        }
      }
    },
    "insights.subPage.explainer.hrvTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herzfrequenzvariabilität (HRV)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate variability (HRV)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hartslagvariabiliteit (HRV)"
          }
        }
      }
    },
    "insights.subPage.explainer.leanBodyMassBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Magermasse ist dein Gesamtgewicht abzüglich des Körperfetts, also Muskeln, Knochen, Organe und Wasser zusammen. Sie neben dem Gewicht zu verfolgen zeigt, ob Veränderungen aus Muskeln oder aus Fett stammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean body mass is your total weight minus body fat, meaning muscle, bone, organs, and water combined. Tracking it alongside weight shows whether changes come from muscle or from fat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvrije lichaamsmassa is je totale gewicht min lichaamsvet, dus spieren, botten, organen en water samen. Als je dit naast je gewicht bijhoudt, zie je of veranderingen uit spieren of uit vet komen."
          }
        }
      }
    },
    "insights.subPage.explainer.leanBodyMassTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Magermasse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean body mass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvrije lichaamsmassa"
          }
        }
      }
    },
    "insights.subPage.explainer.medicationsBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Therapietreue zeigt, wie zuverlässig du deine Medikamente wie verordnet einnimmst, hier als Anteil der erwarteten Dosen, die du erfasst hast. Eine gleichmäßige Einnahme entscheidet oft darüber, ob eine Therapie wie beabsichtigt wirkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adherence is how reliably you take your medication as prescribed, shown here as the share of expected doses you actually logged. Steady intake is often what makes a treatment work as intended."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Therapietrouw is hoe betrouwbaar je je medicijnen inneemt zoals voorgeschreven, hier weergegeven als het deel van de verwachte doses dat je echt hebt vastgelegd. Een regelmatige inname is vaak wat een behandeling laat werken zoals bedoeld."
          }
        }
      }
    },
    "insights.subPage.explainer.medicationsTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medikamenten-Therapietreue"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medication adherence"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Therapietrouw medicatie"
          }
        }
      }
    },
    "insights.subPage.explainer.moodBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmungserfassung hält auf einer einfachen Skala fest, wie du dich fühlst. Regelmäßiges Protokollieren zeigt Muster, die ein einzelner Tag nie offenbart: etwa wie Schlaf, Aktivität oder Medikamente mit dem Befinden zusammenhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood tracking records how you feel over time on a simple scale. Logging it regularly reveals patterns that a single day never shows, like how sleep, activity, or medication line up with how you feel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemming bijhouden legt op een eenvoudige schaal vast hoe je je door de tijd heen voelt. Als je het regelmatig vastlegt, zie je patronen die één dag nooit laat zien, zoals hoe slaap, activiteit of medicijnen samenhangen met hoe je je voelt."
          }
        }
      }
    },
    "insights.subPage.explainer.moodTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemming"
          }
        }
      }
    },
    "insights.subPage.explainer.muscleMassBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Muskelmasse ist das geschätzte Gewicht der Muskeln in deinem Körper. Mehr Muskeln unterstützen Kraft, Stoffwechsel und Beweglichkeit und müssen mit zunehmendem Alter aktiv erhalten werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle mass is the estimated weight of the muscle in your body. More muscle supports strength, metabolism, and mobility, and it tends to need active effort to preserve as you age."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiermassa is het geschatte gewicht van de spieren in je lichaam. Meer spieren ondersteunen kracht, stofwechsel en mobiliteit, en naarmate je ouder wordt, kost het meestal actieve inspanning om ze te behouden."
          }
        }
      }
    },
    "insights.subPage.explainer.muscleMassTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muskelmasse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle mass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiermassa"
          }
        }
      }
    },
    "insights.subPage.explainer.oxygenSaturationBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SpO₂ ist der Prozentsatz der roten Blutkörperchen, die Sauerstoff transportieren. Werte von 95 bis 100 % sind in Ruhe normal; Werte, die dauerhaft unter 90 % liegen, verdienen Aufmerksamkeit, kurze nächtliche Abfälle sind jedoch häufig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpO₂ is the percentage of your red blood cells carrying oxygen. Readings of 95 to 100% are normal at rest; values that stay below 90% warrant attention, though brief nightly dips are common."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SpO₂ is het percentage van je rode bloedcellen dat zuurstof vervoert. Waarden van 95 tot 100% zijn normaal in rust. Waarden die onder 90% blijven verdienen aandacht, al zijn korte dalingen 's nachts gebruikelijk."
          }
        }
      }
    },
    "insights.subPage.explainer.oxygenSaturationTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauerstoffsättigung (SpO₂)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oxygen saturation (SpO₂)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuurstofverzadiging (SpO₂)"
          }
        }
      }
    },
    "insights.subPage.explainer.pulseBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Puls gibt an, wie oft das Herz pro Minute schlägt. Eine Einzelmessung spiegelt den Moment wider. In Ruhe liegt er meist bei 60 bis 100 Schlägen pro Minute und steigt natürlicherweise bei Bewegung, Stress oder Koffein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pulse is how many times your heart beats per minute. A spot reading reflects what you were doing in the moment. At rest it is typically 60 to 100 beats per minute, and it rises naturally with movement, stress, or caffeine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hartslag is hoe vaak je hart per minuut slaat. Een losse meting laat zien wat je op dat moment deed. In rust ligt die meestal tussen 60 en 100 slagen per minuut, en hij stijgt vanzelf bij beweging, stress of cafeïne."
          }
        }
      }
    },
    "insights.subPage.explainer.pulseTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Puls"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hartslag"
          }
        }
      }
    },
    "insights.subPage.explainer.pulseWaveVelocityBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pulswellengeschwindigkeit misst, wie schnell die Druckwelle jedes Herzschlags durch deine Arterien läuft. Eine schnellere Welle weist auf steifere Arterien hin, was mit einem höheren Herz-Kreislauf-Risiko verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse wave velocity measures how fast the pressure wave from each heartbeat travels along your arteries. A faster wave indicates stiffer arteries, which is linked to higher cardiovascular risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polsgolfsnelheid meet hoe snel de drukgolf van elke hartslag door je slagaders reist. Een snellere golf wijst op stijvere slagaders, wat samenhangt met een hoger risico op hart- en vaatziekten."
          }
        }
      }
    },
    "insights.subPage.explainer.pulseWaveVelocityTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulswellengeschwindigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse wave velocity"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polsgolfsnelheid"
          }
        }
      }
    },
    "insights.subPage.explainer.respiratoryRateBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Atemfrequenz ist die Anzahl der Atemzüge pro Minute. In Ruhe atmen die meisten Erwachsenen etwa zwölf- bis zwanzigmal pro Minute; ein anhaltender Anstieg kann mit Krankheit, Anstrengung oder Stress einhergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiratory rate is the number of breaths you take per minute. At rest most adults breathe roughly twelve to twenty times a minute; a sustained rise can accompany illness, exertion, or stress."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ademhalingsfrequentie is het aantal ademhalingen per minuut. In rust ademen de meeste volwassenen ongeveer twaalf tot twintig keer per minuut. Een aanhoudende stijging kan samengaan met ziekte, inspanning of stress."
          }
        }
      }
    },
    "insights.subPage.explainer.respiratoryRateTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atemfrequenz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiratory rate"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ademhalingsfrequentie"
          }
        }
      }
    },
    "insights.subPage.explainer.restingHrBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ruhepuls ist die Herzfrequenz in völliger Ruhe, meist über Nacht gemessen. Ein niedriger Ruhepuls deutet in der Regel auf eine bessere Herz-Kreislauf-Fitness hin, ein steigender Trend kann ein frühes Zeichen für Stress oder Krankheit sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting heart rate is your heart rate when you are completely at rest, usually measured overnight. A lower resting rate generally points to better cardiovascular fitness, and a rising trend can be an early sign of stress or illness."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusthartslag is je hartslag als je helemaal in rust bent, meestal 's nachts gemeten. Een lagere rusthartslag wijst meestal op een betere conditie van hart en bloedvaten, en een stijgende trend kan een vroeg teken zijn van stress of ziekte."
          }
        }
      }
    },
    "insights.subPage.explainer.restingHrTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhepuls"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting heart rate"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusthartslag"
          }
        }
      }
    },
    "insights.subPage.explainer.sixMinuteWalkBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist Apples Schätzung, wie weit du in sechs Minuten gehen könntest. Dahinter steht ein etablierter klinischer Test für Mobilität und kardiopulmonale Ausdauer. Eine gleichbleibende oder steigende Strecke ist ein gutes Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is Apple's estimate of how far you could walk in six minutes, based on a long-standing clinical test of mobility and cardiopulmonary endurance. A steady or rising distance is a good sign."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is Apples schatting van hoe ver je in zes minuten zou kunnen lopen, gebaseerd op een lang gebruikte klinische test voor mobiliteit en uithoudingsvermogen van hart en longen. Een gelijkblijvende of stijgende afstand is een goed teken."
          }
        }
      }
    },
    "insights.subPage.explainer.sixMinuteWalkTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "6-Minuten-Gehstrecke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six-minute walk distance"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zesminutenwandelafstand"
          }
        }
      }
    },
    "insights.subPage.explainer.skinTemperatureBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hauttemperatur ist hier die kleine nächtliche Abweichung deiner Handgelenkstemperatur von deinem eigenen Ausgangswert, keine absolute Fiebermessung. Veränderungen können Schlaf, Umgebung, Krankheit oder Zyklusphase widerspiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin temperature here is the small nightly change in your wrist temperature from your own baseline, not an absolute fever reading. Shifts can track sleep, environment, illness, or menstrual-cycle phase."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huidtemperatuur is hier de kleine nachtelijke afwijking van je polstemperatuur ten opzichte van je eigen basiswaarde, geen absolute koortsmeting. Veranderingen kunnen samenhangen met slaap, omgeving, ziekte of de fase van je menstruatiecyclus."
          }
        }
      }
    },
    "insights.subPage.explainer.skinTemperatureTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauttemperatur"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin temperature"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huidtemperatuur"
          }
        }
      }
    },
    "insights.subPage.explainer.sleepBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlafdauer ist die tatsächlich geschlafene Zeit pro Nacht, aufgeteilt in Leicht-, Tief- und REM-Schlaf. Die meisten Erwachsenen brauchen etwa sieben bis neun Stunden; gleichmäßige Menge und Qualität unterstützen Erholung, Stimmung und Stoffwechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep duration is how long you actually slept across the night, split into light, deep, and REM stages. Most adults need roughly seven to nine hours; both consistent quantity and quality support recovery, mood, and metabolism."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaapduur is hoelang je 's nachts echt hebt geslapen, verdeeld in lichte slaap, diepe slaap en REM-slaap. De meeste volwassenen hebben ongeveer zeven tot negen uur nodig. Zowel een regelmatige hoeveelheid als goede kwaliteit ondersteunen herstel, stemming en stofwisseling."
          }
        }
      }
    },
    "insights.subPage.explainer.sleepTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaap"
          }
        }
      }
    },
    "insights.subPage.explainer.stairAscentSpeedBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies gibt an, wie schnell du eine Treppe hinaufgehst. Es ist ein empfindlicher Marker für Beinkraft und Mobilität. Ein gleichbleibendes oder steigendes Tempo ist gut, ein sinkendes solltest du im Blick behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how fast you climb a flight of stairs. It is a sensitive marker of leg strength and mobility. A steady or rising pace is a good sign, and a falling one is worth watching."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is hoe snel je een trap oploopt. Het is een gevoelige graadmeter voor beenkracht en mobiliteit. Een gelijkblijvend of stijgend tempo is een goed teken, een dalend tempo is het in de gaten houden waard."
          }
        }
      }
    },
    "insights.subPage.explainer.stairAscentSpeedTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treppensteig-Tempo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stair ascent speed"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelheid trap op"
          }
        }
      }
    },
    "insights.subPage.explainer.stairDescentSpeedBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies gibt an, wie schnell du eine Treppe hinabgehst. Zusammen mit dem Steig-Tempo zeigt es Beinkontrolle und Gleichgewicht. Ein gleichmäßiges Tempo ist gut, ein sinkendes solltest du im Blick behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how fast you go down a flight of stairs. Together with ascent speed it tracks leg control and balance. A steady pace is a good sign, and a falling one is worth watching."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is hoe snel je een trap afloopt. Samen met de snelheid omhoog volgt het de controle over je benen en je balans. Een gelijkblijvend tempo is een goed teken, een dalend tempo is het in de gaten houden waard."
          }
        }
      }
    },
    "insights.subPage.explainer.stairDescentSpeedTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treppab-Tempo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stair descent speed"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelheid trap af"
          }
        }
      }
    },
    "insights.subPage.explainer.stepLengthBody": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schrittlänge ist der durchschnittliche Abstand von einem Fußauftritt zum nächsten. Eine über die Zeit kürzere Schrittlänge kann Müdigkeit, Vorsicht oder eine veränderte Beweglichkeit widerspiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step length is the average distance from one footfall to the next. A shorter step over time can reflect fatigue, caution, or a change in mobility."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslengte is de gemiddelde afstand tussen twee opeenvolgende voetstappen. Een kortere pas door de tijd heen kan wijzen op vermoeidheid, voorzichtigheid of een verandering in mobiliteit."
          }
        }
      }
    },
    "insights.subPage.explainer.stepLengthTitle": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrittlänge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step length"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslengte"
          }
        }
      }
    },
    "insights.subPage.explainer.trigger": {
      "comment": "Insights — per-metric explainer (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist %@?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is %@?"
