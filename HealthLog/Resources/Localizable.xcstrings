            "state": "translated",
            "value": "이번 세션에서 아직 진행된 앵커가 없어요."
          }
        }
      }
    },
    "settings.support.anchors_footer": {
      "comment": "08-15 — Footer: was ein Anker-Fortschritt beweist.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Anker rückt nur vor, wenn ein Upload wirklich angekommen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An anchor only advances once an upload has actually landed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een anker schuift pas op als een upload echt is aangekomen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앵커는 업로드가 실제로 완료된 뒤에만 진행돼요."
          }
        }
      }
    },
    "settings.support.anchors_title": {
      "comment": "08-15 — Karte mit den letzten Anker-Fortschritten je Datentyp.",
