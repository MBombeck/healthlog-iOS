    "server.accessHeaders.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen nur an deinen HealthLog-Server und liegen im Schlüsselbund dieses Geräts. Die Anmeldung im Browser (SSO, Passkeys) kann sie nicht mitschicken, dafür muss dein Proxy den Browser selbst durchlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent only to your HealthLog server and kept in this device's Keychain. Sign-in in the browser (SSO, passkeys) cannot carry them, so your proxy has to let the browser through on its own."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaan alleen naar je HealthLog-server en worden bewaard in de sleutelhanger van dit apparaat. Inloggen in de browser (SSO, passkeys) kan ze niet meesturen, daarom moet je proxy de browser zelf doorlaten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 HealthLog 서버로만 전송되고 이 기기의 키체인에 보관돼요. 브라우저 로그인(SSO, 패스키)에는 이 헤더를 함께 보낼 수 없으므로, 프록시가 브라우저를 따로 통과시켜야 해요."
          }
        }
      },
      "comment": "GH-iOS #27 — footer of the access headers card."
    },
