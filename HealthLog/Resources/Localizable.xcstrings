    "sleep.debt.computedInfo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist HealthLogs eigene Schätzung: eine gleitende Bilanz aus Bedarf minus Schlaf über die letzten Nächte, die Aufholschlaf wieder abbaut. Sie kann vom nativen Schlafdefizit eines Wearables abweichen, das ein eigenes Bedarfsmodell nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is HealthLog's own estimate: a rolling balance of need minus sleep over recent nights, with catch-up sleep paying it down. It can differ from a wearable's native sleep-debt figure, which uses its own need model."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een eigen schatting van HealthLog: een doorlopend saldo van slaapbehoefte min slaap over de afgelopen nachten, dat afneemt als je slaap inhaalt. Het kan afwijken van het slaaptekort dat een wearable zelf toont, omdat die een eigen behoeftemodel gebruikt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog 자체 추정치예요. 최근 며칠 밤의 필요 수면에서 실제 수면을 뺀 값을 누적한 것이며, 보충 수면을 하면 줄어들어요. 자체 필요 수면 모델을 쓰는 웨어러블 기기의 수면 부채 수치와 다를 수 있어요."
          }
        }
      }
    },
    "sleep.debt.learning %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlaf wird noch erfasst: %1$lld Nächte bisher, noch %2$lld für eine verlässliche Bilanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still learning your sleep: %1$lld nights so far, %2$lld more to read a reliable balance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je slaap wordt nog in kaart gebracht: tot nu toe %1$lld nachten, nog %2$lld nodig voor een betrouwbaar saldo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 패턴을 파악하는 중이에요: 지금까지 %1$lld일 밤, 신뢰할 만한 누적값까지 %2$lld일 밤 더 필요해요."
          }
        }
      }
    },
