    "settings.security.twoFactor.stepUp.freshOnWeb": {
      "comment": "2FA step-up — fresh-factor route on an account without an authenticator app: only the passkey arm is native.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Authentifizierungs-App bestätigst du hier mit einem Passkey. Mit einem Sicherheitsschlüssel geht das nur im Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an authenticator app, confirm here with a passkey. Confirming with a security key works only in the browser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder authenticator-app bevestig je hier met een toegangssleutel. Bevestigen met een beveiligingssleutel kan alleen in de browser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱이 없으면 여기서 패스키로 확인하세요. 보안 키로 확인하는 건 브라우저에서만 할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin app de autenticación, confirma aquí con una llave de acceso. La confirmación con una llave de seguridad solo funciona en el navegador."
          }
        }
      }
    },
