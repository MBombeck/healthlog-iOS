            "value": "Recordatorio para la dosis de las %@."
          }
        }
      }
    },
    "med.reminders.times.many": {
      "comment": "%@ = list of times of day, e.g. 08:00 and 20:00 (list formatted)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen für die Dosen um %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders for the doses at %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen voor de doses om %@."
          }
        },
        "ko": {
          "stringUnit": {
