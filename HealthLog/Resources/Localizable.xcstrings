    "insights.metric.activeEnergyBurned.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktive Energie sind die Kalorien, die du durch Bewegung verbrennst, zusätzlich zum Grundumsatz in Ruhe. Sie ist ein direktes Maß dafür, wie körperlich aktiv dein Tag war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active energy is the calories you burn through movement, on top of the baseline your body uses at rest. It is a direct measure of how physically active your day was."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve energie is het aantal calorieën dat je door beweging verbrandt, bovenop wat je lichaam in rust verbruikt. Het is een directe maat voor hoe lichamelijk actief je dag was."
          }
        }
      }
    },
    "insights.metric.appleWalkingSteadiness.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gehstabilität spiegelt wider, wie stabil und ausgeglichen dein Gangbild ist; das iPhone ermittelt sie, während du es bei dir trägst. Niedrigere Werte können auf ein höheres Sturzrisiko hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking steadiness reflects how stable and balanced your gait is, derived by iPhone while you carry it. Lower values can signal a higher fall risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelstabiliteit geeft aan hoe stabiel en evenwichtig je looppatroon is. Je iPhone bepaalt dit terwijl je hem bij je draagt. Lagere waarden kunnen wijzen op een hoger valrisico."
          }
        }
      }
    },
    "insights.metric.assessment.aiLabel": {
      "comment": "W52-2 — provenance label for the server-generated per-metric AI assessment card; reads as the badge above the prose so the user knows the assessment came from the assistant.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Einschätzung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assessment"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-beoordeling"
          }
        }
      }
    },
    "insights.metric.assessment.title": {
      "comment": "Section header for the server-generated per-metric assessment (web Einschätzung).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschätzung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessment"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeling"
          }
        }
      }
    },
    "insights.metric.bloodPressure.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blutdruck ist die Kraft, die das Blut auf die Gefäßwände ausübt, angegeben als systolisch zu diastolisch (Spitzenwert beim Herzschlag über dem Ruhewert dazwischen). Dauerhaft hohe Werte belasten Herz und Gefäße auf Dauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood pressure is the force your blood exerts on the artery walls, written as systolic over diastolic (the peak during a heartbeat over the resting value between beats). Consistently high readings strain the heart and blood vessels over time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloeddruk is de kracht die je bloed uitoefent op de vaatwanden, genoteerd als systolisch over diastolisch (de piek tijdens een hartslag over de rustwaarde tussen de slagen). Aanhoudend hoge waarden belasten op den duur je hart en bloedvaten."
          }
        }
      }
    },
    "insights.metric.bodyFat.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Körperfettanteil ist der Anteil deines Körpergewichts, der aus Fett besteht. Er ergänzt Gewicht und Muskelmasse zu einem vollständigeren Bild der Körperzusammensetzung; gesunde Bereiche hängen von Alter und Geschlecht ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body fat percentage is the share of your body weight made up of fat. It complements weight and muscle mass to give a fuller picture of body composition; healthy ranges vary with age and sex."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetpercentage is het deel van je lichaamsgewicht dat uit vet bestaat. Samen met gewicht en spiermassa geeft het een vollediger beeld van je lichaamssamenstelling; gezonde waarden verschillen per leeftijd en geslacht."
          }
        }
      }
    },
    "insights.metric.bodyMassIndex.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der BMI ist dein Gewicht geteilt durch deine Körpergröße zum Quadrat und ordnet dich einer groben Gewichtskategorie zu. Er unterscheidet nicht zwischen Muskeln und Fett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI is your weight divided by your height squared, giving a single number that places you in a broad weight category. It does not distinguish muscle from fat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BMI is je gewicht gedeeld door je lengte in het kwadraat. Dat geeft één getal dat je in een grove gewichtscategorie plaatst. Het maakt geen onderscheid tussen spieren en vet."
          }
        }
      }
    },
    "insights.metric.bodyTemperature.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Körpertemperatur spiegelt deinen Kernwärmezustand wider, normalerweise um 37 °C mit kleinen Tagesschwankungen. Ein anhaltender Anstieg kann auf eine Infektion hindeuten; nächtliche Messungen am Handgelenk erfassen vor allem relative Änderungen, keinen klinischen Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body temperature reflects your core thermal state, normally around 37 °C with small daily swings. A sustained rise can indicate infection, while overnight wrist readings mainly track relative changes rather than a clinical value."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichaamstemperatuur geeft je kerntemperatuur weer, normaal rond 37 °C met kleine schommelingen gedurende de dag. Een aanhoudende stijging kan op een infectie wijzen, terwijl metingen aan de pols 's nachts vooral relatieve veranderingen volgen en geen klinische waarde zijn."
          }
        }
      }
    },
    "insights.metric.boneMass.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Knochenmasse ist das geschätzte Gewicht der Mineralien in deinem Skelett. Waagengestützte Schätzungen sind ungefähr, doch ein gleichbleibender oder steigender Trend unterstützt die langfristige Knochenstärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bone mass is the estimated weight of the mineral in your skeleton. Scale-based estimates are approximate, but a steady or rising trend supports long-term bone strength."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Botmassa is het geschatte gewicht van de mineralen in je skelet. Schattingen van een weegschaal zijn bij benadering, maar een stabiele of stijgende trend draagt bij aan sterke botten op de lange termijn."
          }
        }
      }
    },
    "insights.metric.breathingDisturbances.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atemstörungen zählen Unterbrechungen deiner Atmung, die die Apple Watch über Nacht schätzt. Weniger ist besser; ein anhaltender Anstieg kann es wert sein, mit Fachpersonal zu besprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathing disturbances count interruptions in your breathing that Apple Watch estimates overnight. Fewer is better; a sustained rise can be worth raising with a clinician."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ademhalingsverstoringen zijn onderbrekingen in je ademhaling die de Apple Watch 's nachts schat. Minder is beter; bij een aanhoudende stijging is het de moeite waard dit met een arts te bespreken."
          }
        }
      }
    },
    "insights.metric.cardioRecovery.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herzfrequenz-Erholung ist, wie stark deine Herzfrequenz in der Minute nach der Spitzenbelastung sinkt. Ein größerer, schnellerer Abfall spiegelt in der Regel eine bessere Herz-Kreislauf-Fitness wider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio recovery is how far your heart rate drops in the minute after peak exercise. A larger, faster drop generally reflects better cardiovascular fitness."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardioherstel is hoeveel je hartslag daalt in de minuut na een maximale inspanning. Een grotere, snellere daling wijst meestal op een betere cardiovasculaire conditie."
          }
        }
      }
    },
    "insights.metric.distanceWalkingRunning.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geh- und Laufstrecke ist die Strecke, die du täglich zu Fuß zurücklegst. Sie ergänzt die Schrittzahl, indem sie zeigt, wie weit du dich bewegt hast, nicht nur wie oft du getreten bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking and running distance is the ground you cover on foot each day. It complements step count by reflecting how far you moved, not just how often you stepped."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandel- en hardloopafstand is de afstand die je elke dag te voet aflegt. Het vult het aantal stappen aan door te laten zien hoe ver je bent gegaan, niet alleen hoe vaak je een stap zette."
          }
        }
      }
    },
    "insights.metric.environmentalAudioExposure.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebungslautstärke erfasst die Lautstärke deiner Umwelt in Dezibel. Anhaltende Belastung über etwa 70 dB kann das Gehör mit der Zeit schädigen, daher sind niedrigere Tagesmittel sicherer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environmental sound levels track the loudness of the world around you in decibels. Prolonged exposure above about 70 dB can damage hearing over time, so lower daily averages are safer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgevingsgeluidsniveaus meten hoe luid je omgeving is, in decibel. Langdurige blootstelling boven ongeveer 70 dB kan op den duur je gehoor beschadigen, dus lagere daggemiddelden zijn veiliger."
          }
        }
      }
    },
    "insights.metric.fallCount.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stürze zählen die schweren Stürze, die iPhone oder Apple Watch erkannt haben. Weniger ist besser, und null ist das Ziel; eine steigende Zahl kann es wert sein, mit Fachpersonal zu besprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls count the hard falls your iPhone or Apple Watch detected. Fewer is better, and zero is the goal; a rising count can be worth discussing with a clinician."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valpartijen telt de harde vallen die je iPhone of Apple Watch heeft gedetecteerd. Minder is beter en nul is het doel; bij een stijgend aantal is het de moeite waard dit met een arts te bespreken."
          }
        }
      }
    },
    "insights.metric.fatFreeMass.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fettfreie Masse ist alles in deinem Körper, das kein Fett ist: Muskeln, Knochen, Organe und Wasser. Sie zu halten oder aufzubauen, während das Gewicht sinkt, deutet meist auf eine gesündere Körperzusammensetzung hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat-free mass is everything in your body that is not fat: muscle, bone, organs, and water. Holding or building it while losing weight usually signals healthier body composition."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvrije massa is alles in je lichaam dat geen vet is: spieren, botten, organen en water. Als je die behoudt of opbouwt terwijl je afvalt, wijst dat meestal op een gezondere lichaamssamenstelling."
          }
        }
      }
    },
    "insights.metric.fatMass.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fettmasse ist das Gesamtgewicht des Körperfetts. Etwas Fett ist für Hormone und Energiespeicher unverzichtbar, doch zu viel (besonders am Bauch) erhöht das langfristige Gesundheitsrisiko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat mass is the total weight of fat in your body. Some fat is essential for hormones and energy storage, but too much, especially around the abdomen, raises long-term health risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetmassa is het totale gewicht aan vet in je lichaam. Een deel vet is onmisbaar voor hormonen en energieopslag, maar te veel, vooral rond de buik, verhoogt het gezondheidsrisico op de lange termijn."
          }
        }
      }
    },
    "insights.metric.flightsClimbed.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gestiegenen Etagen zählen die Stockwerke, die du täglich nach oben gehst, wobei eine Etage etwa drei Metern Höhe entspricht. Es ist ein einfacher Marker für Alltagsaktivität und Beinarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flights climbed counts the floors you go up each day, with one flight roughly ten feet of elevation. It is a simple marker of incidental activity and lower-body effort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklommen trappen telt de verdiepingen die je elke dag omhoog gaat, waarbij één verdieping ongeveer drie meter hoogte is. Het is een eenvoudige maat voor beweging in het dagelijks leven en inspanning van je benen."
          }
        }
      }
    },
    "insights.metric.glucose.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blutzucker ist die Zuckermenge in deinem Blut, die wichtigste Energiequelle des Körpers. Er steigt nach dem Essen und pendelt sich zwischen den Mahlzeiten ein; dauerhaft hohe Werte können auf Diabetes oder Prädiabetes hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blood glucose is the amount of sugar in your blood, the body's main energy source. It rises after eating and settles between meals; readings that stay high over time can signal diabetes or prediabetes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloedglucose is de hoeveelheid suiker in je bloed, de belangrijkste energiebron van je lichaam. Het stijgt na het eten en daalt weer tussen de maaltijden; waarden die langere tijd hoog blijven, kunnen wijzen op diabetes of prediabetes."
          }
        }
      }
    },
    "insights.metric.headphoneAudioExposure.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopfhörerlautstärke erfasst in Dezibel, wie laut du über Ohrhörer oder Kopfhörer hörst. Die Lautstärke niedrig zu halten und Pausen einzulegen schützt dein Gehör langfristig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Headphone audio levels track how loudly you listen through earbuds or headphones, in decibels. Keeping the volume down and taking breaks protects your hearing over the long run."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koptelefoonaudioniveaus meten hoe luid je luistert via oordopjes of een koptelefoon, in decibel. Het volume laag houden en pauzes nemen beschermt je gehoor op de lange termijn."
          }
        }
      }
    },
    "insights.metric.heartRateVariability.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HRV ist die kleine Schwankung der Zeit zwischen aufeinanderfolgenden Herzschlägen. Eine höhere Variabilität spiegelt meist ein gut erholtes, anpassungsfähiges Nervensystem wider, ein anhaltender Rückgang kann auf Erschöpfung, Stress oder mangelnde Erholung hinweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV is the tiny variation in time between consecutive heartbeats. Higher variability usually reflects a well-recovered, adaptable nervous system, while a sustained drop can signal fatigue, stress, or insufficient recovery."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV is de kleine variatie in tijd tussen opeenvolgende hartslagen. Een hogere variabiliteit wijst meestal op een goed hersteld, flexibel zenuwstelsel, terwijl een aanhoudende daling kan wijzen op vermoeidheid, stress of onvoldoende herstel."
          }
        }
      }
    },
    "insights.metric.leanBodyMass.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Magermasse ist dein Gesamtgewicht abzüglich des Körperfetts, also Muskeln, Knochen, Organe und Wasser zusammen. Sie neben dem Gewicht zu verfolgen zeigt, ob Veränderungen aus Muskeln oder aus Fett stammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean body mass is your total weight minus body fat, meaning muscle, bone, organs, and water combined. Tracking it alongside weight shows whether changes come from muscle or from fat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetvrije lichaamsmassa is je totale gewicht min lichaamsvet, dus spieren, botten, organen en water samen. Als je die naast je gewicht volgt, zie je of veranderingen uit spieren of uit vet komen."
          }
        }
      }
    },
    "insights.metric.muscleMass.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Muskelmasse ist das geschätzte Gewicht der Muskeln in deinem Körper. Mehr Muskeln unterstützen Kraft, Stoffwechsel und Beweglichkeit und müssen mit zunehmendem Alter aktiv erhalten werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle mass is the estimated weight of the muscle in your body. More muscle supports strength, metabolism, and mobility, and it tends to need active effort to preserve as you age."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiermassa is het geschatte gewicht van de spieren in je lichaam. Meer spieren ondersteunen kracht, stofwisseling en mobiliteit, en naarmate je ouder wordt, kost het actieve inspanning om ze te behouden."
          }
        }
      }
    },
    "insights.metric.oxygenSaturation.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die SpO₂ ist der Prozentsatz der roten Blutkörperchen, die Sauerstoff transportieren. Werte von 95 bis 100 % sind in Ruhe normal; Werte, die dauerhaft unter 90 % liegen, verdienen Aufmerksamkeit, kurze nächtliche Abfälle sind jedoch häufig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SpO₂ is the percentage of your red blood cells carrying oxygen. Readings of 95 to 100% are normal at rest; values that stay below 90% warrant attention, though brief nightly dips are common."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SpO₂ is het percentage rode bloedcellen dat zuurstof vervoert. Waarden van 95 tot 100% zijn normaal in rust; waarden die onder 90% blijven verdienen aandacht, al komen korte dalingen 's nachts vaak voor."
          }
        }
      }
    },
    "insights.metric.pulse.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Puls gibt an, wie oft das Herz pro Minute schlägt. Eine Einzelmessung spiegelt den Moment wider. In Ruhe liegt er meist bei 60 bis 100 Schlägen pro Minute und steigt natürlicherweise bei Bewegung, Stress oder Koffein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pulse is how many times your heart beats per minute. A spot reading reflects what you were doing in the moment. At rest it is typically 60 to 100 beats per minute, and it rises naturally with movement, stress, or caffeine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hartslag is hoe vaak je hart per minuut slaat. Een losse meting laat zien wat je op dat moment deed. In rust ligt die meestal tussen 60 en 100 slagen per minuut, en hij stijgt vanzelf bij beweging, stress of cafeïne."
          }
        }
      }
    },
    "insights.metric.pulseWaveVelocity.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pulswellengeschwindigkeit misst, wie schnell die Druckwelle jedes Herzschlags durch deine Arterien läuft. Eine schnellere Welle weist auf steifere Arterien hin, was mit einem höheren Herz-Kreislauf-Risiko verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse wave velocity measures how fast the pressure wave from each heartbeat travels along your arteries. A faster wave indicates stiffer arteries, which is linked to higher cardiovascular risk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polsgolfsnelheid meet hoe snel de drukgolf van elke hartslag door je slagaders gaat. Een snellere golf wijst op stijvere slagaders, wat samenhangt met een hoger risico op hart- en vaatziekten."
          }
        }
      }
    },
    "insights.metric.rangeDelta.flat": {
      "comment": "W5-3 — period-over-period delta caption when the current and prior window means are effectively equal (flat).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "±0 %"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "±0%"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "±0%"
          }
        }
      }
    },
    "insights.metric.respiratoryRate.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Atemfrequenz ist die Anzahl der Atemzüge pro Minute. In Ruhe atmen die meisten Erwachsenen etwa zwölf- bis zwanzigmal pro Minute; ein anhaltender Anstieg kann mit Krankheit, Anstrengung oder Stress einhergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiratory rate is the number of breaths you take per minute. At rest most adults breathe roughly twelve to twenty times a minute; a sustained rise can accompany illness, exertion, or stress."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ademhalingsfrequentie is het aantal ademhalingen per minuut. In rust ademen de meeste volwassenen ongeveer twaalf tot twintig keer per minuut; een aanhoudende stijging kan samengaan met ziekte, inspanning of stress."
          }
        }
      }
    },
    "insights.metric.restingHeartRate.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ruhepuls ist die Herzfrequenz in völliger Ruhe, meist über Nacht gemessen. Ein niedriger Ruhepuls deutet in der Regel auf eine bessere Herz-Kreislauf-Fitness hin, ein steigender Trend kann ein frühes Zeichen für Stress oder Krankheit sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting heart rate is your heart rate when you are completely at rest, usually measured overnight. A lower resting rate generally points to better cardiovascular fitness, and a rising trend can be an early sign of stress or illness."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusthartslag is je hartslag als je volledig in rust bent, meestal 's nachts gemeten. Een lagere rusthartslag wijst meestal op een betere cardiovasculaire conditie, en een stijgende trend kan een vroeg teken zijn van stress of ziekte."
          }
        }
      }
    },
    "insights.metric.skinTemperature.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hauttemperatur ist hier die kleine nächtliche Abweichung deiner Handgelenkstemperatur von deinem eigenen Ausgangswert, keine absolute Fiebermessung. Veränderungen können Schlaf, Umgebung, Krankheit oder Zyklusphase widerspiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skin temperature here is the small nightly change in your wrist temperature from your own baseline, not an absolute fever reading. Shifts can track sleep, environment, illness, or menstrual-cycle phase."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huidtemperatuur is hier de kleine nachtelijke afwijking van je polstemperatuur ten opzichte van je eigen basiswaarde, geen absolute koortsmeting. Verschuivingen kunnen samenhangen met slaap, omgeving, ziekte of de fase van je menstruatiecyclus."
          }
        }
      }
    },
    "insights.metric.sleep.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlafdauer ist die tatsächlich geschlafene Zeit pro Nacht, aufgeteilt in Leicht-, Tief- und REM-Schlaf. Die meisten Erwachsenen brauchen etwa sieben bis neun Stunden; gleichmäßige Menge und Qualität unterstützen Erholung, Stimmung und Stoffwechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep duration is how long you actually slept across the night, split into light, deep, and REM stages. Most adults need roughly seven to nine hours; both consistent quantity and quality support recovery, mood, and metabolism."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaapduur is hoe lang je 's nachts echt hebt geslapen, verdeeld in lichte slaap, diepe slaap en REM-slaap. De meeste volwassenen hebben ongeveer zeven tot negen uur nodig; een vaste hoeveelheid en goede kwaliteit ondersteunen herstel, stemming en stofwisseling."
          }
        }
      }
    },
    "insights.metric.stairAscentSpeed.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Treppensteig-Geschwindigkeit ist, wie schnell du Treppen hinaufgehst, gemessen vom iPhone. Ein schnelleres, gleichmäßigeres Steigen spiegelt in der Regel bessere Beinkraft und Fitness wider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stair ascent speed is how quickly you climb stairs, measured by iPhone. Faster, steadier ascent generally reflects better lower-body strength and fitness."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De snelheid bij traplopen omhoog geeft aan hoe snel je trappen oploopt, gemeten door je iPhone. Sneller en gelijkmatiger omhooglopen wijst meestal op meer kracht in je benen en een betere conditie."
          }
        }
      }
    },
    "insights.metric.stairDescentSpeed.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Treppenabstieg-Geschwindigkeit ist, wie schnell du Treppen hinabgehst, gemessen vom iPhone. Wie die Aufstiegsgeschwindigkeit ist sie ein sanfter Hinweis auf Mobilität und Gleichgewicht im Zeitverlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stair descent speed is how quickly you walk down stairs, measured by iPhone. Like ascent speed, it is a gentle indicator of mobility and balance over time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De snelheid bij traplopen omlaag geeft aan hoe snel je trappen afloopt, gemeten door je iPhone. Net als de snelheid omhoog is het een rustige graadmeter voor je mobiliteit en balans door de tijd heen."
          }
        }
      }
    },
    "insights.metric.steps.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte zählen, wie viel du dich über den Tag bewegst. Regelmäßiges Gehen unterstützt Herz, Stoffwechsel und Stimmung; die Summen hier spiegeln wider, was iPhone und Apple Watch erfasst haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps count how much you move through the day. Regular walking supports heart, metabolic, and mood health; the totals here reflect what your iPhone and Apple Watch recorded."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stappen laten zien hoeveel je over de dag beweegt. Regelmatig wandelen is goed voor je hart, je stofwisseling en je stemming. De totalen hier zijn wat je iPhone en Apple Watch hebben geregistreerd."
          }
        }
      }
    },
    "insights.metric.timeInDaylight.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit im Tageslicht ist, wie lange du dich täglich im Freien im Licht aufhältst. Regelmäßiges Tageslicht unterstützt einen gesunden Schlaf-Wach-Rhythmus und die Stimmung, und Zeit im Freien ist mit der Augengesundheit verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time in daylight is how long you spend in outdoor light each day. Regular daylight supports a healthy sleep-wake rhythm and mood, and time outdoors is linked to eye health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd in daglicht is hoelang je elke dag buiten in het licht doorbrengt. Regelmatig daglicht ondersteunt een gezond slaap-waakritme en je stemming, en tijd buiten wordt in verband gebracht met gezonde ogen."
          }
        }
      }
    },
    "insights.metric.totalBodyWater.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gesamtkörperwasser ist der Anteil deines Körpergewichts, der aus Flüssigkeit in und um die Zellen besteht. Es schwankt mit Flüssigkeitshaushalt, Ernährung und Aktivität, daher sagt der Trend über Wochen mehr aus als ein einzelner Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total body water is the share of your body weight made up of fluid, inside and around your cells. It shifts with hydration, food, and activity, so the trend over weeks tells you more than any single reading."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totaal lichaamswater is het deel van je lichaamsgewicht dat uit vocht bestaat, in en rond je cellen. Het schommelt met je vochtbalans, voeding en activiteit, dus de trend over weken zegt meer dan een losse meting."
          }
        }
      }
    },
    "insights.metric.vascularAge.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gefäßalter schätzt anhand der Arteriensteifigkeit, wie alt sich deine Arterien im Vergleich zu deinem tatsächlichen Alter verhalten. Ein Gefäßalter unter dem echten Alter deutet auf gesündere Blutgefäße hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vascular age estimates how old your arteries behave compared with your actual age, based on arterial stiffness. A vascular age below your real age suggests healthier blood vessels."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vaatleeftijd schat op basis van de stijfheid van je slagaders hoe oud je bloedvaten zich gedragen in vergelijking met je werkelijke leeftijd. Een vaatleeftijd onder je echte leeftijd wijst op gezondere bloedvaten."
          }
        }
      }
    },
    "insights.metric.visceralFat.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viszeralfett ist das Fett, das tief im Bauchraum um die Organe gespeichert wird. Anders als das Unterhautfett ist ein hoher Wert eng mit Herzkrankheiten und Typ-2-Diabetes verbunden, daher ist niedriger meist besser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visceral fat is the fat stored deep in the abdomen around your organs. Unlike fat under the skin, a high level is closely linked to heart disease and type 2 diabetes, so lower is generally better."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Visceraal vet is het vet dat diep in je buik rond je organen ligt opgeslagen. Anders dan vet onder de huid hangt een hoge waarde sterk samen met hart- en vaatziekten en diabetes type 2, dus lager is meestal beter."
          }
        }
      }
    },
    "insights.metric.vo2Max.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kardiofitness (VO₂max) schätzt, wie viel Sauerstoff dein Körper bei intensiver Anstrengung verwerten kann. Höhere Werte deuten in der Regel auf eine bessere Ausdauerfitness hin; die Apple Watch leitet sie aus deiner Herzfrequenz bei zügiger Aktivität ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio fitness (VO₂ max) estimates how much oxygen your body can use during hard exercise. Higher values generally indicate better aerobic fitness; Apple Watch derives it from your heart rate during brisk activity."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardiofitness (VO₂ max) schat hoeveel zuurstof je lichaam kan gebruiken bij zware inspanning. Hogere waarden wijzen meestal op een betere aerobe conditie. De Apple Watch berekent dit uit je hartslag tijdens stevige activiteit."
          }
        }
      }
    },
    "insights.metric.walkingAsymmetryPercentage.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gangasymmetrie ist der Anteil der Zeit, in der deine Schritte zwischen linkem und rechtem Bein ungleichmäßig sind. Ein höherer Prozentsatz kann auf Schmerzen, eine Verletzung oder ein Gangproblem hindeuten, das näher betrachtet werden sollte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking asymmetry is the share of time your steps are uneven between the left and right leg. A higher percentage can point to pain, injury, or a gait problem worth looking into."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopasymmetrie is het deel van de tijd waarin je stappen tussen je linker- en rechterbeen ongelijk zijn. Een hoger percentage kan wijzen op pijn, een blessure of een probleem met je looppatroon dat het bekijken waard is."
          }
        }
      }
    },
    "insights.metric.walkingDoubleSupportPercentage.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Doppelunterstützungszeit ist der Anteil jedes Gehzyklus, in dem beide Füße gleichzeitig den Boden berühren. Ein höherer Prozentsatz bedeutet meist ein vorsichtigeres, weniger stabiles Gangbild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double support time is the share of each walking cycle when both feet touch the ground at once. A higher percentage usually means a more cautious, less stable gait."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbelsteuntijd is het deel van elke loopcyclus waarin beide voeten tegelijk de grond raken. Een hoger percentage betekent meestal een voorzichtiger, minder stabiel looppatroon."
          }
        }
      }
    },
    "insights.metric.walkingHeartRateAverage.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Herzfrequenz beim Gehen ist dein durchschnittlicher Puls bei einem gleichmäßigen Spaziergang. Ein über die Zeit niedrigerer Wert spiegelt bei gleicher Anstrengung oft eine bessere Herz-Kreislauf-Fitness wider."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking heart rate is your average pulse during a steady walk. A lower walking rate over time often reflects improving cardiovascular fitness for the same effort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelhartslag is je gemiddelde hartslag tijdens een rustige wandeling. Een lagere wandelhartslag door de tijd heen wijst vaak op een betere conditie van hart en bloedvaten bij dezelfde inspanning."
          }
        }
      }
    },
    "insights.metric.walkingSpeed.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gehgeschwindigkeit ist, wie schnell du dich auf ebenem Untergrund fortbewegst. Sie ist ein gut untersuchter Marker für allgemeine Gesundheit und Beweglichkeit, und ein gleichbleibendes oder steigendes Tempo ist ein gutes Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walking speed is how fast you move on a level walk. It is a well-studied marker of overall health and mobility, and a steady or rising pace is a good sign."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopsnelheid is hoe snel je beweegt bij wandelen op vlak terrein. Het is een goed onderzochte graadmeter voor je algehele gezondheid en mobiliteit, en een gelijkblijvend of stijgend tempo is een goed teken."
          }
        }
      }
    },
    "insights.metric.walkingStepLength.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schrittlänge ist der durchschnittliche Abstand von einem Fußauftritt zum nächsten. Eine über die Zeit kürzere Schrittlänge kann Müdigkeit, Vorsicht oder eine veränderte Beweglichkeit widerspiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step length is the average distance from one footfall to the next. A shorter step over time can reflect fatigue, caution, or a change in mobility."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paslengte is de gemiddelde afstand tussen twee opeenvolgende voetstappen. Een kortere pas door de tijd heen kan wijzen op vermoeidheid, voorzichtigheid of een verandering in mobiliteit."
          }
        }
      }
    },
    "insights.metric.weight.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Körpergewicht ist eines der einfachsten Signale für die langfristige Energiebilanz und die allgemeine Gesundheit. Der Trend über Wochen zählt weit mehr als ein einzelner Wert, der mit Flüssigkeit, Ernährung und Tageszeit schwankt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body weight is one of the simplest signals of long-term energy balance and overall health. The trend over weeks matters far more than any single reading, which fluctuates with hydration, food, and time of day."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichaamsgewicht is een van de eenvoudigste signalen van je energiebalans op lange termijn en je algehele gezondheid. De trend over weken telt veel zwaarder dan een losse meting, die schommelt met vocht, voeding en het tijdstip van de dag."
          }
        }
      }
    },
    "insights.metric.wristTemperature.description": {
      "comment": "Insights — static per-metric definition (mirrors web insights.subPage.explainer)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Handgelenkstemperatur ist der hautseitige Wert, den die Apple Watch über Nacht aufzeichnet. Am aussagekräftigsten ist sie als Trend: Abweichungen von deinem eigenen Ausgangswert können mit Krankheit, Zyklusveränderungen oder Schlafumgebung einhergehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist temperature is the skin-side reading Apple Watch records overnight. It is most useful as a trend: shifts from your own baseline can accompany illness, cycle changes, or sleep environment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polstemperatuur is de meting aan de huidzijde die de Apple Watch 's nachts vastlegt. Ze is vooral nuttig als trend: afwijkingen van je eigen basiswaarde kunnen samengaan met ziekte, veranderingen in je cyclus of je slaapomgeving."
          }
        }
      }
    },
    "insights.overview.dailyBriefing.title": {
      "comment": "Insights overview — heading above the AI/narrative health-report prose. Operator rename (Task C): 'Tagesbriefing' reads cooler here than 'Aktuelle Einschätzung'.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesbriefing"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily briefing"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijkse briefing"
          }
        }
      }
    },
    "insights.overview.derived.preparing": {
      "comment": "Insights overview — derived wellness scores / assessment warming on a cold session.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschätzung wird erstellt…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing your assessment…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beoordeling wordt voorbereid…"
          }
        }
      }
