    "medications.composition.perUnitNote": {
      "comment": "SUPP #131: caption under the composition lines. Server wording medications.composition.perUnitNote.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Tablette oder Kapsel; jede genommene Dosis zählt in die Mikronährstoffe des Tages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tablet or capsule; every dose taken adds this to the day's micronutrients."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tablet of capsule; elke ingenomen dosis telt dit op bij de micronutriënten van die dag."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정제 또는 캡슐 1개 기준이며, 복용한 용량마다 그날의 미량영양소에 더해져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por comprimido o cápsula; cada dosis tomada se suma a los micronutrientes del día."
          }
        }
      }
    },
