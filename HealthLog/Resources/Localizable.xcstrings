    "settings.coach.insightsPrivacy.description": {
      "comment": "Settings → Coach — help text for the insights AI privacy-mode picker",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aggregiert“ schickt der KI nur zusammengefasste Trends. „Volle Details“ schickt auch einzelne Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggregated sends the AI summarised trends only. Full detail also sends individual values."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Samengevat” stuurt de AI alleen samengevatte trends. “Alle details” stuurt ook afzonderlijke waarden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집계를 선택하면 AI에 요약된 추세만 보내요. 전체 상세를 선택하면 개별 값도 보내요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Agregados, la IA solo recibe tendencias resumidas. Con Todo el detalle también recibe valores individuales."
          }
        }
      }
    },
