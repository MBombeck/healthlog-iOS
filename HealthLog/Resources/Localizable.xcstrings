        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han cerrado las demás sesiones e inicios de sesión en apps, y también los asistentes de IA conectados, los tokens de API y los enlaces compartidos con médicos. Este dispositivo sigue con la sesión iniciada."
          }
