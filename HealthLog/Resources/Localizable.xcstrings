            "value": "Held back and refused"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegengehouden en geweigerd"
          }
        }
      }
    },
    "settings.hkdiag.info.sources.server": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-Sicht fragt deinen Server jedes Mal frisch ab, wenn du die Seite öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server view asks your server afresh each time you open this page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De serverweergave vraagt je server telkens opnieuw als je deze pagina opent."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.session": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aktuelle Sitzung“ und „Pro Messgröße“ zählen auf diesem iPhone seit dem letzten App-Start und beginnen danach wieder bei null."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Current session” and “Per kind” count on this iPhone since the app last started, and start from zero again after every launch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Huidige sessie” en “Per soort” tellen op deze iPhone sinds de app het laatst is gestart, en beginnen na elke start weer bij nul."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.stored": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen Karten zeigen, was dieses iPhone über Neustarts hinweg gespeichert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other cards show what this iPhone has kept across launches."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle andere kaarten tonen wat deze iPhone over herstarts heen heeft bewaard."
          }
        }
      }
    },
    "settings.hkdiag.info.sources.title": {
      "comment": "1.4 B2-c: Sync Diagnostics info sheet, section title",
      "extractionState": "manual",
