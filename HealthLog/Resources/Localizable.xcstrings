            "state": "translated",
            "value": "Anmeldung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인"
          }
        }
      }
    },
    "settings.support.anchors_empty": {
      "comment": "08-15 — Leerzustand der Anker-Karte.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Sitzung ist noch kein Anker vorgerückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No anchor has advanced in this session yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In deze sessie is nog geen anker opgeschoven."
          }
        },
        "ko": {
