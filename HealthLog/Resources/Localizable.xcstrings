        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No type has reached the server yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen enkel type heeft de server bereikt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서버에 도달한 유형이 없어요."
          }
        }
      }
    },
    "settings.hkdiag.freshness_title": {
      "comment": "CU-21 — per-metric freshness sub-heading.",
      "extractionState": "manual",
      "localizations": {
