        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werte liegen außerhalb dessen, was der Coach lesen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These readings lie outside what the Coach may read."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze waarden liggen buiten wat de Coach mag lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 측정값은 코치가 읽을 수 있는 범위 밖에 있어요."
          }
        }
      }
    },
    "settings.applehealth.routes.footer.backfill": {
      "comment": "Footer of the workout route switch on a server that can attach routes to stored workouts (v1.47.1, POLISH-B B10).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neue Trainings. Solange es an ist, kannst du die Routen der letzten 12 Monate nachsenden. Ausschalten stoppt das Senden sofort. Schon gesendete Routen bleiben gespeichert, bis du das Training löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to new workouts. While it is on, you can also send the routes of the last 12 months. Switching it off stops sending right away. Routes already sent stay stored until you delete the workout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor nieuwe trainingen. Zolang het aan staat, kun je de routes van de afgelopen 12 maanden nasturen. Uitschakelen stopt het versturen meteen. Al verstuurde routes blijven bewaard tot je de training verwijdert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 운동에 적용돼요. 켜져 있는 동안에는 최근 12개월의 경로도 보낼 수 있어요. 끄면 바로 전송이 멈춰요. 이미 보낸 경로는 운동을 삭제할 때까지 저장된 채로 남아요."
          }
        }
      }
    },
    "settings.applehealth.routes.backfill.action": {
      "comment": "Button under the route switch: sends the routes of the last 12 months once (POLISH-B B10).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routen älterer Trainings senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send routes of older workouts"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Routes van oudere trainingen versturen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 운동의 경로 보내기"
          }
        }
      }
    },
    "settings.applehealth.routes.backfill.running": {
      "comment": "Line under the button while the pass for older workouts runs (POLISH-B B10).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Routen der letzten 12 Monate werden gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending the routes of the last 12 months."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De routes van de afgelopen 12 maanden worden verstuurd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 12개월의 경로를 보내는 중이에요."
          }
        }
      }
    },
    "settings.applehealth.routes.backfill.done %lld": {
      "comment": "Line under the button after the pass: how many stored workouts got their route (server status enriched) (POLISH-B B10).",
      "extractionState": "manual",
      "localizations": {
