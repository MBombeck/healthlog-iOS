          }
        }
      }
    },
    "The assistant can also add entries. Only grant this if you actually need it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent kann auch Einträge anlegen. Erlaube das nur, wenn du es wirklich brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant can also add entries. Only grant this if you actually need it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent kan ook registraties toevoegen. Sta dit alleen toe als je het echt nodig hebt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 기록을 추가할 수도 있어요. 꼭 필요할 때만 허용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente también puede añadir registros. Concede este permiso solo si de verdad lo necesitas."
          }
        }
      }
    },
    "The assistant can read your health record. It cannot change anything.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent kann deine Gesundheitsakte lesen. Ändern kann er nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant can read your health record. It cannot change anything."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent kan je gezondheidsdossier lezen. Hij kan niets wijzigen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 내 건강 기록을 읽을 수 있어요. 아무것도 변경할 수는 없어요."
          }
        },
        "es": {
