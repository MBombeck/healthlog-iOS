    "biomarker.editor.seed.footer": {
      "comment": "Biomarker editor — the seed pre-fills editable defaults, not fixed truth.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt Name, Einheit und Referenzbereich vor. Alles bleibt änderbar – Referenzbereiche unterscheiden sich je nach Labor, Geschlecht und Alter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-fills name, unit and reference range. Everything stays editable — reference ranges differ by lab, sex and age."
          }
        }
      }
    },
    "biomarker.editor.seed.label": {
      "comment": "Biomarker editor — seed catalog picker label.",
      "extractionState": "manual",
      "localizations": {
