        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertido a %1$@, permitido de %2$@ a %3$@"
          }
        }
      }
    },
    "settings.hkdiag.skipped_reason_out_of_range_band %@ %@": {
