    "mentalHealth.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Screening-Selbsttest, keine Diagnose. Ein hoher oder niedriger Wert bedeutet nicht, dass eine Erkrankung vorliegt oder nicht. Nur eine qualifizierte Fachperson kann eine Diagnose stellen. Bei Sorgen sprich bitte mit deiner Ärztin oder deinem Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a screening self-assessment, not a diagnosis. A high or low score does not mean you do or do not have a condition. Only a qualified health professional can diagnose. If you have concerns, please talk to your doctor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een zelftest voor screening, geen diagnose. Een hoge of lage score betekent niet dat je wel of geen aandoening hebt. Alleen een bevoegde zorgverlener kan een diagnose stellen. Maak je je zorgen, praat dan met je arts."
          }
        }
      }
    },
    "mentalHealth.error": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan. Probeer het opnieuw."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.error`, word for word."
    },
