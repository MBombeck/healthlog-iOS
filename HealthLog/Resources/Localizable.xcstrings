    "biomarker.editor.hidden.footer": {
      "comment": "Biomarker editor — what hiding does, and what it does not do.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgeblendeter Marker wird beim Erfassen nicht mehr angeboten. Seine bisherigen Werte bleiben erhalten."
