          "stringUnit": {
            "state": "translated",
            "value": "Je aanbieder ontvangt deze gegevens en verwerkt ze volgens zijn eigen privacybeleid."
          }
        }
      }
    },
    "Your saved report selection returned no data, so the server bundle is empty.": {
      "comment": "CU-13 — the unified sharing surface: server $everything came back empty although a report selection is saved",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherte Auswahl hat keine Daten geliefert. Das Server-Bundle ist leer."
