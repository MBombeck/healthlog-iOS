    "med.schedule.cadence.cyclic.explainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert täglich in den aktiven Wochen, schweigt in den Pausenwochen. Der Zyklus zählt ab dem Kursbeginn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fires every day during on-weeks, stays silent during off-weeks. The cycle counts from the course start."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert elke dag in de actieve weken en blijft stil in de pauzeweken. De cyclus telt vanaf de start van de behandeling."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용 주에는 매일 알리고, 휴약 주에는 알리지 않아요. 주기는 복용 시작일부터 계산해요."
          }
        }
