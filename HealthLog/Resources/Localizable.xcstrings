          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit duurt langer dan normaal. Je kunt wachten, of stoppen en het rapport op je iPhone laten lezen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소보다 오래 걸리고 있어요. 기다리거나, 취소하고 iPhone에서 결과지를 읽게 할 수 있어요."
          }
        }
      }
    },
    "labs.ocr.cancel": {
      "comment": "LAB-OCR: cancel a running read",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen abbrechen"
          }
