    "med.lifecycle.end.confirm.message": {
      "comment": "Build 6.2 — end-course confirm message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab heute werden keine weiteren Dosen mehr geplant. Du kannst das Enddatum später im Zeitplan wieder ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No further doses will be scheduled from today. You can change the end date later in the schedule."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf vandaag worden er geen doses meer ingepland. Je kunt de einddatum later in het schema wijzigen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 더 이상 복용 일정이 잡히지 않아요. 종료일은 나중에 일정에서 바꿀 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se programarán más dosis a partir de hoy. Puedes cambiar la fecha de fin más adelante en el horario."
          }
        }
      }
    },
