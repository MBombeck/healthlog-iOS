        }
      }
    },
    "A local Ollama or LM Studio instance is in use. The server has to reach this URL.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine lokale Ollama- oder LM-Studio-Instanz wird verwendet. Der Server muss diese URL erreichen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local Ollama or LM Studio instance is in use. The server has to reach this URL."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een lokale Ollama- of LM Studio-instantie gebruikt. De server moet deze URL kunnen bereiken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 Ollama 또는 LM Studio 인스턴스를 사용 중이에요. 서버가 이 URL에 접근할 수 있어야 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa una instancia local de Ollama o LM Studio. El servidor tiene que poder acceder a esta URL."
          }
        }
      }
    },
    "A rest phase has been running since %@. It frames this score, it does not change it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %@ läuft eine Ruhephase. Sie ordnet diesen Wert ein, sie verändert ihn nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rest phase has been running since %@. It frames this score, it does not change it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinds %@ loopt er een rustfase. Die plaatst deze score in context, maar verandert hem niet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 휴식 기간이 진행 중이에요. 이 점수를 해석하는 맥락일 뿐, 점수를 바꾸지는 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una fase de descanso en curso desde %@. Sirve de contexto para esta puntuación, no la cambia."
          }
        }
      }
    },
    "A rest phase is running. It frames this score, it does not change it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ruhephase läuft. Sie ordnet diesen Wert ein, sie verändert ihn nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rest phase is running. It frames this score, it does not change it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt een rustfase. Die plaatst deze score in context, maar verandert hem niet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 기간이 진행 중이에요. 이 점수를 해석하는 맥락일 뿐, 점수를 바꾸지는 않아요."
          }
