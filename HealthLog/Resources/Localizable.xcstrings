          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor te identifica a través del proveedor de identidad de tu organización. El inicio de sesión con contraseña y con llave de acceso está desactivado aquí."
          }
        }
      }
    },
