    "integration.sync.empty": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. outcome == empty: a completed run that found nothing new. A normal ending, never a failure.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig. Drüben gab es nichts Neues."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. There was nothing new over there."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar. Er was daar niets nieuws."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료했어요. 새로 가져올 항목이 없었어요."
          }
        }
      }
    },
    "integration.sync.failed": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. Fallback copy for a non-HLError failure of a manual sync.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
