        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorgestelde risicozones (< 4 %, 4 tot 8 %, > 8 %) uit cohortgegevens; geen behandeldoel."
          }
        }
      }
    },
    "sources.caveat.kroenke-2001-phq9": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
