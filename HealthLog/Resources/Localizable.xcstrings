    "illness.restMode.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're recovering, so be gentle with yourself. A gap here is expected and won't undo your progress."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erholst dich gerade, also sei nachsichtig mit dir. Eine Pause ist hier völlig in Ordnung und kostet dich keinen Fortschritt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent aan het herstellen, dus wees lief voor jezelf. Een pauze is hier normaal en maakt je vooruitgang niet ongedaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회복 중이니 무리하지 마세요. 이 기간에 기록이 비는 건 자연스러운 일이고, 지금까지의 성과가 사라지지 않아요."
          }
        }
      }
    },
    "illness.restMode.pill": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting"
          }
        },
