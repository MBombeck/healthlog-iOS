        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scannen is geannuleerd of mislukt. Probeer het opnieuw of kies een foto uit je fotobibliotheek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이 취소되었거나 실패했어요. 다시 시도하거나 사진 보관함에서 사진을 선택하세요."
