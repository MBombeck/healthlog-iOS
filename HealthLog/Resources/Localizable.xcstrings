            "value": "Dieser Schlüssel wurde abgelehnt. Prüfe ihn und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key was rejected. Check it and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel is geweigerd. Controleer hem en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 거부됐어요. 확인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha rechazado esa clave. Revísala e inténtalo de nuevo."
          }
        }
      }
    },
    "That model is unknown to your provider. Pick another in Settings.": {
