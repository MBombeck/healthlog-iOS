    "med.edit.autoMarkTaken.label": {
      "comment": "MED-PLUS: switch title (autoMarkTaken)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen automatisch erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record doses automatically"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doses automatisch registreren"
          }
        },
        "ko": {
