          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.crisis.resourcesTitle`, word for word; ko from server v1.47.0 messages `mentalHealth.crisis.resourcesTitle`, word for word."
    },
    "mentalHealth.crisis.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst das nicht allein durchstehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have to face this alone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hoeft dit niet alleen te doen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 견디지 않아도 돼요"
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.crisis.title`, word for word; ko from server v1.47.0 messages `mentalHealth.crisis.title`, word for word."
    },
