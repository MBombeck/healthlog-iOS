    "documents.managed.autoRead.description": {
      "comment": "Documents, as the guardian of a managed profile: what the automatic reading switch does.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Dokumente dieses Profils werden nach dem Hochladen gelesen und zusammengefasst. Du stimmst damit für das Profil zu. Gelesen wird mit dem Anbieter des Servers, nie mit deinem eigenen Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New documents of this profile are read and summarised after upload. You give the consent for the profile. Reading uses the server's provider, never your own key."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe documenten van dit profiel worden na het uploaden gelezen en samengevat. Je geeft daarmee toestemming voor het profiel. Er wordt gelezen met de aanbieder van de server, nooit met je eigen sleutel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필의 새 문서는 업로드 후 읽고 요약해요. 이 설정으로 프로필을 대신해 동의하게 돼요. 읽기에는 서버의 제공자를 쓰며, 내 키는 절대 쓰지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos nuevos de este perfil se leen y resumen tras subirlos. Tú das el consentimiento para el perfil. La lectura usa el proveedor del servidor, nunca tu propia clave."
          }
        }
      }
    },
