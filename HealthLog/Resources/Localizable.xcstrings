          }
        }
      }
    },
    "onboarding.webLogin.error.noSession": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Browser ist keine Anmeldung zustande gekommen. Bitte melde dich dort an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sign-in was completed in the browser. Please sign in there and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet ingelogd in de browser. Log daar in en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 완료된 로그인이 없어요. 브라우저에서 로그인한 뒤 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó ningún inicio de sesión en el navegador. Inicia sesión allí e inténtalo de nuevo."
          }
        }
      }
    },
    "onboarding.webLogin.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Bitte warte einen Moment und versuche es dann noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Please wait a moment and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Wacht even en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시도가 너무 많아요. 잠시 기다린 뒤 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de inicio de sesión. Espera un momento e inténtalo de nuevo."
          }
        }
      }
    },
    "onboarding.webLogin.error.staleSession": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Browser-Anmeldung ist nicht frisch genug. Bitte melde dich im Browser neu an. Direkt danach übernimmt die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser sign-in isn't fresh enough. Please sign in again in the browser. The app takes over right after."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je login in de browser is niet recent genoeg. Log opnieuw in in de browser. Daarna neemt de app het direct over."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 로그인이 오래되었어요. 브라우저에서 다시 로그인해 주세요. 그러면 바로 앱으로 이어져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu inicio de sesión en el navegador no es lo bastante reciente. Vuelve a iniciar sesión en el navegador. La app continúa justo después."
          }
        }
      }
    },
    "onboarding.webLogin.exchangeFailed": {
