    "labs.scan.choose.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere einen Laborbericht, um mehrere Werte auf einmal zu erfassen. Das Foto verlässt dein iPhone nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a paper lab report to read several readings at once. The photo never leaves your iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een foto van een papieren labrapport om meerdere metingen tegelijk in te lezen. De foto verlaat je iPhone nooit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 검사 결과지를 촬영하면 여러 측정값을 한 번에 읽을 수 있어요. 사진은 iPhone 밖으로 나가지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía un informe de laboratorio en papel para leer varios valores a la vez. La foto nunca sale de tu iPhone."
          }
        }
      }
    },
