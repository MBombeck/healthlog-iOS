        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adult step-count categories from pedometer studies; orientation only."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stappencategorieën voor volwassenen uit stappentellerstudies; alleen ter oriëntatie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만보계 연구에서 나온 성인 걸음 수 분류예요. 참고용이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Categorías de pasos para adultos de estudios con podómetro; solo orientativas."
          }
        }
      }
    },
    "sources.caveat.hirshkowitz-2015-nsf-sleep": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Expertenkonsens: 7 bis 9 h empfohlen für Erwachsene von 18 bis 64, 7 bis 8 h ab 65."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expert consensus: 7 to 9 h recommended for adults aged 18 to 64, 7 to 8 h for 65+."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consensus van experts: 7 tot 9 u aanbevolen voor volwassenen van 18 tot 64, 7 tot 8 u vanaf 65."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전문가 합의: 18~64세 성인은 7~9 h, 65세 이상은 7~8 h를 권장해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consenso de expertos: se recomiendan de 7 a 9 h para adultos de 18 a 64 años y de 7 a 8 h a partir de 65."
          }
        }
      }
    },
    "sources.caveat.cdc-nhanes": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "US-Bevölkerungserhebung; Mittelwerte und Streuungen sind keine persönlichen Ziele."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US population survey data; means and spreads are not personal targets."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens uit Amerikaans bevolkingsonderzoek; gemiddelden en spreidingen zijn geen persoonlijke doelen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미국 인구 조사 데이터예요. 평균과 분포는 개인 목표가 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
