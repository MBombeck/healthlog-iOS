    "mentalHealth.historyLoadErrorHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heißt nicht, dass keine Ergebnisse vorliegen. Die Liste konnte nur nicht abgerufen werden. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not mean you have no results. The list just could not be fetched. Try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit betekent niet dat je geen resultaten hebt. Alleen de lijst kon niet worden opgehaald. Probeer het opnieuw."
          }
        },
        "ko": {
