    "coachMemory.empty.message": {
      "comment": "1.4 B2-c: Coach memory empty state message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Assistent beim Chatten über dich aufschnappt, erscheint hier, und du kannst jeden Eintrag wieder vergessen lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the assistant picks up while you chat shows up here, and you can make it forget any of it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de assistent tijdens het chatten over je oppikt, verschijnt hier, en je kunt hem alles weer laten vergeten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화하면서 어시스턴트가 알게 된 내용이 여기에 표시되고, 원하는 내용은 잊게 할 수 있어요."
