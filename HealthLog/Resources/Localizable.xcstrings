    "illness.correlation.recoveryGap.driver": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was the last to settle back into its usual range."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kehrte als Letztes in den gewohnten Bereich zurück."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keerde als laatste terug naar het gebruikelijke bereik."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
