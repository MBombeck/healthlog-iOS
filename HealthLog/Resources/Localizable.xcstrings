    "customMetric.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine eigene Metrik an, um Werte zu erfassen, die es als Standardtyp nicht gibt, etwa Griffkraft, Trainingsgewicht oder einen persönlichen Score."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Define your own metric to track values that have no built-in type, such as grip strength, training weight, or a personal score."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definieer je eigen meetwaarde om waarden bij te houden waarvoor geen standaardtype bestaat, zoals knijpkracht, trainingsgewicht of een persoonlijke score."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "악력, 운동 중량, 개인 점수처럼 기본 유형이 없는 값을 추적하려면 나만의 지표를 정의하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define tu propia medición para seguir valores que no tienen un tipo integrado, como la fuerza de agarre, el peso de entrenamiento o una puntuación personal."
          }
        }
      }
    },
