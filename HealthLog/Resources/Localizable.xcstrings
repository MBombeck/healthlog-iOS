        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste beoordeling van de server is te oud om nog te tonen. De actuele verschijnt hier zodra er weer verbinding is."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 마지막 평가가 너무 오래되어 더 이상 표시할 수 없어요. 다시 연결되면 최신 평가가 바로 여기에 표시돼요."
          }
        }
      }
    },
