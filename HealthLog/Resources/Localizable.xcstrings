    "med.inventory.expiry.rule.firstUseClock": {
      "comment": "CU-23 / B2 (server v1.33.0) - expiry rule caption for PEN and AMPOULE: the printed date and the 30-day-after-opening clock both apply.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pen und Ampulle verfallen am aufgedruckten Datum oder 30 Tage nach dem Anbruch, je nachdem, was zuerst eintritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pens and ampoules expire on the printed date or 30 days after opening, whichever comes first."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pennen en ampullen vervallen op de gedrukte datum of 30 dagen na het openen, afhankelijk van wat het eerst komt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펜과 앰플은 표기된 날짜와 개봉 후 30일 중 먼저 오는 날에 만료돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plumas y ampollas caducan en la fecha impresa o 30 días después de abrirlas, lo que ocurra primero."
          }
        }
      }
    },
    "med.inventory.expiry.rule.printedOnly": {
      "comment": "CU-23 / B2 (server v1.33.0) - expiry rule caption for BLISTER, INHALER, BOTTLE and OTHER: only the printed date applies, no opening clock.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Behälter verfällt ausschließlich am aufgedruckten Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This container expires on the printed date only."
