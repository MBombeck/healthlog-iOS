    "settings.cycle.optin.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Periode, Symptome, Basaltemperatur und mehr. Fügt dem Erfassen-Menü die Option „Zyklus“ hinzu und synchronisiert mit Apple Health."
