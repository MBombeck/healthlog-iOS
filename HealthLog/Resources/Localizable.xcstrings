    "illness.correlation.recoveryGap.value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vitals took about %@ days to return to baseline after you felt better."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Vitalwerte brauchten etwa %@ Tage, um nach dem Besserwerden zum Ausgangswert zurückzukehren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vitale waarden hadden ongeveer %@ dagen nodig om terug te keren naar je basiswaarde nadat je je beter voelde."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸이 나아진 뒤 활력 징후가 기준선으로 돌아오기까지 약 %@일 걸렸어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus constantes tardaron unos %@ días en volver a su valor de referencia después de que te sintieras mejor."
          }
        }
      }
    },
    "illness.correlation.redFlags.detail %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
