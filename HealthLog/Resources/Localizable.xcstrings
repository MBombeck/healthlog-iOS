    "focus.filter.card.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge HealthLog in den iOS-Einstellungen > Fokus als Filter zu einem beliebigen Fokus (Schlaf, Arbeit …) hinzu. Solange dieser Fokus aktiv ist, hält HealthLog Routine-Erinnerungen zurück (Medikamenten-Backups, den Stimmungs-Hinweis, Vorsorge-Erinnerungen, Nachschub-Hinweise) und optional Coach-Hinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add HealthLog as a filter to any Focus (Sleep, Work …) in iOS Settings > Focus. While that Focus is on, HealthLog holds back routine reminders (medication backups, the mood nudge, preventive-care reminders, low-supply heads-ups) and optionally coach nudges."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg HealthLog als filter toe aan een Focus naar keuze (Slaap, Werk …) via Instellingen > Focus in iOS. Zolang die Focus aanstaat, houdt HealthLog routineherinneringen tegen (back-upherinneringen voor medicijnen, de stemmingsherinnering, herinneringen voor preventieve zorg, meldingen over een bijna lege voorraad) en optioneel ook coachtips."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 > 집중 모드에서 원하는 집중 모드(수면, 업무 …)에 HealthLog를 필터로 추가하세요. 그 집중 모드가 켜져 있는 동안 HealthLog는 일상적인 알림(복약 백업 알림, 기분 알림, 예방 관리 알림, 재고 부족 알림)을 보류하고, 선택하면 코치 알림도 보류해요."
          }
        }
      }
    },
    "focus.filter.card.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dringende Gesundheitswarnungen wie kritische Medikamenten-Alarme und „Arzt aufsuchen“-Eskalationen werden von einem Fokus-Filter nie zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Urgent health alerts, such as critical medication alarms and “seek care” escalations, are never held back by a Focus filter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dringende gezondheidsmeldingen, zoals kritieke medicijnalarmen en oproepen om zorg te zoeken, worden nooit door een Focusfilter tegengehouden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴급 복약 알람이나 “진료 필요” 안내 같은 긴급 건강 알림은 집중 모드 필터로 보류되지 않아요."
          }
        }
      }
    },
    "focus.filter.card.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Filter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus filter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focusfilter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드 필터"
          }
        }
      }
    },
    "focus.filter.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dieser Fokus aktiv ist, hält HealthLog Routine-Erinnerungen und Coach-Hinweise zurück. Dringende Gesundheitswarnungen kommen weiterhin durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this Focus is on, HealthLog holds back routine reminders and coach nudges. Urgent health alerts still come through."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang deze Focus aanstaat, houdt HealthLog routineherinneringen en coachtips tegen. Dringende gezondheidsmeldingen komen gewoon door."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집중 모드가 켜져 있는 동안 HealthLog는 일상적인 알림과 코치 알림을 보류해요. 긴급 건강 알림은 계속 받아요."
          }
        }
      }
    },
    "focus.filter.param.pauseCoach.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Coach-Hinweise pausieren"
