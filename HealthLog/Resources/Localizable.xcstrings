    "customMetric.list.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Metriken werden nicht mit Apple Health synchronisiert. In die Zusammenhangs-Analyse fließen sie nur ein, wenn du das bei der Metrik einschaltest."
          }
        },
        "en": {
          "stringUnit": {
