    "illness.optIn.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a private journal of illnesses, injuries and ongoing conditions. You turned it off — turn it back on here whenever you like."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe ein privates Tagebuch über Erkrankungen, Verletzungen und anhaltende Beschwerden. Du hast es ausgeschaltet — schalte es hier jederzeit wieder ein."
          }
        }
      }
    },
