    "notif.padReminders.body": {
      "comment": "Explains which device reminds when an iPad and an iPhone share the account.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen kommen auf deinem iPhone. Dieses iPad bleibt still, damit nichts doppelt erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders arrive on your iPhone. This iPad stays quiet so nothing shows up twice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen komen op je iPhone. Deze iPad blijft stil, zodat niets dubbel verschijnt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 iPhone에서 와요. 같은 알림이 두 번 뜨지 않도록 이 iPad는 조용히 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios llegan a tu iPhone. Este iPad no avisa para que nada aparezca dos veces."
          }
        }
      }
    },
    "notif.padReminders.toggle": {
      "comment": "Local switch that makes the iPad plan its own reminders in addition to the iPhone.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch auf diesem iPad erinnern"
          }
