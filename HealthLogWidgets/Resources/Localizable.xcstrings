    "la.med.action.taken.confirm": {
      "comment": "Live Activity — armed two-step confirm label: second tap records the dose",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut tippen zum Bestätigen"
