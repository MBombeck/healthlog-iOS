    "labs.ocr.limit.truncated": {
      "comment": "LAB-OCR limit: the read stopped at its output limit",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht wurde nur zum Teil gelesen. Werte am Ende können fehlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report was only partly read. Readings near the end may be missing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport is maar gedeeltelijk gelezen. Waarden aan het einde kunnen ontbreken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과지를 일부만 읽었어요. 끝부분의 측정값이 빠졌을 수 있어요."
          }
        },
        "es": {
