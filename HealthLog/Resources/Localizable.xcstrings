      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dosis wird auch beim Medikament erfasst. Bedarfsmedikation zählt nicht zur Therapietreue."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dose is also recorded on the medication. As-needed medication does not count towards adherence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dosis wordt ook bij het medicijn vastgelegd. Zo-nodig-medicatie telt niet mee voor de therapietrouw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투여 기록은 해당 약에도 남아요. 필요시 약은 복약 순응도에 포함되지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dosis también se registra en el medicamento. La medicación a demanda no cuenta para la adherencia."
