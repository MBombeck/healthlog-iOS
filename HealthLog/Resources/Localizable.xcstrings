    "anamnesis.action.remove": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Closes the current revision without recording a successor.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angabe entfernen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove entry"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registratie verwijderen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 제거"
          }
        }
      }
    },
    "anamnesis.error.conflict": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 anamnesis.fact.conflict — a concurrent write closed the row between the guard and the update.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angabe wurde zwischenzeitlich an anderer Stelle geändert. Wir haben den aktuellen Stand neu geladen. Prüfe ihn und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry changed elsewhere in the meantime. We reloaded the current state. Check it and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze registratie is intussen ergens anders gewijzigd. We hebben de actuele stand opnieuw geladen. Controleer die en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목이 그사이 다른 곳에서 변경됐어요. 현재 상태를 다시 불러왔어요. 확인 후 다시 시도해 주세요."
          }
        }
      }
    },
    "anamnesis.error.currentExists": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 anamnesis.fact.currentExists — a current value already exists, so PATCH is the right verb.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Angabe gibt es bereits einen aktuellen Wert. Wir haben neu geladen. Korrigiere ihn, statt ihn neu anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry already has a current value. We reloaded. Correct it instead of creating a new one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze registratie heeft al een actuele waarde. We hebben opnieuw geladen. Corrigeer die in plaats van een nieuwe aan te maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목에는 이미 현재 값이 있어요. 다시 불러왔어요. 새로 만들지 말고 기존 값을 수정해 주세요."
          }
        }
      }
    },
    "anamnesis.error.dismiss": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Accessibility label of the write-error banner's close button.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldung ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss message"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bericht sluiten"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 닫기"
          }
        }
      }
    },
    "anamnesis.error.inFlight": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 409 from the idempotency wrapper (the one whose `error` is an object, not a string).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Angabe läuft bereits eine Anfrage. Warte einen Moment und versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request for this entry is already running. Wait a moment and try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een verzoek voor deze registratie. Wacht even en probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목에 대한 요청이 이미 진행 중이에요. 잠시 기다린 후 다시 시도해 주세요."
          }
        }
      }
    },
    "anamnesis.error.invalidValue": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 422 anamnesis.fact.invalidValue — the value does not belong to this fact kind.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wert passt nicht zu dieser Angabe. Wähle einen der angebotenen Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That value doesn't belong to this entry. Pick one of the offered values."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die waarde past niet bij deze registratie. Kies een van de aangeboden waarden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 값은 이 항목에 해당하지 않아요. 제시된 값 중 하나를 선택해 주세요."
          }
        }
      }
    },
    "anamnesis.error.stale": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). 404 — the revision id in the path is no longer the current one.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fassung ist nicht mehr die aktuelle. Wir haben neu geladen. Versuche es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version is no longer the current one. We reloaded. Try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
