    "labs.ocr.limit.stoppedBudget": {
      "comment": "LAB-OCR limit: stoppedBy budget",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen hat früher aufgehört, weil das Kontingent für heute aufgebraucht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading stopped early because today's allowance is used up."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lezen is eerder gestopt omdat het tegoed voor vandaag op is."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 사용량을 다 써서 읽기가 일찍 중단됐어요."
          }
        }
      }
    },
    "labs.ocr.limit.stoppedUnavailable": {
      "comment": "LAB-OCR limit: stoppedBy unavailable",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen hat früher aufgehört, weil das Lesen von Dokumenten inzwischen ausgeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading stopped early because reading documents has been switched off in the meantime."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lezen is eerder gestopt omdat het lezen van documenten inmiddels is uitgeschakeld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그사이 문서 읽기가 꺼져서 읽기가 일찍 중단됐어요."
          }
        }
      }
    },
    "labs.ocr.limit.stoppedError": {
      "comment": "LAB-OCR limit: stoppedBy error",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen hat früher aufgehört, weil eine Prüfung unterwegs nicht geklappt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading stopped early because a check along the way did not work."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lezen is eerder gestopt omdat een controle onderweg niet lukte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
