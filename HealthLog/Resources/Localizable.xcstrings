    "WHOOP access was declined. Connect again to grant access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der WHOOP-Zugriff wurde abgelehnt. Verbinde erneut, um den Zugriff zu erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP access was declined. Connect again to grant access."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot WHOOP is geweigerd. Maak opnieuw verbinding om toegang te geven."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP 접근이 거부됐어요. 접근을 허용하려면 다시 연결하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el acceso a WHOOP. Vuelve a conectar para conceder el acceso."
          }
        }
      }
    },
    "WHOOP connection failed. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die WHOOP-Verbindung ist fehlgeschlagen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP connection failed. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding met WHOOP mislukt. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP 연결에 실패했어요. 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con WHOOP. Inténtalo de nuevo."
          }
        }
      }
    },
    "WHOOP is rate-limiting requests. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP drosselt gerade Anfragen. Versuche es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP is rate-limiting requests. Try again in a moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP beperkt momenteel het aantal verzoeken. Probeer het zo opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP에서 요청을 제한하고 있어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP está limitando las solicitudes. Inténtalo de nuevo en un momento."
          }
        }
      }
    },
    "WHOOP rate-limited the connection and paused syncing. Resume to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP hat die Verbindung gedrosselt und die Synchronisierung pausiert. Zum Fortfahren fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP rate-limited the connection and paused syncing. Resume to continue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP heeft de verbinding beperkt en de synchronisatie gepauzeerd. Hervat om door te gaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP에서 연결을 제한해 동기화가 일시 중지됐어요. 계속하려면 재개하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP limitó la conexión y pausó la sincronización. Reanúdala para continuar."
          }
        }
      }
    },
    "WHOOP rejected these credentials. Check the Client ID and Secret.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP hat diese Zugangsdaten abgelehnt. Prüfe Client-ID und Secret."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP rejected these credentials. Check the Client ID and Secret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP heeft deze inloggegevens geweigerd. Controleer de client-ID en het secret."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP에서 이 자격 증명을 거부했어요. Client ID와 Secret을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP rechazó estas credenciales. Revisa el Client ID y el Secret."
          }
