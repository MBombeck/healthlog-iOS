    "labs.ocr.processing": {
      "comment": "LAB-OCR: while the report is read",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht wird gelesen. Das kann eine Minute dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the report. This can take a minute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport wordt gelezen. Dat kan een minuut duren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과지를 읽고 있어요. 1분 정도 걸릴 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyendo el informe. Puede tardar un minuto."
          }
