    "auth.passkey.error.rejected": {
      "comment": "Sign-in — the server refused the passkey assertion (401/404/422 on /api/auth/passkey/login-verify). Not an expired session.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat diesen Passkey nicht angenommen. Falls du ihn aus deinem Konto entfernt hast, melde dich stattdessen mit deinem Passwort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn't accept this passkey. If you removed it from your account, sign in with your password instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft deze toegangssleutel niet geaccepteerd. Als je hem uit je account hebt verwijderd, log dan in met je wachtwoord."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 패스키를 받아들이지 않았어요. 계정에서 패스키를 삭제했다면 비밀번호로 로그인해 주세요."
          }
        }
      }
    },
    "auth.passkey.error.ssoOnly": {
      "comment": "Sign-in — 403 oidc_only on a passkey leg",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Passkey ist auf diesem Server abgeschaltet. Melde dich stattdessen per SSO an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey sign-in is turned off on this server. Sign in with SSO instead."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met een toegangssleutel is uitgeschakeld op deze server. Log in plaats daarvan in met SSO."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에서는 패스키 로그인이 꺼져 있어요. SSO로 로그인해 주세요."
          }
        }
      }
    },
    "auth.passkey.error.invalidChallenge": {
      "comment": "Sign-in — the passkey challenge from the server could not be decoded",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine ungültige Passkey-Anfrage geschickt. Bitte versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent an invalid passkey request. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft een ongeldig verzoek voor een toegangssleutel gestuurd. Probeer het opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 잘못된 패스키 요청을 보냈어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "auth.passkey.error.noWindow": {
      "comment": "Sign-in — no window to present the system passkey sheet on",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
