    "insights.recovery.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strain, heart rate and energy expenditure appear here once a wearable like WHOOP or Polar reports them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belastung, Herzfrequenz und Energieumsatz erscheinen hier, sobald ein Wearable wie WHOOP oder Polar sie liefert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Belasting, hartslag en energieverbruik verschijnen hier zodra een wearable zoals WHOOP of Polar ze doorgeeft."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOOP이나 Polar 같은 웨어러블 기기가 부하, 심박수, 에너지 소모량을 보내면 여기에 표시돼요."
          }
        }
      },
      "comment": "1.4 B3 — Recovery empty-state body when the server reports no wearable reading (recoveryEmpty). One sentence; it names what the page shows and never denies the overview's recovery score."
    },
    "insights.recovery.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wearable readings yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Wearable-Werte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen metingen van een wearable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 웨어러블 측정값이 없어요"
          }
        }
      },
      "comment": "W-B189 #23 — Recovery empty-state title. K1: names what is missing (device signals), because the overview can show a recovery score at the same time."
    },
