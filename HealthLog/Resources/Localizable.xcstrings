          }
        }
      }
    },
    "settings.support.entry_footer": {
      "comment": "08-15 — Footer der Einstiegskarte: wofuer die Detailseite da ist und dass sie nichts von selbst zeigt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische Werte für ein Support-Gespräch. Sie werden erst nach einer ausdrücklichen Bestätigung angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical values for a support conversation. They appear only after you confirm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Technische waarden voor een gesprek met support. Ze worden pas getoond nadat je dat bevestigt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원 문의용 기술 정보예요. 확인한 뒤에만 표시돼요."
          }
        }
      }
    },
    "settings.support.gate_body": {
      "comment": "08-15 — Untertitel der Bestaetigungskarte: was eine Sitzung zeigt und wie lange sie gilt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt gekürzte technische Werte zu Zustellung und Synchronisierung. Die Sitzung endet, sobald du diese Seite verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows shortened technical values about delivery and sync. The session ends as soon as you leave this page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont ingekorte technische waarden over levering en synchronisatie. De sessie eindigt zodra je deze pagina verlaat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송과 동기화에 관한 기술 정보를 줄여서 보여 줘요. 이 페이지를 나가면 세션이 바로 끝나요."
          }
        }
      }
    },
    "settings.support.gate_cancel": {
      "comment": "08-15 — Zweiter Schritt abgelehnt; zurueck in den gesperrten Zustand.",
      "extractionState": "manual",
      "localizations": {
