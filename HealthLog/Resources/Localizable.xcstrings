    "integration.health.reason.permissionLimited": {
      "comment": "#139 — health.reason permission_limited.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft, aber für einige Datentypen fehlt die Freigabe. Verbinde neu, um sie zu erteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works, but some data types are not permitted. Reconnect to grant them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt, maar voor sommige gegevenstypen is geen toestemming gegeven. Koppel opnieuw om ze toe te staan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작동하지만, 일부 데이터 유형이 허용되지 않았어요. 다시 연결해서 권한을 허용해 주세요."
