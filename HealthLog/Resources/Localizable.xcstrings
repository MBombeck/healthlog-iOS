    "settings.support.gate_body": {
      "comment": "08-15 — Untertitel der Bestaetigungskarte: was eine Sitzung zeigt und wie lange sie gilt.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt gekürzte technische Werte zu Zustellung und Synchronisierung. Die Sitzung endet, sobald du diese Seite verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows shortened technical values about delivery and sync. The session ends as soon as you leave this page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont ingekorte technische waarden over levering en synchronisatie. De sessie eindigt zodra je deze pagina verlaat."
          }
        }
      }
    },
    "settings.support.gate_cancel": {
