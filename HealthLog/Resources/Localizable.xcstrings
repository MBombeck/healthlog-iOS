    "notif.padReminders.footer": {
      "comment": "Footer of the iPad reminder card: the seven day takeover rule.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein iPhone eine Woche lang nicht gesehen wurde, übernimmt das iPad von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your iPhone has not been seen for a week, the iPad takes over by itself."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iPhone een week niet is gezien, neemt de iPad het vanzelf over."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 일주일 동안 보이지 않으면 iPad가 자동으로 이어받아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu iPhone no se ha visto en una semana, el iPad toma el relevo automáticamente."
          }
        }
      }
    },
    "notif.padReminders.bodyOn": {
      "comment": "Body of the iPad reminder card while the switch is on.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen kommen auf deinem iPhone und auch auf diesem iPad. Dieselbe Dosis kann dadurch zweimal erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders arrive on your iPhone and on this iPad as well. The same dose can therefore show up twice."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen komen op je iPhone en ook op deze iPad. Dezelfde dosis kan daardoor twee keer verschijnen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 iPhone과 이 iPad 모두에 와요. 그래서 같은 복용 알림이 두 번 뜰 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios llegan a tu iPhone y también a este iPad. Por eso la misma dosis puede aparecer dos veces."
          }
        }
      }
    },
