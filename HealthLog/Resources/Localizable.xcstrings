    "account.deletionPending.signIn %@": {
      "comment": "Sign-in refused: account locked inside its deletion grace window; %@ is the erasure date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wird am %@ gelöscht und ist bis dahin gesperrt. Ein Admin kann die Löschung vor diesem Datum rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion on %@ and is locked until then. An admin can undo the deletion before that date."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account wordt op %@ verwijderd en is tot dan vergrendeld. Een beheerder kan het verwijderen voor die datum ongedaan maken."
          }
        }
      }
    },
    "account.deletionPending.signIn.noDate": {
      "comment": "Sign-in refused: account pending deletion, no date known",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist zur Löschung vorgemerkt und gesperrt. Ein Admin kann die Löschung rückgängig machen, bis sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is scheduled for deletion and is locked. An admin can undo the deletion until it completes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account staat gepland voor verwijdering en is vergrendeld. Een beheerder kan het verwijderen ongedaan maken tot het is afgerond."
          }
        }
      }
    },
    "account.deleted.receipt.scheduled %@": {
      "comment": "Alert after deletion with a grace window; %@ is the erasure date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist gesperrt und wird am %@ endgültig gelöscht. Bis dahin kann ein Admin die Löschung rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is locked and will be deleted for good on %@. Until then an admin can undo the deletion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account is vergrendeld en wordt op %@ definitief verwijderd. Tot die tijd kan een beheerder het verwijderen ongedaan maken."
          }
        }
      }
    },
    "account.deleted.receipt.now": {
      "comment": "Alert after an immediate deletion",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und alle Daten wurden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and all its data have been deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account en al je gegevens zijn verwijderd."
          }
        }
      }
    },
    "deleteAccount.grace.intro": {
      "comment": "Delete account intro when the server keeps a grace window",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du fortfährst, wird dein Konto sofort gesperrt und danach mit allen Daten endgültig gelöscht:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you continue, your account is locked right away and then deleted for good with all your data:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je doorgaat, wordt je account meteen vergrendeld en daarna met al je gegevens definitief verwijderd:"
          }
        }
      }
    },
    "deleteAccount.grace.date %@": {
      "comment": "Delete account bullet; %@ is the expected erasure date",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig gelöscht wird alles am %@. Bis dahin ist dein Konto gesperrt und ein Admin kann die Löschung rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is deleted for good on %@. Until then your account is locked and an admin can undo the deletion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt op %@ definitief verwijderd. Tot die tijd is je account vergrendeld en kan een beheerder het verwijderen ongedaan maken."
          }
        }
      }
    },
    "deleteAccount.grace.unknown": {
      "comment": "Delete account bullet when the grace window length is unknown",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig gelöscht wird alles nach einer Frist, die dein Admin festlegt. Bis dahin ist dein Konto gesperrt und ein Admin kann die Löschung rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is deleted for good after a waiting period your admin sets. Until then your account is locked and an admin can undo the deletion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wordt definitief verwijderd na een wachttijd die je beheerder bepaalt. Tot die tijd is je account vergrendeld en kan een beheerder het verwijderen ongedaan maken."
          }
        }
      }
    },
    "deleteAccount.grace.consent": {
      "comment": "Delete account consent toggle with a grace window",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
