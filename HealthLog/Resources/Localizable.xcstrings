    "notif.lockscreen.hideName.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen und die Live-Aktivität zeigen dann eine allgemeine Bezeichnung statt des Medikamentennamens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
