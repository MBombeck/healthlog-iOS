    },
    "Your provider receives this data and handles it under their own privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter erhält diese Daten und verarbeitet sie gemäß seiner eigenen Datenschutzrichtlinie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
