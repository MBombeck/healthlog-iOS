          }
        }
      }
    },
    "integration.oauth.howItWorks": {
      "comment": "How-it-works explainer on the Oura/Polar/Fitbit OAuth integration detail screen — describes the server-brokered connect flow and where data flows.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Verbinden öffnet sich eine sichere Anmeldung im Browser. HealthLog sieht dein Konto-Passwort nie — der Anbieter übergibt dem Server ein widerrufbares Zugriffstoken. Danach werden die Daten des Anbieters über den Server synchronisiert und erscheinen hier automatisch. Trenne die Verbindung jederzeit, um den Zugriff zu widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting opens a secure sign-in in your browser. HealthLog never sees your account password — the provider hands the server a revocable access token. From then on the provider's data syncs through the server and appears here automatically. Disconnect anytime to revoke access."
          }
        }
      }
    },
    "integration.sync.button": {
      "comment": "CU-35 (1) — manual sync trigger POST /api/{oura,polar,strava,nightscout}/sync. Button that asks the server to pull from the provider now.",
