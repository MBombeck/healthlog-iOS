    "Your server uses a different relay than this app, so the relay is not available here.": {
      "comment": "#190 §9 Settings line when push.relay.host differs from the build's relay host.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server nutzt ein anderes Relay als diese App, deshalb steht das Relay hier nicht zur Verfügung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server uses a different relay than this app, so the relay is not available here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server gebruikt een andere relay dan deze app, daarom is de relay hier niet beschikbaar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 앱과 다른 릴레이를 사용하므로 여기서는 릴레이를 쓸 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor usa un relay distinto al de esta app, así que el relay no está disponible aquí."
          }
        }
      }
    },
    "The relay can no longer reach this device for this server. Reinstalling HealthLog brings it back.": {
      "comment": "#190 §4 Settings line when the relay keeps a block it cannot lift (relayState none right after turn-on).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Relay erreicht dieses Gerät für diesen Server nicht mehr. Nach einer Neuinstallation von HealthLog geht es wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay can no longer reach this device for this server. Reinstalling HealthLog brings it back."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De relay bereikt dit apparaat voor deze server niet meer. Na een herinstallatie van HealthLog werkt het weer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴레이가 이 서버에 대해 더 이상 이 기기에 연결할 수 없습니다. HealthLog를 다시 설치하면 다시 됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay ya no puede llegar a este dispositivo para este servidor. Si reinstalas HealthLog, vuelve a funcionar."
          }
        }
      }
    },
