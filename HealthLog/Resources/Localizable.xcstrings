            "state": "translated",
            "value": "https:// wird automatisch ergänzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// is added automatically."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// wordt automatisch toegevoegd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https://는 자동으로 붙어요."
          }
        },
