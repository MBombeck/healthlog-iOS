    "settings.integrations.healthapp_hint": {
      "comment": "BUG-HK-CONNECT — explainer text shown when iOS dismissed the auth sheet silently because every missing type is already denied; offered together with the 'In Apple Health öffnen' deep-link CTA.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat den Dialog sofort wieder geschlossen: über die fehlenden Typen ist bereits entschieden, und iOS fragt kein zweites Mal danach. Ändern lässt sich das nur in Apple Health, dort über dein Profilbild > Datenschutz > Apps > HealthLog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple dismissed the sheet immediately: the missing types are already decided, and iOS never asks about the same type twice. The only place left to change this is Apple Health, under your profile picture > Privacy > Apps > HealthLog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple heeft het venster meteen gesloten: over de ontbrekende typen is al beslist en iOS vraagt nooit twee keer naar hetzelfde type. Je kunt dit alleen nog wijzigen in Apple Health, via je profielfoto > Privacy > Apps > HealthLog."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 시트를 바로 닫았어요. 누락된 유형은 이미 결정되어 있고, iOS는 같은 유형을 두 번 묻지 않아요. 이제 Apple Health의 프로필 사진 > 개인정보 보호 > 앱 > HealthLog에서만 변경할 수 있어요."
          }
        }
      }
    },
