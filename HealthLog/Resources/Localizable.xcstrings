    "nutrients.energyBalance.estimated.one": {
      "comment": "Energy balance: one day rests on an estimated resting energy",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An einem dieser Tage ist die Ruheenergie eine Schätzung aus Gewicht, Größe, Alter und Geschlecht (Mifflin-St Jeor), weil kein Messwert ankam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On one of these days resting energy is an estimate from your weight, height, age and sex (Mifflin-St Jeor), because no reading arrived."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op één van deze dagen is de rustenergie een schatting uit gewicht, lengte, leeftijd en geslacht (Mifflin-St Jeor), omdat er geen meting binnenkwam."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 중 하루는 측정값이 없어 휴식 에너지를 체중, 키, 나이, 성별로 추정했어요(Mifflin-St Jeor)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En uno de estos días la energía en reposo es una estimación a partir de tu peso, altura, edad y sexo (Mifflin-St Jeor), porque no llegó ninguna lectura."
          }
        }
      }
    },
    "nutrients.energyBalance.estimated %lld": {
      "comment": "Energy balance: number of days (2 or more) whose resting energy is estimated",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %lld dieser Tage ist die Ruheenergie eine Schätzung aus Gewicht, Größe, Alter und Geschlecht (Mifflin-St Jeor), weil kein Messwert ankam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %lld of these days resting energy is an estimate from your weight, height, age and sex (Mifflin-St Jeor), because no reading arrived."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op %lld van deze dagen is de rustenergie een schatting uit gewicht, lengte, leeftijd en geslacht (Mifflin-St Jeor), omdat er geen meting binnenkwam."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 중 %lld일은 측정값이 없어 휴식 에너지를 체중, 키, 나이, 성별로 추정했어요(Mifflin-St Jeor)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %lld de estos días la energía en reposo es una estimación a partir de tu peso, altura, edad y sexo (Mifflin-St Jeor), porque no llegó ninguna lectura."
          }
        }
      }
    },
    "nutrients.energyBalance.needsProfile": {
      "comment": "Energy balance: no headline because the resting estimate lacks profile data",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahme ist da, aber keine Ruheenergie kam an. Trag Größe, Geburtsdatum und Geschlecht im Profil ein und erfasse ein Gewicht, dann wird die Bilanz geschätzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your intake is here, but no resting energy arrived. Add your height, date of birth and sex to your profile, with a weight reading, and the balance is estimated."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je inname is er, maar er kwam geen rustenergie binnen. Vul lengte, geboortedatum en geslacht in je profiel in, met een gewichtsmeting, en de balans wordt geschat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섭취량은 있지만 휴식 에너지가 들어오지 않았어요. 프로필에 키, 생년월일, 성별을 추가하고 체중을 기록하면 균형이 추정돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ingesta está aquí, pero no llegó energía en reposo. Añade tu altura, fecha de nacimiento y sexo al perfil, con una lectura de peso, y el balance se estimará."
          }
        }
      }
    },
    "nutrients.energyBalance.needsExpenditure": {
      "comment": "Energy balance: no headline because active energy is missing",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahme ist da, aber an denselben Tagen kam keine Aktivenergie an, daher gibt es noch keine Bilanz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your intake is here, but no active energy arrived on the same days, so there is no balance to show yet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je inname is er, maar op dezelfde dagen kwam geen actieve energie binnen, dus er is nog geen balans."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섭취량은 있지만 같은 날 활동 에너지가 들어오지 않아 아직 보여 줄 균형이 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ingesta está aquí, pero no llegó energía activa en los mismos días, así que aún no hay balance que mostrar."
          }
        }
      }
    },
