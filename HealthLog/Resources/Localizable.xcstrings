    "This device needs to connect to the relay again, for example after a restore.": {
      "comment": "#190 §4 Settings line when the server asks for a new binding; only the person may reconnect.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät muss sich erneut mit dem Relay verbinden, etwa nach einer Wiederherstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device needs to connect to the relay again, for example after a restore."
