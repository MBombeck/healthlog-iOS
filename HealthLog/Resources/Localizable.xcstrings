    },
    "settings.applehealth.routes.backfill.none": {
      "comment": "Line under the button after a pass that attached no route (POLISH-B B10).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Route nachzutragen. Ältere Trainings haben ihre Route schon oder keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No route to add. Older workouts already have theirs or have none."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen route om toe te voegen. Oudere trainingen hebben er al een of hebben er geen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가할 경로가 없어요. 이전 운동에는 이미 경로가 있거나 경로가 없어요."
          }
        }
      }
    },
    "settings.applehealth.routes.backfill.failed": {
