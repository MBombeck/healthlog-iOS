    "Your server no longer offers the relay. HealthLog turned it off on this device; reminders work as before.": {
      "comment": "#190 5.1 (5) Quiet settings line after the operator turned the relay off and the app unregistered by itself.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server bietet das Relay nicht mehr an. HealthLog hat es auf diesem Gerät ausgeschaltet; Erinnerungen funktionieren wie bisher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server no longer offers the relay. HealthLog turned it off on this device; reminders work as before."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server biedt de relay niet meer aan. HealthLog heeft hem op dit apparaat uitgeschakeld; herinneringen werken zoals voorheen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 더 이상 릴레이를 제공하지 않습니다. HealthLog가 이 기기에서 릴레이를 껐으며, 알림은 이전처럼 작동합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor ya no ofrece el relay. HealthLog lo desactivó en este dispositivo; los recordatorios funcionan como antes."
          }
        }
      }
    },
