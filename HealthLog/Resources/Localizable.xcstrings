    "measurement.reminder.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist dieser Schalter an, kommt auf deinen Apple-Geräten kein Push. Telegram, ntfy, Webhook, E-Mail und Web Push erreichen dich weiterhin, und die App plant keine eigene Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this switch on, no push reaches your Apple devices. Telegram, ntfy, webhook, email and Web Push still reach you, and the app schedules no reminder of its own."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat deze schakelaar aan, dan komt er op je Apple-apparaten geen pushmelding. Telegram, ntfy, webhook, e-mail en Web Push bereiken je nog steeds, en de app plant geen eigen herinnering."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스위치를 켜면 Apple 기기로 푸시 알림이 가지 않아요. Telegram, ntfy, 웹훅, 이메일, 웹 푸시로는 계속 알림을 받고, 앱 자체에서는 알림을 예약하지 않아요."
          }
        }
      }
    },
