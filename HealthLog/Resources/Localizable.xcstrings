        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona, pero algunos tipos de datos no están permitidos. Vuelve a conectar para concederlos."
          }
        }
      }
    },
    "integration.health.reason.providerErrors": {
