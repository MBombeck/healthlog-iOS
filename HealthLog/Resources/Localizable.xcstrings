    "mentalHealth.considerProfessional": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wert liegt in einem Bereich, in dem ein Gespräch mit einer Fachperson helfen kann. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your score is in a range where talking to a health professional may help. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je score ligt in een bereik waarbij een gesprek met een zorgverlener kan helpen. Dit is een voorzichtige suggestie, geen diagnose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "점수가 전문가와 이야기해 보면 도움이 될 수 있는 구간이에요. 진단이 아니라 가벼운 제안이에요."
          }
        }
      }
    },
    "mentalHealth.considerWellbeing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wohlbefinden liegt gerade in einem niedrigeren Bereich. Es kann guttun, mit einer vertrauten Person oder einer Fachperson darüber zu sprechen. Das ist ein behutsamer Hinweis, keine Diagnose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your well-being is in a lower range right now. It can help to talk it over with someone you trust or a health professional. This is a gentle suggestion, not a diagnosis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je welzijn ligt op dit moment in een lager bereik. Het kan helpen om erover te praten met iemand die je vertrouwt of met een zorgverlener. Dit is een voorzichtige suggestie, geen diagnose."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금은 웰빙이 낮은 구간이에요. 믿을 수 있는 사람이나 전문가와 이야기해 보면 도움이 될 수 있어요. 진단이 아니라 가벼운 제안이에요."
          }
        }
      }
    },
    "mentalHealth.crisis.ifDanger": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du in unmittelbarer Gefahr bist, ruf jetzt %@ an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are in immediate danger, call %@ now."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ben je in direct gevaar? Bel dan nu %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당장 위험한 상황이라면 지금 %@로 전화하세요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.crisis.ifDanger`, word for word; ko from server v1.47.0 messages `mentalHealth.crisis.ifDanger`, word for word."
    },
    "mentalHealth.crisis.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Gedanken angegeben, lieber tot zu sein oder dir etwas anzutun. Es gibt jetzt sofort Unterstützung, und sich zu melden ist ein Zeichen von Stärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You indicated thoughts of being better off dead or of hurting yourself. Support is available right now, and reaching out is a sign of strength."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt aangegeven dat je gedachten hebt dat je beter dood zou kunnen zijn of dat je jezelf iets wilt aandoen. Er is nu meteen hulp beschikbaar, en contact zoeken is een teken van kracht."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죽는 편이 낫겠다는 생각이나 스스로를 해치려는 생각이 있다고 답하셨어요. 지금 바로 받을 수 있는 도움이 있고, 도움을 청하는 건 강함의 표시예요."
          }
        }
      },
      "comment": "Approved as server wording (Decision 16): nl from server v1.47.0 messages `mentalHealth.crisis.intro`, word for word; ko from server v1.47.0 messages `mentalHealth.crisis.intro`, word for word."
    },
    "mentalHealth.crisis.open": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfsangebote anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show resources"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hulpbronnen tonen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "도움받을 곳 보기"
          }
        }
      }
    },
    "mentalHealth.crisis.resourcesTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
