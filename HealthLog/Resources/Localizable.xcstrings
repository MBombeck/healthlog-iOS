    "Your device's own estimate — HealthLog only re-frames it, it does not compute it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigene Schätzung deines Geräts. HealthLog ordnet sie nur ein, berechnet sie aber nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device's own estimate. HealthLog only re-frames it and does not compute it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eigen schatting van je apparaat. HealthLog plaatst deze alleen in context en berekent hem niet zelf."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 자체의 추정값이에요. HealthLog는 이를 다시 정리해 보여 줄 뿐 직접 계산하지 않아요."
          }
        }
      }
    },
    "Your health scores": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
