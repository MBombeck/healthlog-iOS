    "med.criticalAlarm.failed.body": {
      "comment": "audit-release 05 C-1 — body of the critical-alarm failure warning. %@ is the list of affected medication names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ konnte der kritische Alarm nicht aktiviert werden. Diese Erinnerung ist nicht garantiert. Bitte versuche es erneut oder prüfe die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The critical alarm for %@ couldn’t be set. This reminder isn’t guaranteed. Try again or check Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kritieke alarm voor %@ kon niet worden ingesteld. Deze herinnering is niet gegarandeerd. Probeer het opnieuw of controleer Instellingen."
          }
        }
      }
