        }
      }
    },
    "Your provider receives this data and handles it under their own privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter erhält diese Daten und verarbeitet sie gemäß seiner eigenen Datenschutzrichtlinie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider receives this data and handles it under their own privacy policy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aanbieder ontvangt deze gegevens en verwerkt ze volgens zijn eigen privacybeleid."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 이 데이터를 받아 자체 개인정보 처리방침에 따라 처리해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor recibe estos datos y los trata según su propia política de privacidad."
          }
        }
      }
    },
    "Your saved report selection returned no data, so the server bundle is empty.": {
      "comment": "CU-13 — the unified sharing surface: server $everything came back empty although a report selection is saved",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherte Auswahl hat keine Daten geliefert. Das Server-Bundle ist leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved report selection returned no data, so the server bundle is empty."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen rapportselectie leverde geen gegevens op, dus de serverbundel is leeg."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 리포트 선택 항목에 데이터가 없어서 서버 번들이 비어 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección de informe que guardaste no devolvió datos, así que el paquete del servidor está vacío."
          }
        }
      }
    },
    "Your server doesn't have an assistant provider set up yet. Configure one below, or ask your server's operator to add one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat noch keinen Assistent-Anbieter eingerichtet. Konfiguriere unten einen oder bitte den Betreiber deines Servers, einen hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server doesn't have an assistant provider set up yet. Configure one below, or ask your server's operator to add one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je server is nog geen assistentaanbieder ingesteld. Stel er hieronder een in of vraag de beheerder van je server er een toe te voegen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 아직 어시스턴트 제공자가 설정되어 있지 않아요. 아래에서 설정하거나 서버 운영자에게 추가를 요청해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor todavía no tiene configurado ningún proveedor de asistente. Configura uno abajo o pide al administrador de tu servidor que añada uno."
          }
        }
      }
    },
    "Your server provides the assistant. No provider key is stored in this app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server stellt den Assistenten bereit. In dieser App ist kein Anbieter-Schlüssel gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server provides the assistant. No provider key is stored in this app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server levert de assistent. Er is geen sleutel van een aanbieder in deze app bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 어시스턴트를 제공해요. 이 앱에는 제공자 키가 저장되지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor proporciona el asistente. En esta app no se guarda ninguna clave de proveedor."
          }
        }
      }
    },
    "Your server forwards them to its configured AI provider to generate personal insights.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server leitet sie an seinen konfigurierten KI-Anbieter weiter, um persönliche Einblicke zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server forwards them to its configured AI provider to generate personal insights."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server stuurt ze door naar de ingestelde AI-aanbieder om persoonlijke inzichten te maken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 이를 설정된 AI 제공자에게 전달해 개인 인사이트를 생성해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor los envía al proveedor de IA que tiene configurado para generar información personal."
          }
        }
      }
    },
    "Your server receives this data and forwards it to its AI provider under that provider's privacy policy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server erhält diese Daten und leitet sie an seinen KI-Anbieter weiter, gemäß dessen Datenschutzrichtlinie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server receives this data and forwards it to its AI provider under that provider's privacy policy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server ontvangt deze gegevens en stuurt ze door naar zijn AI-aanbieder, volgens het privacybeleid van die aanbieder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 데이터를 받아 해당 AI 제공자의 개인정보 처리방침에 따라 AI 제공자에게 전달해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor recibe estos datos y los envía a su proveedor de IA según la política de privacidad de ese proveedor."
          }
        }
      }
    },
    "Your server uses an OpenAI-compatible endpoint. It is configured on the server, not in this app.": {
      "comment": "AI provider status footer — OPENAI_COMPATIBLE; the endpoint is operator-owned, iOS has no field for it",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server nutzt einen OpenAI-kompatiblen Endpunkt. Er wird auf dem Server konfiguriert, nicht in dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server uses an OpenAI-compatible endpoint. It is configured on the server, not in this app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server gebruikt een OpenAI-compatibel endpoint. Dit wordt op de server ingesteld, niet in deze app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 OpenAI 호환 엔드포인트를 사용해요. 이 앱이 아닌 서버에서 설정돼요."
          }
        },
        "es": {
          "stringUnit": {
