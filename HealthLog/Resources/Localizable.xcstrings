    "insights.workouts.info.about": {
      "comment": "Insights Workouts page, (i) sheet: what the page shows and that duplicate workouts from two sources are merged.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Trainings aus Apple Health und anderen verbundenen Quellen, das neueste zuerst. Zeichnen zwei Quellen dasselbe Training auf, steht es hier nur einmal. Tippe auf ein Training, um seine Einzelheiten zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workouts from Apple Health and other connected sources, newest first. When two sources record the same workout, it appears here only once. Tap a workout to see its details."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je trainingen uit Apple Health en andere gekoppelde bronnen, de nieuwste eerst. Leggen twee bronnen dezelfde training vast, dan staat die hier maar één keer. Tik op een training om de details te zien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple 건강 및 연결된 다른 소스의 운동 기록이에요. 최신 기록이 먼저 표시돼요. 두 소스가 같은 운동을 기록하면 여기에는 한 번만 표시돼요. 운동을 탭하면 자세한 내용을 볼 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus entrenamientos de Apple Health y otras fuentes conectadas, del más reciente al más antiguo. Cuando dos fuentes registran el mismo entrenamiento, aquí aparece solo una vez. Toca un entrenamiento para ver sus detalles."
          }
        }
      }
    },
    "insights.ecg.info.about": {
      "comment": "Insights ECG page, (i) sheet: what the page shows; the result is the device's own, HealthLog does not assess it (regulatory framing).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die EKG-Aufzeichnungen deines Geräts mit dem Ergebnis, das das Gerät selbst erstellt hat. HealthLog zeigt Aufzeichnung und Ergebnis nur an und bewertet sie nicht. Tippe auf eine Aufzeichnung, um die Kurve zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ECG recordings from your device, with the result the device produced itself. HealthLog only shows the recording and its result and does not assess them. Tap a recording to see its trace."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ECG-opnamen van je apparaat, met de uitslag die het apparaat zelf heeft gegeven. HealthLog toont opname en uitslag alleen en beoordeelt ze niet. Tik op een opname om de curve te zien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "기기에서 기록한 심전도와 기기가 직접 내놓은 결과예요. HealthLog는 기록과 결과를 보여 주기만 하고 평가하지 않아요. 기록을 탭하면 곡선을 볼 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los registros de ECG de tu dispositivo, con el resultado que generó el propio dispositivo. HealthLog solo muestra el registro y su resultado, y no los evalúa. Toca un registro para ver su trazado."
          }
        }
      }
    },
