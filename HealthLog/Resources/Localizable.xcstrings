    },
    "mood.patterns.multipleEntriesHigher %@ %@": {
      "comment": "#136 Mood pattern multiple_entries, higher.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit mehreren Einträgen ist deine Stimmung meist besser (%1$@ gegenüber %2$@ an Tagen mit einem)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days you log more than once, your mood tends to be higher (%1$@ against %2$@ on single-entry days)."
