    "It loses access to your health record immediately, including any refresh it holds. You can connect it again later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verliert sofort den Zugriff auf deine Gesundheitsakte, samt aller Refresh-Rechte. Du kannst ihn später wieder verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It loses access to your health record immediately, including any refresh it holds. You can connect it again later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent verliest direct de toegang tot je gezondheidsdossier, inclusief eventuele vernieuwingsrechten. Je kunt hem later opnieuw verbinden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 기록에 대한 접근 권한을 즉시 잃어요. 보유 중인 갱신 토큰도 포함돼요. 나중에 다시 연결할 수 있어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierde el acceso a tu historial de salud de inmediato, incluida cualquier renovación que tenga. Puedes volver a conectarlo más adelante."
          }
        }
      }
    },
