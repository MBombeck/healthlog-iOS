    "mood.patterns.title": {
      "comment": "#136 Heading of the server's mood pattern cards.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster in deiner Stimmung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patterns in your mood"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patronen in je stemming"
          }
        }
      }
    },
    "mood.patterns.previousDayHigher %@ %@": {
      "comment": "#136 Mood pattern previous_day, higher. Args: subject mean, comparison mean.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Tag unter deinem Üblichen ist der nächste Tag meist besser (%1$@ gegenüber %2$@ nach einem Tag darüber)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a below-usual day, the next day tends to be better (%1$@ against %2$@ after an above-usual day)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na een dag die minder was dan normaal, is de volgende dag meestal beter (%1$@ tegenover %2$@ na een dag die beter was dan normaal)."
          }
        }
      }
    },
    "mood.patterns.previousDayLower %@ %@": {
      "comment": "#136 Mood pattern previous_day, lower.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tag unter deinem Üblichen wirkt meist in den nächsten Tag hinein (%1$@ gegenüber %2$@ nach einem Tag darüber)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A below-usual day tends to carry over into the next one (%1$@ against %2$@ after an above-usual day)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dag die minder is dan normaal, werkt meestal door in de volgende dag (%1$@ tegenover %2$@ na een dag die beter was dan normaal)."
          }
        }
      }
    },
    "mood.patterns.weekendHigher %@ %@": {
      "comment": "#136 Mood pattern weekend, higher.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Wochenende ist deine Stimmung meist besser (%1$@ gegenüber %2$@ unter der Woche)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mood tends to be higher at the weekend (%1$@ against %2$@ on weekdays)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het weekend is je stemming meestal beter (%1$@ tegenover %2$@ door de week)."
          }
        }
      }
    },
    "mood.patterns.weekendLower %@ %@": {
      "comment": "#136 Mood pattern weekend, lower.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Wochenende ist deine Stimmung meist schlechter (%1$@ gegenüber %2$@ unter der Woche)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mood tends to be lower at the weekend (%1$@ against %2$@ on weekdays)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In het weekend is je stemming meestal minder goed (%1$@ tegenover %2$@ door de week)."
          }
        }
      }
    },
    "mood.patterns.bestWeekday %@ %@ %@": {
      "comment": "#136 Mood pattern best_weekday. Args: weekday name, subject mean, comparison mean.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist meist dein bester Tag (%2$@ gegenüber %3$@ an den übrigen Tagen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tends to be your best day (%2$@ against %3$@ on the other days)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is meestal je beste dag (%2$@ tegenover %3$@ op de andere dagen)."
          }
        }
      }
    },
    "mood.patterns.notesHigher %@ %@": {
      "comment": "#136 Mood pattern notes, higher.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit Notiz ist deine Stimmung meist besser (%1$@ gegenüber %2$@ ohne)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days with a note your mood tends to be higher (%1$@ against %2$@ without one)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dagen met een notitie is je stemming meestal beter (%1$@ tegenover %2$@ zonder notitie)."
          }
        }
      }
    },
    "mood.patterns.notesLower %@ %@": {
      "comment": "#136 Mood pattern notes, lower.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit Notiz ist deine Stimmung meist schlechter (%1$@ gegenüber %2$@ ohne)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On days with a note your mood tends to be lower (%1$@ against %2$@ without one)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dagen met een notitie is je stemming meestal minder goed (%1$@ tegenover %2$@ zonder notitie)."
          }
        }
      }
    },
    "mood.patterns.delayedTagHigher %@ %@ %@": {
      "comment": "#136 Mood pattern delayed_tag, higher. Args: tag label, subject mean, comparison mean.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tag nach „%1$@“ ist deine Stimmung meist besser (%2$@ gegenüber %3$@ sonst)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day after “%1$@”, your mood tends to be higher (%2$@ against %3$@ otherwise)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dag na ‘%1$@’ is je stemming meestal beter (%2$@ tegenover %3$@ anders)."
          }
        }
      }
    },
    "mood.patterns.delayedTagLower %@ %@ %@": {
