      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird geprüft, ob deine Einrichtung schon abgeschlossen ist …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking whether your setup is already complete…"
