    "customMetric.editor.correlation.hint": {
      "comment": "CU-35 (3) — correlationEnabled consent on a custom metric. Footer under the toggle. It is a consent to being analysed, so the copy states plainly what switching it on permits and that it can be taken back.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: die Metrik bleibt Erfassen und Diagramm, sonst nichts. Ein: HealthLog darf ihre Werte neben deine übrigen Gesundheitsdaten legen und nach Zusammenhängen suchen. Du kannst das jederzeit wieder ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: the metric stays logging and charts, nothing more. On: HealthLog may put its values next to the rest of your health data and look for associations. You can switch it back off at any time."
          }
        }
      }
    },
