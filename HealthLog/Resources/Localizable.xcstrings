    "cycle.capture.reconcile.confirm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, Periode beginnt heute"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, my period started"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
