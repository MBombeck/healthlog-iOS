    "consent.documentProcessing.server": {
      "comment": "External-AI consent — document categories and server-mediated recipients.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Dokument-KI verwendest, können gespeicherte Dokumente, gescannte Seiten und daraus erkannter OCR-Text an deinen Server und dessen konfigurierten KI-Anbieter gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you use document AI, stored documents, scanned pages, and OCR text recognized from them may be sent to your server and its configured AI provider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je document-AI gebruikt, kunnen bewaarde documenten, gescande pagina's en de daaruit herkende OCR-tekst naar je server en de daar ingestelde AI-aanbieder worden gestuurd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 AI를 사용하면 저장된 문서, 스캔한 페이지, 여기서 인식한 OCR 텍스트가 서버와 서버에 설정된 AI 제공자에게 전송될 수 있어요."
          }
        }
      }
    },
    "consent.documentProcessing.userChosen": {
      "comment": "External-AI consent — document categories and user-chosen recipient.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Dokument-KI verwendest, können gespeicherte Dokumente, gescannte Seiten und daraus erkannter OCR-Text direkt an deinen gewählten Anbieter gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you use document AI, stored documents, scanned pages, and OCR text recognized from them may be sent directly to your chosen provider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je document-AI gebruikt, kunnen bewaarde documenten, gescande pagina's en de daaruit herkende OCR-tekst rechtstreeks naar je gekozen aanbieder worden gestuurd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 AI를 사용하면 저장된 문서, 스캔한 페이지, 여기서 인식한 OCR 텍스트가 내가 선택한 제공자에게 직접 전송될 수 있어요."
          }
        }
      }
    },
    "consent.legal.article9": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Akzeptieren“ erteilst du deine ausdrückliche Einwilligung nach Art. 9 (2) (a) DSGVO in die Verarbeitung dieser besonderen Kategorien personenbezogener Daten (Gesundheitsdaten). Du kannst sie jederzeit widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By tapping Accept you give your explicit consent under GDPR Art. 9(2)(a) to process these special-category (health) data. You can withdraw it at any time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door op Accepteren te tikken, geef je uitdrukkelijke toestemming op grond van art. 9, lid 2, onder a AVG voor de verwerking van deze bijzondere categorie (gezondheids)gegevens. Je kunt deze toestemming altijd intrekken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락을 탭하면 GDPR 제9조 제2항 (a)호에 따라 이 특수 범주(건강) 데이터의 처리에 명시적으로 동의하게 돼요. 언제든지 동의를 철회할 수 있어요."
          }
        }
      }
    },
    "consent.legal.leavesDevice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Daten verlassen dein Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data leaves your device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gegevens verlaten je apparaat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터는 기기 밖으로 전송돼요."
          }
        }
      }
    },
    "consent.legal.subProcessor.server": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server leitet die Daten an seinen konfigurierten KI-Unterauftragsverarbeiter weiter: Anthropic, PBC oder OpenAI, L.L.C."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server forwards the data to its configured third-party LLM sub-processor: Anthropic, PBC or OpenAI, L.L.C."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je server stuurt de gegevens door naar de ingestelde externe LLM-subverwerker: Anthropic, PBC of OpenAI, L.L.C."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 설정된 제3자 LLM 수탁처리자(Anthropic, PBC 또는 OpenAI, L.L.C.)에게 데이터를 전달해요."
          }
        }
      }
    },
    "consent.legal.subProcessor.userChosen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten gehen an %@ als Unterauftragsverarbeiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data goes to %@ as the sub-processor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens gaan naar %@ als subverwerker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 수탁처리자인 %@에게 전송돼요."
          }
        }
      }
    },
    "consent.legal.transferRetention": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verarbeitung erfolgt in den USA. Anbieter nennen ein Speicherfenster von typischerweise bis zu 30 Tagen zur Missbrauchsüberwachung; die genaue Dauer richtet sich nach der Police des Anbieters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing takes place in the United States. Providers state a retention window of typically up to 30 days for abuse monitoring; the exact period follows the provider's policy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verwerking vindt plaats in de Verenigde Staten. Aanbieders noemen een bewaartermijn van doorgaans tot 30 dagen voor misbruikbewaking; de exacte termijn volgt het beleid van de aanbieder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리는 미국에서 이루어져요. 제공자는 남용 모니터링을 위해 일반적으로 최대 30일의 보관 기간을 명시하며, 정확한 기간은 제공자의 정책을 따라요."
          }
        }
      }
    },
