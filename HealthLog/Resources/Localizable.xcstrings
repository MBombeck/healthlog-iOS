    "health.padNotice.title": {
      "comment": "Title of the quiet notice on the Apple Health pages when the app runs on an iPad.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health läuft über dein iPhone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health runs through your iPhone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health loopt via je iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health는 iPhone에서 작동해요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health funciona a través de tu iPhone"
          }
        }
      }
    },
    "health.padNotice.body": {
      "comment": "Body of the iPad-only Apple Health notice.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPad liest und schreibt HealthLog nichts in Apple Health. Das übernimmt dein iPhone, die Werte erscheinen hier über deinen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the iPad, HealthLog does not read from or write to Apple Health. Your iPhone does that, and the values show up here through your server."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de iPad leest en schrijft HealthLog niets in Apple Health. Dat doet je iPhone, de waarden verschijnen hier via je server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad에서는 HealthLog가 Apple Health를 읽거나 쓰지 않아요. iPhone이 그 역할을 하고, 값은 서버를 통해 여기에 나타나요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPad, HealthLog no lee ni escribe en Apple Health. Lo hace tu iPhone, y los valores aparecen aquí a través de tu servidor."
          }
        }
      }
    },
    "health.padNotice.row": {
      "comment": "Subtitle of the Apple Health row in Integrations, iPad only.",
      "extractionState": "manual",
      "localizations": {
