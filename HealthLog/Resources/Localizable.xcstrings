    "Your photo is stored on your own HealthLog server — never shared with a third party.": {
      "comment": "v0.8.0 W11 — EditProfileScreen self-hosted avatar.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Foto wird auf deinem eigenen HealthLog-Server gespeichert und niemals an Dritte weitergegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo is stored on your own HealthLog server and never shared with a third party."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto wordt op je eigen HealthLog-server bewaard en nooit gedeeld met derden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 내 HealthLog 서버에 저장되며 제3자와 절대 공유되지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto se guarda en tu propio servidor de HealthLog y nunca se comparte con terceros."
          }
        }
      }
    },
    "Your provider declined this validation request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter hat diese Prüfanfrage abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider declined this validation request."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aanbieder heeft dit controleverzoek geweigerd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 이 검증 요청을 거부했어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor rechazó esta solicitud de validación."
          }
        }
      }
    },
    "Your provider declined to answer this request.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter hat die Antwort auf diese Anfrage abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider declined to answer this request."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aanbieder heeft geweigerd dit verzoek te beantwoorden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 이 요청에 대한 답변을 거부했어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor se negó a responder a esta solicitud."
          }
        }
      }
    },
    "Your provider is rate-limiting requests. Try again shortly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter drosselt Anfragen. Versuche es gleich erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider is rate-limiting requests. Try again shortly."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aanbieder beperkt het aantal verzoeken. Probeer het zo opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 요청 수를 제한하고 있어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor está limitando las solicitudes. Inténtalo de nuevo en breve."
          }
        }
      }
    },
    "Your provider is temporarily unavailable. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anbieter ist vorübergehend nicht verfügbar. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
