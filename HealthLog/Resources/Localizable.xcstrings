    "report.selection.notice.rebuilt": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl enthielt Einträge, die dieser Server nicht kennt. Sie wurde aus der aktuellen Serverliste neu aufgebaut. Bitte prüfe sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection contained entries this server does not know. It was rebuilt from the current server list. Please check it and try again."
