    "settings.coach.cadenceSuggestions.description": {
      "comment": "Settings → Coach — description of the proactive cadence-suggestions opt-in",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne deine Bestätigung wird nie eine Erinnerung erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reminder is ever created without your tap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder jouw tik wordt er nooit een herinnering aangemaakt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 탭하지 않으면 알림은 절대 만들어지지 않아요."
          }
        }
      }
    },
    "settings.coach.docsAutoAi.description": {
      "comment": "Settings → Coach — help text for the auto read-documents-with-AI switch",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine externe KI liest jedes hochgeladene Dokument und holt Laborwerte und eine kurze Zusammenfassung heraus. Einschalten ist deine dauerhafte Einwilligung, ausschalten geht jederzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your external AI reads each uploaded document and pulls out lab values and a short summary. Turning this on is your standing consent, and you can turn it off anytime."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je externe AI leest elk geüpload document en haalt er labwaarden en een korte samenvatting uit. Inschakelen is je doorlopende toestemming, uitschakelen kan altijd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 AI가 업로드된 문서를 하나씩 읽고 검사 수치와 짧은 요약을 추출해요. 이 기능을 켜면 계속 적용되는 동의로 간주되며, 언제든 끌 수 있어요."
          }
        }
      }
    },
    "settings.coach.docsAutoAi.toggle": {
      "comment": "Settings → Coach — label of the auto read-documents-with-AI toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Dokumente automatisch lesen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read new documents automatically"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe documenten automatisch lezen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 문서 자동으로 읽기"
          }
        }
      }
    },
    "settings.coach.enable.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Coach auf allen deinen Geräten ein oder aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the coach on or off across all your devices."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de coach in of uit op al je apparaten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 코치를 켜거나 꺼요."
          }
        }
      }
    },
    "settings.coach.enable.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable coach"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach inschakelen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치 사용"
          }
        }
      }
    },
    "settings.coach.heroCard.restore": {
      "comment": "1.4 B2-c: Coach settings, row that brings the dismissed coach card back on Insights",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach-Karte wieder anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the Coach card again"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachkaart weer tonen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치 카드 다시 표시"
          }
        }
      }
    },
    "settings.coach.info.cadence": {
      "comment": "1.4 B2-c: Coach settings info sheet, cadence suggestions section",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt der Coach einen Rhythmus in deinen Einträgen, etwa dass du dich meist werktags morgens wiegst, bietet er an, eine Mess-Erinnerung einzurichten. Die Vorschläge erscheinen als Karten in den Insights, du nimmst sie an oder verwirfst sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the coach notices a rhythm in how you log, say you usually weigh yourself on weekday mornings, it offers to set a measurement reminder. Suggestions appear as cards on Insights, you accept or dismiss each one."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziet de coach een ritme in hoe je dingen vastlegt, bijvoorbeeld dat je je meestal op werkdagen 's ochtends weegt, dan biedt hij aan een meetherinnering in te stellen. De voorstellen verschijnen als kaarten bij Inzichten, en je accepteert of negeert ze een voor een."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 기록 패턴을 발견하면(예: 평일 아침마다 체중을 잰다면) 측정 알림 설정을 제안해요. 제안은 인사이트에 카드로 표시되며, 하나씩 수락하거나 닫을 수 있어요."
          }
        }
      }
    },
    "settings.coach.info.storage": {
      "comment": "1.4 B2-c: Coach settings info sheet, where conversations are stored",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Coach über deinen Server liegen die Unterhaltungen zusätzlich auf deinem Server, unter „Frühere Unterhaltungen“ kannst du sie ansehen und löschen. Beim Coach auf dem Gerät (Apple Intelligence) und mit eigenem Schlüssel bleiben sie nur auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the coach on your server, conversations are also kept on your server, where you can view and delete them under Past conversations. With the on-device coach (Apple Intelligence) and with your own key they stay on this iPhone only."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de coach via je server worden gesprekken ook op je server bewaard, waar je ze onder “Eerdere gesprekken” kunt bekijken en verwijderen. Met de coach op het apparaat (Apple Intelligence) en met je eigen sleutel blijven ze alleen op deze iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 코치를 사용하면 대화도 서버에 보관되며, 지난 대화에서 보고 삭제할 수 있어요. 기기 내 코치(Apple Intelligence)나 내 키를 사용하면 대화는 이 iPhone에만 남아요."
          }
        }
      }
    },
