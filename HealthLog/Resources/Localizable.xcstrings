    "med.lowstock.push.body": {
      "comment": "MED-4/C3 — local low-supply notification body. %1$@ = medication name, %2$lld = days of supply left.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reicht noch ≈ %#@days@. Zeit, Nachschub zu besorgen."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tage"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lasts ≈ %#@days@. Time to restock."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg more day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg more days"
                    }
                  }
                }
              }
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is nog ≈ %#@days@ voorradig. Tijd om aan te vullen."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dagen"
                    }
                  }
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 재고가 약 %2$lld일분 남았어요. 보충할 때예요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %1$@ le quedan ≈ %#@days@. Es hora de reponer."
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días más"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg día más"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días más"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
