      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Route nachzutragen. Ältere Trainings haben ihre Route schon oder keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No route to add. Older workouts already have theirs or have none."
