          "stringUnit": {
            "state": "translated",
            "value": "Je vitale waarden hadden ongeveer %@ dagen nodig om terug te keren naar je basiswaarde nadat je je beter voelde."
          }
        }
      }
    },
    "illness.correlation.redFlags.detail %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "substitutions": {
