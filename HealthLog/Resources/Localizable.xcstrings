    },
    "onboarding.sso.error.linkRequired": {
      "comment": "SSO error oidc_link_required (server v1.39.3)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto muss einmal im Browser mit Single Sign-on verbunden werden. Melde dich im Web an und versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account needs to be connected to single sign-on once in the browser. Sign in on the web, then try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account moet eenmalig in de browser aan single sign-on worden gekoppeld. Log in op het web en probeer het daarna opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 브라우저에서 한 번 통합 로그인에 연결해야 해요. 웹에서 로그인한 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta tiene que conectarse una vez al inicio de sesión único en el navegador. Inicia sesión en la web y vuelve a intentarlo."
          }
        }
      }
    },
    "onboarding.auth.error.rateLimitedRetry %@": {
      "comment": "Sign-in 429 with Retry-After; %@ is a localized duration such as '15 minutes'",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Bitte versuch es in %@ erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Please try again in %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Probeer het over %@ opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 시도가 너무 많아요. %@ 후에 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de inicio de sesión. Vuelve a intentarlo en %@."
          }
        }
      }
    },
    "stepUp.record.required": {
      "comment": "Shown on a record action (share link, token, backup) when the server asks for a fresh proof",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte bestätige, dass du es bist, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please confirm it's you to continue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat jij het bent om door te gaan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 본인 확인을 해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que eres tú para continuar."
          }
        }
      }
    },
    "stepUp.record.body": {
      "comment": "Body of the step-up sheet in front of a record action",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit gibst du deine Gesundheitsdaten oder einen dauerhaften Zugang dazu weiter. Bestätige, dass du es bist, dann geht es weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This hands your health record, or lasting access to it, to someone. Confirm it's you, then it continues."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee geef je je gezondheidsdossier, of blijvende toegang ertoe, aan iemand anders. Bevestig dat jij het bent, dan gaat het verder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 내 건강 기록 또는 기록에 대한 지속적인 접근 권한을 다른 사람에게 넘겨요. 본인 확인 후 계속 진행돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto entrega tu historial de salud, o un acceso duradero a él, a otra persona. Confirma que eres tú y continuará."
          }
        }
      }
    },
    "sessions.signOutAll.keepShareLinks": {
      "comment": "Toggle on the sessions screen: sign out everywhere but keep clinician share links (keepShareLinks=1)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arzt-Links behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep doctor share links"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deellinks voor artsen behouden"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사 공유 링크 유지"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener enlaces para médicos"
          }
        }
      }
    },
    "sessions.signOutAll.everything.confirmBody": {
      "comment": "Sign out everywhere confirmation, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen und alle anderen App-Anmeldungen werden beendet. Auch verbundene KI-Assistenten, API-Tokens und Arzt-Links funktionieren danach nicht mehr. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session and every other app sign-in ends. Connected AI assistants, API tokens and doctor share links stop working too. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle browsersessies en alle andere app-aanmeldingen worden beëindigd. Ook gekoppelde AI-assistenten, API-tokens en deellinks voor artsen werken daarna niet meer. Dit apparaat blijft ingelogd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 세션과 다른 앱 로그인이 모두 종료돼요. 연결된 AI 어시스턴트, API 토큰, 의사 공유 링크도 작동을 멈춰요. 이 기기는 로그인 상태로 유지돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierran todas las sesiones del navegador y todos los demás inicios de sesión en apps. Los asistentes de IA conectados, los tokens de API y los enlaces compartidos con médicos también dejan de funcionar. Este dispositivo sigue con la sesión iniciada."
          }
        }
      }
    },
    "sessions.signOutAll.everything.keepLinks.confirmBody": {
      "comment": "Sign out everywhere confirmation with share links kept, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Browser-Sitzungen und alle anderen App-Anmeldungen werden beendet. Auch verbundene KI-Assistenten und API-Tokens funktionieren danach nicht mehr. Deine Arzt-Links bleiben aktiv. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every browser session and every other app sign-in ends. Connected AI assistants and API tokens stop working too. Your doctor share links stay active. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle browsersessies en alle andere app-aanmeldingen worden beëindigd. Ook gekoppelde AI-assistenten en API-tokens werken daarna niet meer. Je deellinks voor artsen blijven actief. Dit apparaat blijft ingelogd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 세션과 다른 앱 로그인이 모두 종료돼요. 연결된 AI 어시스턴트와 API 토큰도 작동을 멈춰요. 의사 공유 링크는 계속 유효해요. 이 기기는 로그인 상태로 유지돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierran todas las sesiones del navegador y todos los demás inicios de sesión en apps. Los asistentes de IA conectados y los tokens de API también dejan de funcionar. Tus enlaces compartidos con médicos siguen activos. Este dispositivo sigue con la sesión iniciada."
          }
        }
      }
    },
    "sessions.signOutAll.everything.footer": {
      "comment": "Sign out everywhere footer, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen und alle anderen Apps ab und beendet verbundene KI-Assistenten, API-Tokens und Arzt-Links. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and every other app, and ends connected AI assistants, API tokens and doctor share links. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt alle browsersessies en alle andere apps uit en beëindigt gekoppelde AI-assistenten, API-tokens en deellinks voor artsen. Dit apparaat blijft ingelogd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 세션과 다른 앱에서 로그아웃하고, 연결된 AI 어시스턴트, API 토큰, 의사 공유 링크를 종료해요. 이 기기는 로그인 상태로 유지돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra todas las sesiones del navegador y de las demás apps, y desconecta los asistentes de IA conectados, los tokens de API y los enlaces compartidos con médicos. Este dispositivo sigue con la sesión iniciada."
          }
        }
      }
    },
    "sessions.signOutAll.everything.doneBody": {
      "comment": "Sign out everywhere done, server >= 1.39.3",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Sitzungen und App-Anmeldungen wurden beendet, ebenso verbundene KI-Assistenten, API-Tokens und Arzt-Links. Dieses Gerät bleibt angemeldet."
