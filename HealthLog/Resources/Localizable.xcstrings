            "state": "translated",
            "value": "Signs out every browser session and revokes every app sign-in, including on this device."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt alle browsersessies uit en trekt de inlog van alle apps in, ook op dit apparaat."
          }
