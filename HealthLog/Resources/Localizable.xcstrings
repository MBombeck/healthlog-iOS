    "settings.support.info.categories": {
      "comment": "1.4 B2-c: Support details info sheet, banner buttons section",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktionen, die iOS an einer Mitteilung zeigt. Fehlt MEDICATION_REMINDER, fehlen auch die Knöpfe „Genommen“, „15 Min. zurückstellen“ und „Übersprungen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The actions iOS shows on a notification. If MEDICATION_REMINDER is missing, the Taken, Snooze 15 min and Skipped buttons are missing too."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De acties die iOS bij een melding toont. Ontbreekt MEDICATION_REMINDER, dan ontbreken ook de knoppen “Ingenomen”, “15 min. uitstellen” en “Overgeslagen”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 알림에 표시하는 동작이에요. MEDICATION_REMINDER가 없으면 복용함, 15분 미루기, 건너뜀 버튼도 표시되지 않아요."
          }
        }
      }
    },
    "settings.support.info.registration": {
      "comment": "1.4 B2-c: Support details info sheet, APNs registration section",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wann sich dieses iPhone zuletzt bei deinem Server für Mitteilungen angemeldet hat. Anfang und Ende des Tokens reichen, um den Eintrag im Server-Log zu finden, der ganze Token wird nie gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when this iPhone last registered with your server for notifications. The start and end of the token are enough to find the entry in the server log, the full token is never stored."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont wanneer deze iPhone zich voor het laatst bij je server heeft aangemeld voor meldingen. Het begin en eind van het token zijn genoeg om de regel in het serverlog te vinden, het hele token wordt nooit bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone이 알림을 받으려고 서버에 마지막으로 등록한 시각이에요. 토큰의 앞뒤 일부만으로 서버 로그에서 해당 항목을 찾을 수 있으며, 전체 토큰은 저장하지 않아요."
          }
        }
      }
    },
