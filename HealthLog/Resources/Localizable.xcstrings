        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복용 기간을 삭제할까요? 기록한 복용은 기록에 남아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este tratamiento? Las dosis registradas se mantienen en el historial."
          }
        }
      }
    },
    "med.courses.error.overlap": {
