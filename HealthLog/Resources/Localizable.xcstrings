    "coach.error.providerTimeout": {
      "comment": "Coach error coach.provider.timeout",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein KI-Anbieter hat zu lange für die Antwort gebraucht. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI provider took too long to answer. Try again shortly."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je AI-aanbieder deed er te lang over om te antwoorden. Probeer het zo opnieuw."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 제공업체의 응답이 너무 오래 걸렸어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor de IA tardó demasiado en responder. Inténtalo de nuevo en breve."
          }
        }
      }
    },
    "coach.error.providerUnreachable": {
      "comment": "Coach error coach.provider.unreachable",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein KI-Anbieter ist gerade nicht erreichbar. Prüfe ihn unter Einstellungen > Assistent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI provider can't be reached right now. Check it in Settings > Assistant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je AI-aanbieder is nu niet bereikbaar. Controleer hem via Instellingen > Assistent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 AI 제공업체에 연결할 수 없어요. 설정 > 어시스턴트에서 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede contactar con tu proveedor de IA en este momento. Revísalo en Ajustes > Asistente."
          }
        }
      }
    },
