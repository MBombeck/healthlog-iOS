          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per kind"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per soort"
          }
        }
      }
    },
    "settings.hkdiag.limits_bgrefresh": {
      "comment": "#66 P0.1 — Background App Refresh switch bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist „Hintergrundaktualisierung“ ausgeschaltet, entfallen die kurzen Auffrisch-Läufe komplett."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Background App Refresh” is off, the quick refresh runs are skipped entirely."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als 'Ververs op achtergrond' uit staat, worden de korte verversingen helemaal overgeslagen."
          }
        }
      }
    },
    "settings.hkdiag.limits_discretion": {
      "comment": "#66 P0.1 — system discretion bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet selbst, wann es weckt, meist beim Laden oder nachts. Neue Daten können daher erst mit Verzögerung am Server ankommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides when to wake the app, usually while charging or overnight. New data can therefore reach the server only after a delay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bepaalt zelf wanneer de app wordt gewekt, meestal tijdens het opladen of 's nachts. Nieuwe gegevens kunnen daardoor pas met vertraging op de server aankomen."
          }
        }
      }
    },
    "settings.hkdiag.limits_footer": {
      "comment": "#66 P0.1 — system-limits card footer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht „Letzter Hintergrund-Sync“ auf „Noch nichts“, obwohl die App lief, hält iOS die Hintergrund-Zeit zurück. Das ist kein App-Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If “Last background sync” still says “Nothing yet” although the app has run, iOS is withholding background time. That is not an app bug."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat “Laatste synchronisatie op de achtergrond” nog op “Nog niets”, terwijl de app wel heeft gedraaid, dan houdt iOS de tijd op de achtergrond tegen. Dat is geen fout in de app."
          }
        }
      }
    },
    "settings.hkdiag.limits_forcequit": {
      "comment": "#66 P0.1 — force-quit limit bullet.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischst du die App im App-Umschalter weg, startet iOS sie im Hintergrund nicht mehr, bis du sie wieder öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you swipe the app away in the App Switcher, iOS stops starting it in the background until you open it again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg je de app weg in de appkiezer, dan start iOS hem niet meer op de achtergrond tot je hem weer opent."
          }
        }
      }
    },
