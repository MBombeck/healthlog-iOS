    "mentalHealth.crisis.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Gedanken angegeben, lieber tot zu sein oder dir etwas anzutun. Es gibt jetzt sofort Unterstützung — sich zu melden ist ein Zeichen von Stärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You indicated thoughts of being better off dead or of hurting yourself. Support is available right now, and reaching out is a sign of strength."
          }
        }
      }
    },
