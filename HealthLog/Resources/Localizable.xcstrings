            "state": "translated",
            "value": "El asistente puede leer tu historial de salud. No puede cambiar nada."
          }
        }
      }
    },
    "The assistant stops answering until you enter a key again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent antwortet erst wieder, wenn du einen Schlüssel einträgst."
