      }
    },
    "report.selection.notice.rebuilt": {
      "comment": "CU-11 — report-selection panel (POST /api/export/health-record, selection v2).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl enthielt Einträge, die dieser Server nicht kennt. Sie wurde aus der aktuellen Serverliste neu aufgebaut — bitte prüfen und erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection contained entries this server does not know. It was rebuilt from the current server list — please check it and try again."
          }
        }
      }
    },
