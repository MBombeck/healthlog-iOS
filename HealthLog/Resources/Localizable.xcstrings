    "On device — no cloud, no recording of the conversation beyond the current session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät: keine Cloud, keine Aufzeichnung der Unterhaltung über die laufende Sitzung hinaus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On device: no cloud, no recording of the conversation beyond the current session."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op het apparaat: geen cloud, het gesprek wordt niet bewaard na de huidige sessie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 실행: 클라우드를 쓰지 않고, 현재 세션이 끝나면 대화를 기록하지 않아요."
          }
        }
      }
    },
    "On worse %@ days your %@ averaged %@; on better days %@. Based on %lld days each side. %@ confidence.": {
      "comment": "VoiceOver value for one factor-crosstab row",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit schlechterer Bewertung für %1$@ lag der Wert für %2$@ im Schnitt bei %3$@, an besseren Tagen bei %4$@. Basierend auf je %5$lld Tagen. Konfidenz: %6$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On worse %1$@ days your %2$@ averaged %3$@; on better days %4$@. Based on %5$lld days each side. %6$@ confidence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dagen met een slechtere score voor %1$@ lag %2$@ gemiddeld op %3$@, op betere dagen op %4$@. Gebaseerd op telkens %5$lld dagen. Betrouwbaarheid: %6$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 나쁜 날에는 %2$@ 평균이 %3$@, 좋은 날에는 %4$@였어요. 각각 %5$lld일 기준. 신뢰도 %6$@."
          }
        }
      }
    },
    "On your worse %@ days, your %@ tended to run higher.": {
      "comment": "Factor-crosstab association sentence: metric higher on worse factor days",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Tagen mit schlechterer Bewertung für %1$@ lag der Wert für %2$@ meist höher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your worse %1$@ days, your %2$@ tended to run higher."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
