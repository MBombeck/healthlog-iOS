      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag die Mengen so ein, wie sie auf dem Etikett stehen. Jede genommene Dosis zählt danach in die Mikronährstoffe des Tages."
