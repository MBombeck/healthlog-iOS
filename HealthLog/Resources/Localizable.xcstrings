    "settings.applehealth.routes.subtitle": {
      "comment": "1.5 ROUTES: why the route switch exists. Routes are GPS location data; they reach only the person's own account.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routen sind Ortsdaten. Sie gehen nur an dein HealthLog-Konto und erst, wenn du sie hier einschaltest."
          }
        },
