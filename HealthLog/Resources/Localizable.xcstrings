    "mentalHealth.instrumentDescription.gad7": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe dich auf die letzten zwei Wochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer for the last two weeks."
          }
        },
