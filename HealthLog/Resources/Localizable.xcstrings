    "invite.signedIn.notice.body": {
      "comment": "W-INVITE-DEEPLINK (#16) — body of the alert shown when an invite link is opened while already signed in. Explains plainly why the invite can't be applied and what to do.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Einladungslink erstellt ein neues HealthLog-Konto. Du bist bereits angemeldet, daher lässt er sich auf dieses Konto nicht anwenden. Melde dich ab und nutze den Link erneut, wenn du ein neues Konto anlegen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An invite link creates a new HealthLog account. You're already signed in, so it can't be applied to this account. Sign out and open the link again if you want to create a new account."
          }
        },
