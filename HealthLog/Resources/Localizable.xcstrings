          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네, 생리가 시작됐어요"
          }
        }
      }
    },
    "cycle.capture.reconcile.decline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nein, nur Blutung erfassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, just log the bleeding"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nee, alleen het bloedverlies vastleggen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요, 출혈만 기록할게요"
          }
        }
      }
    },
    "cycle.capture.reconcile.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erfasst Blutung an einem Tag, an dem kein Zyklus läuft. Ohne Periodenbeginn wird der Eintrag dem vorherigen Zyklus zugeordnet und die Vorhersage bleibt am alten Start hängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are logging bleeding on a day no cycle covers. Without a period start the entry is filed against the previous cycle and the forecast stays anchored to the old start."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je legt bloedverlies vast op een dag die bij geen enkele cyclus hoort. Zonder begin van een menstruatie wordt de registratie bij de vorige cyclus gezet en blijft de voorspelling uitgaan van het oude begin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 주기에도 속하지 않는 날에 출혈을 기록하고 있어요. 생리 시작일이 없으면 이 기록은 이전 주기에 포함되고, 예측도 이전 시작일을 기준으로 유지돼요."
          }
        }
      }
    },
    "cycle.capture.reconcile.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat deine Periode begonnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has your period started?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is je menstruatie begonnen?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생리가 시작됐나요?"
          }
        }
      }
    },
