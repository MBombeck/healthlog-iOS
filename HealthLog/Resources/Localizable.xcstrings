    "labs.scan.error.camera": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan wurde abgebrochen oder ist fehlgeschlagen. Versuche es erneut oder wähle ein Foto aus deiner Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan was cancelled or failed. Try again or choose a photo from your library."
