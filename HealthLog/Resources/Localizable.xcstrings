    "settings.hkdiag.held_subtitle": {
      "comment": "W1 (1.3.0) Sync Diagnostics card subtitle for held outbox rows.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgehaltene Einträge sendet die App nicht von selbst. Sie zählen nicht zu den Einträgen, die auf eine Verbindung warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app doesn't send held-back entries on its own. They don't count as entries waiting for a connection."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegengehouden registraties verstuurt de app niet uit zichzelf. Ze tellen niet mee bij de registraties die op een verbinding wachten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 보류된 항목을 자동으로 보내지 않아요. 이 항목은 연결을 기다리는 항목에 포함되지 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no envía por sí sola los registros retenidos. No cuentan como registros a la espera de conexión."
          }
        }
      }
    },
