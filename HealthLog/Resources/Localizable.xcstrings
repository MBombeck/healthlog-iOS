    "settings.applehealth.writeback.blocked": {
      "comment": "P2 (R2-status) — Apple Health detail: write-back-off notice shown when receiving works (isConnected) but every WRITE type is denied. Kept separate from the receive/connection pill.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückschreiben deaktiviert: HealthLog darf keine Messungen nach Apple Health zurückschreiben. Der Empfang läuft normal weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write-back off: HealthLog can't write measurements back to Apple Health. Receiving still works normally."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugschrijven uit: HealthLog kan geen metingen terugschrijven naar Apple Health. Ontvangen werkt gewoon."
          }
        }
      }
    },
    "settings.applehealth.writeback.limited": {
      "comment": "P2 (R2-status) — Apple Health detail: write-back-limited notice shown when receiving works (isConnected) but not every WRITE type is authorized. Kept separate from the receive/connection pill.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückschreiben eingeschränkt: Nicht alle Datentypen dürfen nach Apple Health geschrieben werden. Der Empfang läuft normal weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write-back limited: not every data type can be written to Apple Health. Receiving still works normally."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terugschrijven beperkt: niet elk gegevenstype kan naar Apple Health worden geschreven. Ontvangen werkt gewoon."
          }
        }
      }
    },
