"NSHealthShareUsageDescription" = "HealthLog reads the health data you allow from Apple Health – including vital signs, activity, nutrition, sleep, mood, cycle data, ECGs, workout and heart-rate data, and medications – to display and sync it and calculate trends.";
"NSHealthUpdateUsageDescription" = "HealthLog saves measurements, mood and cycle entries you create, and measurements from devices or imports you connect to Apple Health when you allow HealthLog to write.";
"NSFaceIDUsageDescription" = "HealthLog uses Face ID to protect your data.";
"NSUserNotificationsUsageDescription" = "HealthLog reminds you about medications and measurements.";
"NSAlarmKitUsageDescription" = "HealthLog provides loud alarms for time-critical medications that you explicitly enable. They can break through Silent mode and Focus so you do not miss an important dose.";
"NSSpeechRecognitionUsageDescription" = "HealthLog uses speech recognition to turn your dictated Coach question into text, on device where available. You review the text before sending it.";
"NSMicrophoneUsageDescription" = "HealthLog uses the microphone so you can dictate a Coach question. The recording is converted to text on device and is not stored.";
"NSCameraUsageDescription" = "HealthLog uses the camera to read medication packages and lab reports on device, or to upload scans you select to your document vault on your configured HealthLog server.";
"NSPhotoLibraryUsageDescription" = "HealthLog reads only photos you select, to set your profile picture, process them on device, or upload them to your document vault on your configured HealthLog server.";
"NSBluetoothAlwaysUsageDescription" = "HealthLog connects to blood-pressure monitors, glucose sensors, and scales over Bluetooth so measurements can arrive automatically.";
