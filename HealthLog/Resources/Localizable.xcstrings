    "anamnesis.state.neverRecorded.hint": {
      "comment": "CU-32 — anamnesis facts (effective-dated smoking / alcohol / shift-work entries). Spells out the absence-vs-NONE distinction so an empty entry can never read as 'none'.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Frage, die du noch nicht beantwortet hast, ist etwas anderes als die ausdrückliche Antwort „keine“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A question you haven't answered yet is not the same as an explicit answer of “none”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vraag die je nog niet hebt beantwoord, is iets anders dan het uitdrukkelijke antwoord “geen”."
