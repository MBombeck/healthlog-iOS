    "med.inventory.expiry.rule.firstUseClock": {
      "comment": "CU-23 / B2 (server v1.33.0) - expiry rule caption for PEN and AMPOULE: the printed date and the 30-day-after-opening clock both apply.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pen und Ampulle verfallen am aufgedruckten Datum oder 30 Tage nach dem Anbruch, je nachdem, was zuerst eintritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pens and ampoules expire on the printed date or 30 days after opening, whichever comes first."
