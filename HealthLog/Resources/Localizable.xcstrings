            "value": "Andere sessies zijn beëindigd en elke andere login in de app is ingetrokken. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.else.footer": {
      "comment": "Sessions screen — footer under the sign-out-everywhere button on servers from v1.38.11, where this device is spared.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet alle Browser-Sitzungen ab und widerruft die Anmeldung aller anderen Apps. Dieses Gerät bleibt angemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out every browser session and revokes every other app sign-in. This device stays signed in."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logt alle browsersessies uit en trekt de inlog van alle andere apps in. Dit apparaat blijft ingelogd."
          }
        }
      }
    },
    "sessions.signOutAll.footer": {
