          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report holds %1$lld readings. The first %2$lld were taken over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport bevat %1$lld waarden. De eerste %2$lld zijn overgenomen."
          }
