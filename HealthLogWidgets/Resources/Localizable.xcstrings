{
  "sourceLanguage": "en",
  "strings": {
    "control.capture.description": {
      "comment": "Erfassen control — gallery description shown when adding the control",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet HealthLog direkt zum Erfassen eines Eintrags."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens HealthLog straight to logging an entry."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent HealthLog direct om een registratie vast te leggen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog를 열어 바로 기록을 입력해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre HealthLog directamente para registrar algo."
          }
        }
      }
    },
