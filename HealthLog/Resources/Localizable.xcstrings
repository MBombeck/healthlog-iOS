    "nutrients.list.empty.subtitle": {
      "comment": "Build 7.6",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Apple Health Vitamin-, Mineralstoff- oder Wasserdaten liefert, erscheinen hier die Tageswerte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once Apple Health has vitamin, mineral or water data, your daily totals appear here."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra Apple Health gegevens over vitaminen, mineralen of water heeft, verschijnen je dagtotalen hier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에 비타민, 미네랄 또는 수분 데이터가 생기면 하루 합계가 여기에 표시돼요."
