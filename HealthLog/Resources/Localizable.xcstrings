    "notifications.test.footer": {
      "comment": "1.4 B2 — footer of the test-notification card, one sentence.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Berechtigung und Banner auf diesem Gerät, ohne Daten zu senden; bei aktivem Fokus kann iOS den Banner verzögern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks permission and banners on this device without sending any data; with Focus on, iOS may delay the banner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert toestemming en meldingen op dit apparaat zonder gegevens te versturen; met focus aan kan iOS de melding vertragen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 보내지 않고 이 기기의 알림 권한과 배너를 확인해요. 집중 모드가 켜져 있으면 iOS가 배너를 늦게 표시할 수 있어요."
          }
        }
      }
    },
