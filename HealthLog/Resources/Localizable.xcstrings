          }
        }
      }
    },
    "sources.caveat.efsa-drv": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzwerte für gesunde europäische Erwachsene; der Bedarf weicht in Schwangerschaft, Krankheit und unter Medikation ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference values for healthy European adults; needs differ in pregnancy, illness and with medication."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Referentiewaarden voor gezonde Europese volwassenen; de behoefte verschilt bij zwangerschap, ziekte en medicijngebruik."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강한 유럽 성인의 참고값이에요. 임신, 질병, 약 복용 시에는 필요량이 달라요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valores de referencia para adultos europeos sanos; las necesidades difieren en el embarazo, en la enfermedad y con medicación."
          }
        }
      }
    },
    "sources.caveat.who-2020-ferritin": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin-Grenzen verschieben sich bei Entzündung; zusammen mit CRP und Transferrinsättigung deuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferritin thresholds shift with inflammation; interpret with CRP and transferrin saturation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzen voor ferritine verschuiven bij ontsteking; beoordeel ze samen met CRP en transferrineverzadiging."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페리틴 기준은 염증에 따라 달라져요. CRP, 트랜스페린 포화도와 함께 해석하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los umbrales de ferritina cambian con la inflamación; interprétalos junto con la PCR y la saturación de transferrina."
          }
        }
      }
    },
    "sources.caveat.holick-2011-vitamin-d": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Definiert ausreichende Versorgung ab ≥ 30 ng/mL; andere Gremien setzen 20 ng/mL. Die Bereiche unterscheiden sich tatsächlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defines sufficiency at ≥ 30 ng/mL; other bodies set 20 ng/mL. The ranges genuinely differ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definieert een toereikende waarde vanaf ≥ 30 ng/mL; andere instanties hanteren 20 ng/mL. De bereiken verschillen echt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충분 기준을 ≥ 30 ng/mL로 정해요. 다른 기관은 20 ng/mL로 정해요. 범위가 실제로 서로 달라요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Define la suficiencia en ≥ 30 ng/mL; otros organismos fijan 20 ng/mL. Los rangos difieren de verdad."
          }
        }
      }
    },
    "sources.caveat.jonklaas-2014-ata-thyroid": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH-Referenzintervalle sind labor- und altersabhängig; 0,4 bis 4 mIU/L ist ein gängiges Erwachsenenfenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH reference intervals are lab- and age-dependent; 0.4 to 4 mIU/L is a common adult window."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH-referentie-intervallen hangen af van lab en leeftijd; 0,4 tot 4 mIU/L is een gangbaar venster voor volwassenen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TSH 참고 구간은 검사 기관과 나이에 따라 달라요. 0.4~4 mIU/L가 흔한 성인 범위예요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los intervalos de referencia de la TSH dependen del laboratorio y de la edad; de 0,4 a 4 mUI/L es un intervalo habitual en adultos."
          }
        }
      }
    },
    "sources.caveat.pearson-2003-crp": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1 niedrig, 1 bis 3 durchschnittlich, > 3 mg/L höheres Herz-Kreislauf-Risiko (nur außerhalb akuter Infekte)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1 low, 1 to 3 average, > 3 mg/L higher cardiovascular risk (only outside acute infection)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1 laag, 1 tot 3 gemiddeld, > 3 mg/L hoger risico op hart- en vaatziekten (alleen buiten een acute infectie)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hs-CRP < 1은 낮음, 1~3은 보통, > 3 mg/L는 심혈관 위험 높음이에요(급성 감염이 아닐 때만)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "PCR-us < 1 bajo, de 1 a 3 medio, > 3 mg/L riesgo cardiovascular más alto (solo fuera de una infección aguda)."
          }
        }
      }
    },
    "sources.caveat.who-2024-haemoglobin": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anämie-Grenzen nach Geschlecht, Alter und Schwangerschaft; Anpassungen für Höhe und Rauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anaemia cut-offs by sex, age and pregnancy; altitude and smoking adjustments apply."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzen voor bloedarmoede naar geslacht, leeftijd en zwangerschap; er gelden correcties voor hoogte en roken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈혈 기준은 성별, 나이, 임신 여부에 따라 달라요. 고도와 흡연에 따른 보정이 적용돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puntos de corte de anemia según sexo, edad y embarazo; se aplican ajustes por altitud y tabaquismo."
          }
        }
      }
    },
    "sources.caveat.frid-2016-injection-technique": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin-bezogene Empfehlungen; die Stellenrotation gilt für alle subkutanen Injektionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insulin-focused recommendations; site rotation applies to all subcutaneous injections."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbevelingen gericht op insuline; het afwisselen van injectieplaatsen geldt voor alle onderhuidse injecties."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인슐린 중심의 권고예요. 부위 순환은 모든 피하 주사에 해당해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recomendaciones centradas en la insulina; la rotación del lugar se aplica a todas las inyecciones subcutáneas."
          }
        }
      }
    },
    "sources.caveat.nes-2011-fitness-age": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂peak-Modell ohne Belastungstest aus einer norwegischen Kohorte; eine Wearable-VO₂max-Schätzung addiert eigenen Fehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-exercise VO₂peak model from a Norwegian cohort; a wearable VO₂max estimate adds its own error."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VO₂peak-model zonder inspanningstest uit een Noors cohort; een VO₂ max-schatting van een wearable voegt een eigen foutmarge toe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노르웨이 코호트의 비운동 VO₂peak 모델이에요. 웨어러블 VO₂max 추정치에는 자체 오차가 더해져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Modelo de VO₂ pico sin ejercicio de una cohorte noruega; la estimación de VO₂ máx. de un wearable añade su propio error."
          }
        }
      }
    },
    "sources.caveat.who-2011-waist": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taillengrenzen unterscheiden sich nach Geschlecht und Bevölkerung; das Maßband braucht eine konstante Position."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waist cut-offs differ by sex and population; a tape measure needs consistent placement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzen voor de tailleomvang verschillen per geslacht en bevolkingsgroep; een meetlint vraagt om een steeds gelijke plaatsing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리둘레 기준은 성별과 인구 집단에 따라 달라요. 줄자는 항상 같은 위치에 대야 해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los puntos de corte de cintura difieren según el sexo y la población; la cinta métrica necesita una colocación constante."
          }
        }
      }
    },
    "sources.caveat.leong-2015-grip": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Griffkraft sagt auf Bevölkerungsebene Verläufe voraus; Gerät und Haltung verändern die Zahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip strength predicts outcomes at population level; device and posture change the number."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knijpkracht voorspelt uitkomsten op bevolkingsniveau; apparaat en houding veranderen het getal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "악력은 인구 집단 수준에서 건강 결과를 예측해요. 측정 기기와 자세에 따라 수치가 달라져요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fuerza de agarre predice resultados a nivel poblacional; el dispositivo y la postura cambian la cifra."
          }
        }
      }
    },
    "sources.caveat.ats-2002-six-minute-walk": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinikprotokoll auf ebener 30-m-Strecke; eine Telefon-Schätzung ist nicht der standardisierte Test."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clinic protocol on a flat 30 m course; a phone estimate is not the standardised test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klinisch protocol op een vlak parcours van 30 m; een schatting door de telefoon is niet de gestandaardiseerde test."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평평한 30 m 코스에서 하는 진료 프로토콜이에요. 휴대폰 추정치는 표준화된 검사가 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Protocolo clínico en un recorrido llano de 30 m; una estimación del teléfono no es la prueba estandarizada."
          }
        }
      }
    },
    "sources.caveat.who-2018-noise": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheitsleitlinie zu Umgebungslärm; die Expositionsschätzung des Telefons ist nur ein Anhaltspunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environmental-noise health guidance; a phone's exposure estimate is indicative only."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezondheidsrichtlijn voor omgevingsgeluid; de blootstellingsschatting van een telefoon is alleen een indicatie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 소음 건강 지침이에요. 휴대폰의 노출 추정치는 참고용일 뿐이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recomendaciones de salud sobre el ruido ambiental; la estimación de exposición de un teléfono es solo orientativa."
          }
        }
      }
    },
    "sources.caveat.apple-ecg": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die EKG-App ordnet nur den Rhythmus ein; sie erkennt keinen Herzinfarkt und keine Gerinnsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ECG app classifies rhythm only; it cannot detect a heart attack or clots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ECG-app classificeert alleen het ritme; hij kan geen hartaanval of stolsels detecteren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ECG 앱은 리듬만 분류해요. 심장마비나 혈전은 감지할 수 없어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La app ECG solo clasifica el ritmo; no puede detectar un infarto ni coágulos."
          }
        }
      }
    },
    "sources.caveat.apple-irregular-rhythm": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise sind gelegentliche Hintergrundprüfungen, kein Dauermonitoring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are occasional background checks, not continuous monitoring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen komen van af en toe uitgevoerde controles op de achtergrond, niet van continue monitoring."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 백그라운드에서 가끔 하는 확인이며, 지속적인 모니터링이 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las notificaciones son comprobaciones ocasionales en segundo plano, no una monitorización continua."
          }
        }
      }
    },
    "sources.caveat.apple-walking-steadiness": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus iPhone-Bewegungsdaten beim Tragen geschätzt; keine klinische Ganganalyse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated from iPhone motion data while carried; not a clinical gait analysis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat op basis van bewegingsgegevens van de iPhone terwijl je hem bij je draagt; geen klinische loopanalyse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 지니고 다닐 때의 움직임 데이터로 추정해요. 임상 보행 분석이 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se estima a partir de los datos de movimiento del iPhone mientras lo llevas encima; no es un análisis clínico de la marcha."
          }
        }
      }
    },
    "sources.caveat.apple-sleep-apnea": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt Anzeichen mittlerer bis schwerer Schlafapnoe über 30 Nächte; schließt Apnoe nicht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flags signs of moderate-to-severe sleep apnea over 30 nights; it does not rule apnea out."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaleert tekenen van matige tot ernstige slaapapneu over 30 nachten; het sluit apneu niet uit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 밤 동안 중등도에서 중증 수면 무호흡의 징후를 표시해요. 수면 무호흡이 없다고 판단해 주지는 않아요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Señala indicios de apnea del sueño de moderada a grave a lo largo de 30 noches; no descarta la apnea."
          }
        }
      }
    },
    "sources.caveat.studenski-2011-gait-speed": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepoolte Kohortenanalyse bei älteren Erwachsenen; Gehgeschwindigkeit ist ein Bevölkerungsmarker, kein individuelles Urteil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pooled cohort analysis in older adults; gait speed is a population marker, not an individual verdict."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepoolde cohortanalyse bij ouderen; loopsnelheid is een marker op bevolkingsniveau, geen persoonlijk oordeel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고령자 대상 통합 코호트 분석이에요. 보행 속도는 인구 집단 지표이며 개인에 대한 판정이 아니에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Análisis agrupado de cohortes en personas mayores; la velocidad de la marcha es un marcador poblacional, no un veredicto individual."
          }
        }
      }
    },
    "sources.caveat.abim-2026-lab-reference-ranges": {
      "comment": "1.4.1 caveat",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzblatt für Ärztinnen und Ärzte (Erwachsenen-Intervalle); das gedruckte Intervall deines Labors gilt immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference sheet for physicians (adult intervals); your laboratory's printed interval always wins."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Referentieoverzicht voor artsen (intervallen voor volwassenen); het afgedrukte interval van je eigen lab gaat altijd voor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사용 참고표(성인 구간)예요. 내 검사 기관이 인쇄한 구간이 항상 우선이에요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hoja de referencia para médicos (intervalos para adultos); el intervalo impreso por tu laboratorio siempre prevalece."
          }
        }
      }
    },
