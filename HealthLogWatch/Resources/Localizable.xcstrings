    "med.dose.state.missed_still_counts": {
      "comment": "Hint under a missed dose",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmst du sie jetzt, zählt sie noch, als verspätet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taking it now still counts, as late."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem je hem nu, dan telt hij nog, als te laat."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 복용해도 늦게 복용한 것으로 기록돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la tomas ahora, aún cuenta, como tardía."
          }
        }
      }
    },
