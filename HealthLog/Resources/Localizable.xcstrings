                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
          },
          "stringUnit": {
            "state": "translated",
            "value": "Worst %1$@ over %#@days@."
          }
        },
        "de": {
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
