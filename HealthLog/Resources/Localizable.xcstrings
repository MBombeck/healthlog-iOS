    "med.wirkung.beforeAfter.counts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf %1$lld Werten davor und %2$lld seitdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on %1$lld readings before and %2$lld since."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaseerd op %1$lld metingen ervoor en %2$lld sindsdien."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 전 측정값 %1$lld개와 시작 이후 %2$lld개를 기준으로 해요."
          }
        }
      }
    },
    "med.wirkung.beforeAfter.needAfter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch zu wenige Werte seit dem Beginn. Für eine Gegenüberstellung werden etwa %1$lld Wochen davor und danach benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough readings since the start yet. About %1$lld weeks are needed before and after to compare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet genoeg metingen sinds de start. Om te kunnen vergelijken zijn er ongeveer %1$lld weken ervoor en erna nodig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 시작 이후 측정값이 부족해요. 비교하려면 시작 전후로 약 %1$lld주가 필요해요."
          }
        }
      }
    },
    "med.wirkung.beforeAfter.needBefore": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch zu wenige Werte vor dem Beginn. Für eine Gegenüberstellung werden etwa %1$lld Wochen davor und danach benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough readings before the start yet. About %1$lld weeks are needed before and after to compare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet genoeg metingen van vóór de start. Om te kunnen vergelijken zijn er ongeveer %1$lld weken ervoor en erna nodig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 시작 전 측정값이 부족해요. 비교하려면 시작 전후로 약 %1$lld주가 필요해요."
          }
        }
      }
    },
    "med.wirkung.beforeAfter.needData": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch zu wenige Werte. Für eine Gegenüberstellung werden etwa %1$lld Wochen vor und nach dem Beginn benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough readings yet. About %1$lld weeks are needed before and after the start to compare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet genoeg metingen. Om te kunnen vergelijken zijn er ongeveer %1$lld weken voor en na de start nodig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 측정값이 부족해요. 비교하려면 시작 전후로 약 %1$lld주가 필요해요."
          }
        }
      }
    },
    "med.wirkung.beforeAfter.needStart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterlege ein Startdatum, um die Werte vor und nach dem Beginn gegenüberzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a start date to compare the readings before and after it began."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een startdatum in om de metingen van voor en na de start te vergelijken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 전후의 측정값을 비교하려면 시작일을 설정해 주세요."
          }
        }
      }
    },
    "med.wirkung.beforeAfter.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Ø %1$@ davor auf Ø %2$@ seitdem, eine Veränderung von %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From Ø %1$@ before to Ø %2$@ since, a change of %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van Ø %1$@ ervoor naar Ø %2$@ sindsdien, een verandering van %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 전 평균 %1$@, 시작 이후 평균 %2$@, 변화량 %3$@예요."
          }
        }
      }
    },
    "med.wirkung.chart.a11y": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf des Zielwerts rund um den Beginn der Einnahme."
