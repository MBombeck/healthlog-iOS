    "seizures.rule.explainer %lld %lld": {
      "comment": "Seizure diary, web label seizures.rule.explainer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Anfallsserie sind so viele Anfälle innerhalb so vieler Stunden. Verwende die Regel aus dem Notfallplan; NICE verwendet %1$lld in %2$lld Stunden, und die Übersicht zählt Anfallsserien nach beiden Regeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cluster is this many seizures within this many hours. Use the rule in the emergency plan; NICE uses %1$lld in %2$lld hours, and the summary counts clusters under both."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een cluster is dit aantal aanvallen binnen dit aantal uur. Gebruik de regel uit het noodplan; NICE gebruikt %1$lld in %2$lld uur, en het overzicht telt clusters volgens beide regels."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "군집 발작은 정해진 시간 안에 정해진 횟수 이상 일어난 발작이에요. 응급 계획에 있는 기준을 사용하세요. NICE 기준은 %2$lld시간 내 %1$lld회이며, 요약에서는 두 기준으로 모두 세어요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un racimo es este número de crisis en este número de horas. Usa la regla del plan de emergencia; NICE usa %1$lld en %2$lld horas, y el resumen cuenta los racimos con ambas reglas."
          }
        }
      }
    },
