        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지표는 Apple Health와 동기화되지 않아요. 지표에서 상관관계 분석을 켠 경우에만 분석에 포함돼요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mediciones personalizadas no se sincronizan con Apple Health. Solo se incluyen en el análisis de correlación si lo activas para la medición."
