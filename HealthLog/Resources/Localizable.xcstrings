      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werte liest HealthLog aus Apple Health. Ob du sie erlaubt hast, verrät Apple der App nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog reads these values from Apple Health. Apple doesn't tell the app whether you allowed them."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthLog leest deze waarden uit Apple Health. Of je ze hebt toegestaan, vertelt Apple niet aan de app."
