{
  "sourceLanguage": "en",
  "strings": {
    "report.adherence.account %lld %lld %lld %@ %lld": {
      "comment": "Adherence: all medications; number of medications, taken, expected, percentage, days",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Medikamente (%1$lld): %2$lld von %3$lld eingenommen (%4$@) in %5$lld Tagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All medications (%1$lld): %2$lld of %3$lld taken (%4$@) in %5$lld days"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle medicatie (%1$lld): %2$lld van %3$lld ingenomen (%4$@) in %5$lld dagen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "전체 약(%1$lld개): %5$lld일간 %3$lld회 중 %2$lld회 복용(%4$@)"
          }
        }
      }
    },
    "report.adherence.row %@ %lld %lld %@ %lld": {
      "comment": "Adherence row: medication, doses taken, doses expected, percentage, days",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld von %3$lld eingenommen (%4$@) in %5$lld Tagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld of %3$lld taken (%4$@) in %5$lld days"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$lld van %3$lld ingenomen (%4$@) in %5$lld dagen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@: %5$lld일간 %3$lld회 중 %2$lld회 복용(%4$@)"
          }
        }
      }
    },
    "report.adherence.row.noSchedule %@": {
      "comment": "Adherence row: medication without a dosing schedule",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: kein Einnahmeplan in HealthLog, keine Einnahmetreue"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no HealthLog schedule, no adherence rate"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: geen innameschema in HealthLog, geen therapietrouw"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@: HealthLog 복용 일정 없음, 순응률 없음"
          }
        }
      }
    },
    "report.adherence.source %lld": {
      "comment": "Adherence: where the figures come from; number of days",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmetreue der letzten %lld Tage, vom HealthLog-Server nach Einnahmeplan berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adherence over the last %lld days, computed by the HealthLog server from the dosing schedule."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Therapietrouw over de afgelopen %lld dagen, door de HealthLog-server berekend op basis van het innameschema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최근 %lld일간의 복약 순응도이며, HealthLog 서버가 복용 일정을 기준으로 계산했습니다."
          }
        }
      }
    },
    "report.adherence.title": {
      "comment": "Section heading: adherence",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmetreue"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adherence"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Therapietrouw"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복약 순응도"
          }
        }
      }
    },
    "report.adherence.unavailable": {
      "comment": "Adherence: the server could not be reached",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmetreue nicht verfügbar: Der HealthLog-Server war beim Erstellen nicht erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adherence not available: the HealthLog server could not be reached when this report was made."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Therapietrouw niet beschikbaar: de HealthLog-server was bij het aanmaken van dit rapport niet bereikbaar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복약 순응도 제공 불가: 이 리포트를 작성할 때 HealthLog 서버에 연결할 수 없었습니다."
          }
        }
      }
    },
    "report.adherence.windowMismatch %lld %lld": {
      "comment": "Adherence: report period in days, then the window shown in days",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Berichtszeitraum von %1$lld Tagen liefert der Server keine Einnahmetreue; gezeigt sind die letzten %2$lld Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server provides no adherence for the %1$lld-day report period; the last %2$lld days are shown."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de rapportageperiode van %1$lld dagen levert de server geen therapietrouw; getoond worden de afgelopen %2$lld dagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "서버가 %1$lld일 리포트 기간의 복약 순응도를 제공하지 않아 최근 %2$lld일을 표시합니다."
          }
        }
      }
    },
