    "invite.signedIn.notice.body": {
      "comment": "W-INVITE-DEEPLINK (#16) — body of the alert shown when an invite link is opened while already signed in. Explains plainly why the invite can't be applied and what to do.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Einladungslink erstellt ein neues HealthLog-Konto. Du bist bereits angemeldet, daher lässt er sich auf dieses Konto nicht anwenden. Melde dich ab und nutze den Link erneut, wenn du ein neues Konto anlegen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An invite link creates a new HealthLog account. You're already signed in, so it can't be applied to this account. Sign out and open the link again if you want to create a new account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een uitnodigingslink maak je een nieuw HealthLog-account aan. Je bent al ingelogd, dus de link kan niet op dit account worden toegepast. Log uit en open de link opnieuw als je een nieuw account wilt aanmaken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크는 새 HealthLog 계정을 만들어요. 이미 로그인되어 있어서 이 계정에는 적용할 수 없어요. 새 계정을 만들려면 로그아웃한 뒤 링크를 다시 여세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace de invitación crea una nueva cuenta de HealthLog. Ya has iniciado sesión, así que no se puede aplicar a esta cuenta. Cierra sesión y vuelve a abrir el enlace si quieres crear una cuenta nueva."
          }
        }
      }
    },
