    "med.criticalAlarm.failed.body": {
      "comment": "audit-release 05 C-1 — body of the critical-alarm failure warning. %@ is the list of affected medication names.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ konnte der kritische Alarm nicht aktiviert werden. Diese Erinnerung ist nicht garantiert. Bitte versuche es erneut oder prüfe die Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The critical alarm for %@ couldn’t be set. This reminder isn’t guaranteed. Try again or check Settings."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kritieke alarm voor %@ kon niet worden ingesteld. Deze herinnering is niet gegarandeerd. Probeer het opnieuw of controleer Instellingen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 중요 알람을 설정하지 못했어요. 이 알림은 울린다는 보장이 없어요. 다시 시도하거나 설정을 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo configurar la alarma crítica para %@. Este recordatorio no está garantizado. Inténtalo de nuevo o revisa Ajustes."
          }
        }
      }
    },
    "med.criticalAlarm.failed.retry.hint": {
      "comment": "audit-release 05 C-1 — accessibility hint for the retry button on the critical-alarm failure warning.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versucht erneut, den kritischen Alarm zu stellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries to set the critical alarm again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeert het kritieke alarm opnieuw in te stellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요 알람을 다시 설정해요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta configurar de nuevo la alarma crítica."
          }
        }
      }
    },
